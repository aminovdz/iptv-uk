---
// src/pages/free-iptv-trial-uk.astro
// Zero-friction 24H test stream landing page targeting "free iptv trial uk"
import Layout from '../layouts/Layout.astro';
import StickyHeader from '../components/StickyHeader.astro';
import LiveScores from '../components/LiveScores.astro';
import Pricing from '../components/Pricing.astro';
import SupportedDevices from '../components/SupportedDevices.astro';
import UserReviewsSection from '../components/UserReviewsSection.astro';
import FAQSection from '../components/FAQSection.astro';
import ContactForm from '../components/ContactForm.astro';
import Footer from '../components/Footer.astro';
import { currentYear } from '../utils/year';

const title = `Free IPTV Trial UK (${currentYear} Instant 24H Test) | 4K Sports & Zero Buffering`;
const description = `Test British IPTV free for 24 hours in ${currentYear}. Full access to 4K live sports, Saturday 3PM matches, UK channels & VOD. Instant activation via WhatsApp with zero obligation.`;
const keywords = "free iptv trial uk, 24h iptv trial, free iptv test uk, try iptv free, instant iptv trial firestick";

const trialFaqs = [
  {
    question: "How do I activate the 24-Hour Free IPTV Trial?",
    answer: "Simply message our WhatsApp support team. Send 'Hello! I want a free 24-hour trial' along with your streaming device name (e.g. Firestick, Smart TV). Our team generates your trial M3U playlist or Xtream Codes login within 60 seconds."
  },
  {
    question: "Do I need to enter credit card details for the trial?",
    answer: "No! Our 24-hour trial is 100% free with zero payment details required. Test our 4K picture quality and channel stability completely risk-free."
  },
  {
    question: "Is live sports included in the 24-hour trial?",
    answer: "Yes, you get complete, unrestricted access to all live sports feeds, 60fps frame rates, and electronic TV guide (EPG) data during your trial window."
  }
];
---

<Layout 
  title={title} 
  description={description} 
  keywords={keywords}
  type="product"
  faqs={trialFaqs}
>
  <StickyHeader />

  <main class="flex-grow">
    <!-- Trial Hero Section -->
    <section class="relative pt-32 pb-20 bg-gradient-to-b from-[#0B0F19] via-[#050814] to-[#050814] text-white overflow-hidden border-b border-blue-900/40">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10 text-center">
        <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-emerald-500/10 border border-emerald-500/30 text-emerald-400 text-xs font-black uppercase tracking-widest mb-6">
          <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
          100% Free 24-Hour Test Stream • No Credit Card Required
        </div>

        <h1 class="text-4xl sm:text-6xl lg:text-7xl font-black tracking-tight max-w-5xl mx-auto leading-tight">
          Try the <span class="text-transparent bg-clip-text bg-gradient-to-r from-emerald-400 via-teal-300 to-blue-400">#1 Best IPTV in the UK</span> <br class="hidden sm:inline" />
          Free for 24 Hours.
        </h1>

        <p class="mt-6 text-lg sm:text-xl text-gray-300 max-w-3xl mx-auto leading-relaxed">
          See the Anti-Freeze™ 9.0 difference before spending a single penny. Test raw 4K UHD picture quality, live sports, and zero buffering on your own television today.
        </p>

        <!-- Direct Instant Trial WhatsApp Button -->
        <div class="mt-8 flex flex-col sm:flex-row items-center justify-center gap-4">
          <a 
            href="https://wa.me/213550592200?text=Hello%20British%20IPTV!%20I%20want%20to%20activate%20my%20free%2024-hour%20test%20stream%20now." 
            target="_blank" 
            rel="noopener noreferrer"
            class="px-8 py-4 rounded-xl bg-[#25D366] text-black font-black text-base hover:bg-[#1fb355] transition-all shadow-xl hover:shadow-emerald-500/30 flex items-center justify-center gap-2.5"
          >
            <svg class="w-6 h-6" fill="currentColor" viewBox="0 0 24 24">
              <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L0 24l6.335-1.662c1.72.94 3.659 1.437 5.63 1.438h.004c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
            </svg>
            <span>Activate 24H Free Trial on WhatsApp (&lt;60s)</span>
          </a>
          <a 
            href="#pricing" 
            class="px-7 py-4 rounded-xl bg-white/10 hover:bg-white/15 text-white font-bold text-base transition-all border border-white/10"
          >
            View Paid Plans (From £7)
          </a>
        </div>
      </div>
    </section>

    <LiveScores />
    <Pricing />
    <SupportedDevices />
    <UserReviewsSection />
    <FAQSection />
    <ContactForm />
  </main>

  <Footer />
</Layout>
