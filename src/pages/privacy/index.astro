---
// src/pages/privacy/index.astro
import Layout from '../../layouts/Layout.astro';
import StickyHeader from '../../components/StickyHeader.astro';
import Footer from '../../components/Footer.astro';

const title = "Privacy Policy | British IPTV - Data Protection & GDPR Compliance";
const description = "Learn how British IPTV protects your personal data, ensures strict privacy, and complies with UK GDPR regulations. Zero logs, secure payment encryption.";
---

<Layout title={title} description={description} type="article">
  <StickyHeader />

  <main class="flex-grow pt-28 pb-20 bg-[#050814] text-gray-200">
    <!-- Hero Header -->
    <section class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center mb-12">
      <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-blue-500/10 border border-blue-500/20 text-blue-400 text-xs font-bold uppercase tracking-wider mb-4">
        🔒 UK GDPR Compliant
      </div>
      <h1 class="text-3xl sm:text-4xl lg:text-5xl font-black text-white tracking-tight">
        Privacy &amp; Data Protection Policy
      </h1>
      <p class="mt-4 text-sm sm:text-base text-gray-400 max-w-2xl mx-auto">
        Last updated: {new Date().toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' })}. Transparency, data minimization, and privacy-first streaming.
      </p>
    </section>

    <!-- Content Box -->
    <section class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="p-8 sm:p-12 rounded-3xl bg-[#090E1D] border border-white/10 shadow-2xl space-y-8 text-sm sm:text-base text-gray-300 leading-relaxed">
        
        <div>
          <h2 class="text-xl sm:text-2xl font-bold text-white mb-3 flex items-center gap-2">
            <span class="text-blue-400">1.</span> Commitment to Your Privacy
          </h2>
          <p>
            At <strong>British IPTV</strong> ("we", "our", or "the Service"), operating from London, United Kingdom, we prioritize the protection and confidentiality of our visitors and active subscribers. We adhere strictly to the UK Data Protection Act 2018 and the UK General Data Protection Regulation (UK GDPR).
          </p>
        </div>

        <div class="pt-6 border-t border-white/5">
          <h2 class="text-xl sm:text-2xl font-bold text-white mb-3 flex items-center gap-2">
            <span class="text-blue-400">2.</span> Information We Collect
          </h2>
          <p class="mb-3">
            We practice strict data minimization and only collect what is strictly necessary to activate and service your IPTV subscription:
          </p>
          <ul class="list-disc pl-5 space-y-2 text-gray-300">
            <li><strong>Subscription Delivery Data:</strong> Your email address or WhatsApp handle, used exclusively to send M3U playlists, Xtream API credentials, and device setup instructions.</li>
            <li><strong>Payment Transaction Data:</strong> Handled entirely through encrypted third-party payment gateways. We never store, process, or view credit card or bank credentials on our infrastructure.</li>
            <li><strong>Session Technical Telemetry:</strong> Ephemeral connection timestamps to maintain active concurrent stream limits according to your purchased plan. We maintain a strict <strong>Zero-Browsing-Logs policy</strong>—we never track or inspect the channels or content you stream.</li>
          </ul>
        </div>

        <div class="pt-6 border-t border-white/5">
          <h2 class="text-xl sm:text-2xl font-bold text-white mb-3 flex items-center gap-2">
            <span class="text-blue-400">3.</span> How We Use Your Information
          </h2>
          <p class="mb-3">The limited personal data we process is utilized for:</p>
          <ul class="list-disc pl-5 space-y-2 text-gray-300">
            <li>Instant automated provisioning and renewal of your IPTV subscription credentials.</li>
            <li>Providing 24/7 technical customer support via WhatsApp and official email.</li>
            <li>Defending against distributed denial of service (DDoS) and unauthorized credential sharing.</li>
          </ul>
        </div>

        <div class="pt-6 border-t border-white/5">
          <h2 class="text-xl sm:text-2xl font-bold text-white mb-3 flex items-center gap-2">
            <span class="text-blue-400">4.</span> Third-Party Disclosure & Zero Resale
          </h2>
          <p>
            We <strong>never sell, lease, trade, or monetize</strong> your personal information to advertisers, data brokers, or marketing intermediaries. Data is disclosed only when required by mandatory law or to secure infrastructure providers operating under strict confidentiality contracts.
          </p>
        </div>

        <div class="pt-6 border-t border-white/5">
          <h2 class="text-xl sm:text-2xl font-bold text-white mb-3 flex items-center gap-2">
            <span class="text-blue-400">5.</span> Cookies and Local Storage
          </h2>
          <p>
            Our website uses minimal browser localStorage cookies solely for conversion frequency capping (ensuring you do not see promotional popups more than once in a 24-hour window) and preserving UI preferences.
          </p>
        </div>

        <div class="pt-6 border-t border-white/5">
          <h2 class="text-xl sm:text-2xl font-bold text-white mb-3 flex items-center gap-2">
            <span class="text-blue-400">6.</span> Your UK GDPR Rights
          </h2>
          <p>
            You have the right to request access to any personal data associated with your subscription, request rectification of erroneous data, or request permanent erasure ("Right to be Forgotten"). To exercise your rights, contact our Data Protection Officer at <a href="mailto:contact@britishiptv.pro" class="text-blue-400 underline">contact@britishiptv.pro</a> or <a href="mailto:support@castvera.com" class="text-blue-400 underline">support@castvera.com</a>.
          </p>
        </div>

        <div class="pt-6 border-t border-white/5 bg-white/[0.02] p-6 rounded-2xl border border-white/5">
          <h3 class="text-lg font-bold text-white mb-2">Registered Address &amp; Contact</h3>
          <p class="text-xs text-gray-400 leading-relaxed">
            <strong>British IPTV Operations Hub</strong><br />
            123 Westminster Bridge Rd, London, SE1 7HR, United Kingdom<br />
            Support: <a href="mailto:contact@britishiptv.pro" class="text-blue-400">contact@britishiptv.pro</a> | <a href="mailto:support@castvera.com" class="text-blue-400">support@castvera.com</a><br />
            WhatsApp Priority Line: <a href="https://wa.me/213550592200" class="text-emerald-400 font-bold">+213 550 592 200</a>
          </p>
        </div>

      </div>
    </section>
  </main>

  <Footer />
</Layout>
