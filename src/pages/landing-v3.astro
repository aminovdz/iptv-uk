---
// src/pages/landing-v3.astro
// High-Converting Cord-Cutting & Amazon Firestick Focus Landing Page
import Layout from '../layouts/Layout.astro';
import StickyHeader from '../components/StickyHeader.astro';
import Pricing from '../components/Pricing.astro';
import ProcessSteps from '../components/ProcessSteps.astro';
import SupportedDevices from '../components/SupportedDevices.astro';
import UserReviewsSection from '../components/UserReviewsSection.astro';
import ReferralBanner from '../components/ReferralBanner.astro';
import FAQSection from '../components/FAQSection.astro';
import ContactForm from '../components/ContactForm.astro';
import Footer from '../components/Footer.astro';
import { currentYear } from '../utils/year';

const title = `Best IPTV for Amazon Firestick UK (${currentYear}) | Cut the Cord & Save £900+/Year`;
const description = `Turn your Amazon Fire TV Stick into an Ultra HD powerhouse in ${currentYear}. Stream 4K live sports and cinema for £47/year instead of £85/month. 2-minute setup.`;
const keywords = "iptv firestick uk, best iptv for firestick, firestick 4k iptv setup, cut the cord uk, cheap iptv subscription fire tv, tivimate firestick iptv";

const firestickFaqs = [
  {
    question: "How do I install British IPTV on my Amazon Firestick?",
    answer: "It takes under 2 minutes: 1. Install the free 'Downloader' app from the Amazon Appstore. 2. Download our recommended player (e.g. TiviMate or IPTV Smarters Pro). 3. Enter the Xtream Codes credentials sent to your WhatsApp. Your entire channel list and EPG guide load automatically."
  },
  {
    question: "Do I need to jailbreak or modify my Firestick?",
    answer: "No! You do not need to jailbreak or root your Firestick. The apps are installed legitimately using standard developer options available on all Fire TV models."
  },
  {
    question: "Which Firestick models are supported?",
    answer: "Every Amazon Fire TV device is supported: Fire TV Stick Lite, Fire TV Stick HD (all gens), Fire TV Stick 4K, Fire TV Stick 4K Max, and Fire TV Cube."
  },
  {
    question: "Will British IPTV work with the Firestick remote?",
    answer: "Yes, our recommended players offer full remote control navigation, fast channel zapping, favorite groups, and electronic program guide (EPG) grids."
  }
];
---

<Layout 
  title={title} 
  description={description} 
  keywords={keywords}
  type="product"
  faqs={firestickFaqs}
>
  <StickyHeader />

  <main class="flex-grow">
    <!-- Cord-Cutter Hero Section -->
    <section class="relative pt-32 pb-20 bg-gradient-to-b from-[#0B0F19] via-[#050814] to-[#050814] text-white overflow-hidden border-b border-blue-900/40">
      <!-- Glow -->
      <div class="absolute top-1/4 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[700px] h-[400px] bg-amber-500/10 blur-[160px] pointer-events-none rounded-full"></div>

      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10 text-center">
        <!-- Badge -->
        <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-amber-500/10 border border-amber-500/30 text-amber-400 text-xs font-black uppercase tracking-widest mb-6">
          <span>🔥</span> Amazon Firestick &amp; Cord-Cutting Special
        </div>

        <h1 class="text-4xl sm:text-6xl lg:text-7xl font-black tracking-tight max-w-5xl mx-auto leading-tight">
          Stop Paying £85/Month for TV. <br class="hidden sm:inline" />
          Stream Everything on <span class="text-transparent bg-clip-text bg-gradient-to-r from-amber-400 via-rose-400 to-red-500">Firestick for £47/Year</span>.
        </h1>

        <p class="mt-6 text-lg sm:text-xl text-gray-300 max-w-3xl mx-auto leading-relaxed">
          Unlock the full power of your Amazon Fire TV Stick. True 4K Ultra HD picture quality, instant 2-minute setup, 99.9% uptime, and <strong>save £973 every single year</strong> with zero contracts.
        </p>

        <!-- CTA Buttons -->
        <div class="mt-8 flex flex-col sm:flex-row items-center justify-center gap-4">
          <a 
            href="#pricing" 
            class="w-full sm:w-auto px-8 py-4 rounded-xl bg-gradient-to-r from-red-600 to-blue-600 text-white font-black text-base hover:from-red-500 hover:to-blue-500 transition-all shadow-xl shadow-red-500/25 flex items-center justify-center gap-2"
          >
            <span>Start Saving Today (£47/Year)</span>
            <span>&rarr;</span>
          </a>
          <a 
            href="https://wa.me/213550592200?text=Hello%20British%20IPTV!%20I%20have%20an%20Amazon%20Firestick%20and%20want%20to%20set%20up%20a%20test%20stream." 
            target="_blank" 
            rel="noopener noreferrer"
            class="w-full sm:w-auto px-7 py-4 rounded-xl bg-[#25D366] text-black font-black text-base hover:bg-[#1fb355] transition-all shadow-lg flex items-center justify-center gap-2"
          >
            <span>Get Instant Firestick Setup on WhatsApp</span>
          </a>
        </div>
      </div>
    </section>

    <!-- Side-by-Side Cable Savings Calculator Table -->
    <section class="py-16 bg-[#070B17] border-b border-white/5">
      <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center mb-10">
          <h2 class="text-2xl sm:text-3xl font-black text-white tracking-tight">
            See Exactly How Much You Save
          </h2>
          <p class="mt-2 text-sm text-gray-400">
            Compare standard UK cable bundles with British IPTV.
          </p>
        </div>

        <div class="rounded-3xl bg-[#0C1222] border border-white/10 overflow-hidden shadow-2xl">
          <div class="grid grid-cols-2 divide-x divide-white/10 text-center">
            <!-- Legacy Cable Column -->
            <div class="p-6 sm:p-8 bg-white/[0.01]">
              <span class="text-xs font-bold text-gray-400 uppercase tracking-wider block mb-1">Standard UK Cable Bundle</span>
              <span class="text-3xl sm:text-4xl font-black text-red-400 block">£85 / mo</span>
              <span class="text-xs text-gray-500 block mt-1">£1,020 per year</span>
              <ul class="mt-6 space-y-2.5 text-xs sm:text-sm text-gray-400 text-left">
                <li class="flex items-center gap-2">❌ 18 or 24-month lock-in contract</li>
                <li class="flex items-center gap-2">❌ Extra £35/mo for sports add-ons</li>
                <li class="flex items-center gap-2">❌ Hardware &amp; box rental fees</li>
                <li class="flex items-center gap-2">❌ Mid-contract price hikes (+8.8%)</li>
                <li class="flex items-center gap-2">❌ Saturday 3PM match blackouts</li>
              </ul>
            </div>

            <!-- British IPTV Column -->
            <div class="p-6 sm:p-8 bg-gradient-to-b from-blue-950/30 to-emerald-950/20 relative">
              <div class="absolute top-3 right-3 px-2.5 py-0.5 rounded-full bg-emerald-500/20 text-emerald-400 text-[10px] font-black uppercase">
                Best Choice
              </div>
              <span class="text-xs font-bold text-emerald-400 uppercase tracking-wider block mb-1">British IPTV 12-Month Plan</span>
              <span class="text-3xl sm:text-4xl font-black text-white block">£47 / year</span>
              <span class="text-xs text-emerald-400 font-semibold block mt-1">Just £3.91 per month</span>
              <ul class="mt-6 space-y-2.5 text-xs sm:text-sm text-gray-200 text-left font-medium">
                <li class="flex items-center gap-2">✅ ZERO contracts — cancel anytime</li>
                <li class="flex items-center gap-2">✅ All live sports &amp; PPV included</li>
                <li class="flex items-center gap-2">✅ Works on your existing Firestick</li>
                <li class="flex items-center gap-2">✅ Fixed price guarantee, zero hikes</li>
                <li class="flex items-center gap-2">✅ 100% 3PM kickoff coverage</li>
              </ul>
            </div>
          </div>

          <!-- Total Savings Banner -->
          <div class="p-5 bg-gradient-to-r from-emerald-600 via-teal-600 to-blue-600 text-center text-white font-black text-base sm:text-lg">
            🎉 You Save £973 Every Single Year with British IPTV!
          </div>
        </div>
      </div>
    </section>

    <!-- 3-Step 2-Minute Remote Setup Guide -->
    <section class="py-16 bg-[#050814] border-b border-white/5">
      <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
        <h2 class="text-2xl sm:text-3xl font-black text-white tracking-tight mb-2">
          Set Up Your Firestick in 3 Simple Steps
        </h2>
        <p class="text-sm text-gray-400 mb-10">
          No technical knowledge needed. Setup takes less than 2 minutes.
        </p>

        <div class="grid grid-cols-1 sm:grid-cols-3 gap-6 text-left">
          <div class="p-6 rounded-2xl bg-[#090E1D] border border-white/10">
            <span class="text-amber-400 font-mono font-black text-xl">STEP 01</span>
            <h3 class="text-base font-bold text-white mt-2">Download Player</h3>
            <p class="text-xs text-gray-400 mt-2 leading-relaxed">
              Open your Firestick, search for 'Downloader', and install your preferred app (TiviMate or IPTV Smarters Pro).
            </p>
          </div>
          <div class="p-6 rounded-2xl bg-[#090E1D] border border-white/10">
            <span class="text-amber-400 font-mono font-black text-xl">STEP 02</span>
            <h3 class="text-base font-bold text-white mt-2">Enter Credentials</h3>
            <p class="text-xs text-gray-400 mt-2 leading-relaxed">
              Type the Xtream Codes server URL, username, and password received instantly on WhatsApp.
            </p>
          </div>
          <div class="p-6 rounded-2xl bg-[#090E1D] border border-white/10">
            <span class="text-emerald-400 font-mono font-black text-xl">STEP 03</span>
            <h3 class="text-base font-bold text-white mt-2">Enjoy 4K Streaming</h3>
            <p class="text-xs text-gray-400 mt-2 leading-relaxed">
              Your full 7-day TV guide, live sports categories, and 4K cinema catalogue appear instantly on screen.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- Pricing Table -->
    <Pricing />

    <!-- Referral Hook -->
    <ReferralBanner />

    <!-- Compatible Devices -->
    <SupportedDevices />

    <!-- Customer Reviews -->
    <UserReviewsSection />

    <!-- Firestick FAQs -->
    <FAQSection />

    <!-- Contact & Instant WhatsApp Support -->
    <ContactForm />
  </main>

  <Footer />
</Layout>
