---
// src/pages/contact.astro
import Layout from '../layouts/Layout.astro';
import StickyHeader from '../components/StickyHeader.astro';
import ContactForm from '../components/ContactForm.astro';
import Footer from '../components/Footer.astro';

const title = "Contact Us | British IPTV - 24/7 UK Customer & Technical Support";
const description = "Contact British IPTV 24/7 via WhatsApp or email. Fast technical assistance, instant activation, and Firestick setup guidance from UK streaming engineers.";
---

<Layout title={title} description={description} type="home">
  <StickyHeader />

  <main class="flex-grow pt-24 bg-[#050814]">
    <ContactForm />
  </main>

  <Footer />
</Layout>
