---
// src/pages/landing-v2.astro
// High-Converting Sports & Premier League Focus Landing Page
import Layout from '../layouts/Layout.astro';
import StickyHeader from '../components/StickyHeader.astro';
import LiveScores from '../components/LiveScores.astro';
import Pricing from '../components/Pricing.astro';
import ProcessSteps from '../components/ProcessSteps.astro';
import SupportedDevices from '../components/SupportedDevices.astro';
import UserReviewsSection from '../components/UserReviewsSection.astro';
import FAQSection from '../components/FAQSection.astro';
import ContactForm from '../components/ContactForm.astro';
import Footer from '../components/Footer.astro';
import { currentYear } from '../utils/year';

const title = `Watch Premier League Live in 4K UHD (${currentYear}) | British IPTV Sports Pass`;
const description = `Stream every Premier League, Champions League, F1, and PPV fight in true 4K Ultra HD at 60fps in ${currentYear}. Zero Saturday 3PM blackouts, anti-freeze stability from £7.`;
const keywords = "premier league iptv, watch live football 4k, champions league iptv uk, saturday 3pm blackout bypass, f1 4k stream, boxing ppv iptv";

const sportsFaqs = [
  {
    question: "Can I watch Saturday 3PM Premier League games with British IPTV?",
    answer: "Yes, 100%. Traditional UK television stations are legally prohibited from showing 3PM kickoffs due to UEFA Article 48. British IPTV connects directly to international feeds broadcasting every single match live with English commentary."
  },
  {
    question: "What is the frame rate of your sports streams?",
    answer: "All major sports broadcasts are delivered at high-bitrate 60 frames per second (fps) in Full HD and 4K UHD. This eliminates motion blur and judder during fast-moving football and motorsport action."
  },
  {
    question: "Do streams buffer or freeze during major derbies and cup finals?",
    answer: "Our Anti-Freeze™ 9.0 system uses load-balanced multi-CDN edge servers located throughout the UK and Western Europe. During high-traffic events, bandwidth automatically scales to prevent buffering."
  },
  {
    question: "Are pay-per-view (PPV) boxing and UFC fights included?",
    answer: "Yes, all major weekend fight events and title bouts are included in your subscription without extra charges."
  }
];
---

<Layout 
  title={title} 
  description={description} 
  keywords={keywords}
  type="product"
  faqs={sportsFaqs}
>
  <StickyHeader />

  <main class="flex-grow">
    <!-- Dedicated Sports Hero Section -->
    <section class="relative pt-32 pb-20 bg-gradient-to-b from-[#00102E] via-[#050814] to-[#050814] text-white overflow-hidden border-b border-blue-900/40">
      <!-- Ambient light effect -->
      <div class="absolute top-1/4 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[700px] h-[400px] bg-red-600/15 blur-[160px] pointer-events-none rounded-full"></div>

      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10 text-center">
        <!-- Live Matchday Banner -->
        <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-red-500/10 border border-red-500/30 text-red-400 text-xs font-black uppercase tracking-widest mb-6">
          <span class="w-2 h-2 rounded-full bg-red-500 animate-ping"></span>
          Matchday Live Feeds • 60FPS 4K UHD
        </div>

        <h1 class="text-4xl sm:text-6xl lg:text-7xl font-black tracking-tight max-w-5xl mx-auto leading-tight">
          Never Miss a Goal. <br class="hidden sm:inline" />
          Stream Every <span class="text-transparent bg-clip-text bg-gradient-to-r from-red-500 via-rose-300 to-blue-400">Premier League</span> Match in 4K.
        </h1>

        <p class="mt-6 text-lg sm:text-xl text-gray-300 max-w-3xl mx-auto leading-relaxed">
          Say goodbye to Saturday 3PM blackouts and £90/month stadium package bills. Get uninterrupted 4K stadium feeds, Champions League, Formula 1, and international PPV with <strong>Anti-Freeze™ 9.0 stability</strong>.
        </p>

        <!-- CTA Action Buttons -->
        <div class="mt-8 flex flex-col sm:flex-row items-center justify-center gap-4">
          <a 
            href="#pricing" 
            class="w-full sm:w-auto px-8 py-4 rounded-xl bg-gradient-to-r from-red-600 to-blue-600 text-white font-black text-base hover:from-red-500 hover:to-blue-500 transition-all shadow-xl shadow-red-500/25 flex items-center justify-center gap-2"
          >
            <span>Get Sports Pass (£47/Year)</span>
            <span>&rarr;</span>
          </a>
          <a 
            href="https://wa.me/213550592200?text=Hello%20British%20IPTV!%20I%20want%20to%20test%20your%204K%20sports%20streams%20for%20today's%20matches." 
            target="_blank" 
            rel="noopener noreferrer"
            class="w-full sm:w-auto px-7 py-4 rounded-xl bg-[#25D366] text-black font-black text-base hover:bg-[#1fb355] transition-all shadow-lg flex items-center justify-center gap-2"
          >
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
              <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L0 24l6.335-1.662c1.72.94 3.659 1.437 5.63 1.438h.004c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
            </svg>
            <span>Activate 24H Free Matchday Trial</span>
          </a>
        </div>

        <!-- 4 Badges Grid -->
        <div class="mt-12 grid grid-cols-2 sm:grid-cols-4 gap-4 max-w-4xl mx-auto text-left">
          <div class="p-4 rounded-2xl bg-white/[0.03] border border-white/5">
            <span class="text-blue-400 font-bold block text-sm">⚽ 3PM Blackouts</span>
            <span class="text-xs text-gray-400">100% Unrestricted Access</span>
          </div>
          <div class="p-4 rounded-2xl bg-white/[0.03] border border-white/5">
            <span class="text-blue-400 font-bold block text-sm">⚡ 60FPS Bitrate</span>
            <span class="text-xs text-gray-400">Zero Motion Blur</span>
          </div>
          <div class="p-4 rounded-2xl bg-white/[0.03] border border-white/5">
            <span class="text-blue-400 font-bold block text-sm">🥊 PPV Included</span>
            <span class="text-xs text-gray-400">Boxing &amp; UFC Title Fights</span>
          </div>
          <div class="p-4 rounded-2xl bg-white/[0.03] border border-white/5">
            <span class="text-emerald-400 font-bold block text-sm">🛡️ Anti-Freeze™ 9.0</span>
            <span class="text-xs text-gray-400">No Matchday Buffer Lag</span>
          </div>
        </div>
      </div>
    </section>

    <!-- Real-Time Match Center Carousel -->
    <LiveScores />

    <!-- Transparent Pricing Table (12-Month Plan FIRST £47) -->
    <Pricing />

    <!-- Quick 3-Step Setup -->
    <ProcessSteps />

    <!-- Compatible Devices -->
    <SupportedDevices />

    <!-- Real Customer Reviews -->
    <UserReviewsSection />

    <!-- Sports FAQs -->
    <FAQSection />

    <!-- Contact & Instant WhatsApp Support -->
    <ContactForm />
  </main>

  <Footer />
</Layout>
