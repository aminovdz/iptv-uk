---
// src/pages/best-iptv-providers-uk.astro
// Comparison & Evaluation Intent Landing Page for "best iptv providers uk"
import Layout from '../layouts/Layout.astro';
import StickyHeader from '../components/StickyHeader.astro';
import Pricing from '../components/Pricing.astro';
import FeatureGrid from '../components/FeatureGrid.astro';
import SupportedDevices from '../components/SupportedDevices.astro';
import UserReviewsSection from '../components/UserReviewsSection.astro';
import FAQSection from '../components/FAQSection.astro';
import ContactForm from '../components/ContactForm.astro';
import Footer from '../components/Footer.astro';
import { currentYear } from '../utils/year';

const title = `Best IPTV Providers UK (${currentYear} Ranked) | Verified Stability & 4K Uptime`;
const description = `Discover the top-rated British IPTV provider in ${currentYear}. Ranked #1 for 4K sports stability, 99.9% uptime, zero buffering, and instant WhatsApp support. From £7.`;
const keywords = `best iptv providers uk, best iptv uk, top iptv uk, reliable iptv uk, best iptv service uk ${currentYear}`;

const providerFaqs = [
  {
    question: "How do you evaluate the best IPTV provider in the UK?",
    answer: "We evaluate providers based on 5 strict technical metrics: 1. Server uptime (must exceed 99.5%), 2. Anti-Freeze technology during peak Premier League derbies, 3. True 60fps 4K video bitrates, 4. Customer support responsiveness (<60s on WhatsApp), and 5. Fair pricing with money-back guarantees."
  },
  {
    question: `Why is British IPTV ranked #1 in ${currentYear}?`,
    answer: "British IPTV ranks #1 because of our dedicated UK edge infrastructure, zero buffering guarantee, comprehensive Saturday 3PM match access, transparent £47/year pricing, and a 4.9/5 satisfaction rating across 1,485+ verified subscribers."
  }
];
---

<Layout 
  title={title} 
  description={description} 
  keywords={keywords}
  type="article"
  faqs={providerFaqs}
>
  <StickyHeader />

  <main class="flex-grow">
    <!-- Hero Section -->
    <section class="relative pt-32 pb-20 bg-gradient-to-b from-[#0B0F19] via-[#050814] to-[#050814] text-white overflow-hidden border-b border-blue-900/40">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10 text-center">
        <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-emerald-500/10 border border-emerald-500/30 text-emerald-400 text-xs font-black uppercase tracking-widest mb-6">
          <span>🏆</span> Ranked #1 UK Streaming Service
        </div>

        <h1 class="text-4xl sm:text-6xl lg:text-7xl font-black tracking-tight max-w-5xl mx-auto leading-tight">
          The <span class="text-transparent bg-clip-text bg-gradient-to-r from-red-500 via-rose-300 to-blue-400">Best IPTV Provider in the UK</span> <br class="hidden sm:inline" />
          Verified for {currentYear}.
        </h1>

        <p class="mt-6 text-lg sm:text-xl text-gray-300 max-w-3xl mx-auto leading-relaxed">
          Tired of cheap providers that freeze at 3PM on Saturdays? British IPTV is engineered with dedicated UK edge servers to deliver immaculate 4K Ultra HD streams without lag.
        </p>

        <div class="mt-8 flex flex-col sm:flex-row items-center justify-center gap-4">
          <a 
            href="#pricing" 
            class="px-8 py-4 rounded-xl bg-gradient-to-r from-red-600 to-blue-600 text-white font-black text-base hover:from-red-500 hover:to-blue-500 transition-all shadow-xl shadow-red-500/25"
          >
            Claim 12-Month Best Value (£47) &rarr;
          </a>
          <a 
            href="https://wa.me/213550592200?text=Hello%20British%20IPTV!%20I%20am%20comparing%20UK%20providers%20and%20want%20to%20test%20your%20stream." 
            target="_blank" 
            rel="noopener noreferrer"
            class="px-7 py-4 rounded-xl bg-[#25D366] text-black font-black text-base hover:bg-[#1fb355] transition-all shadow-lg"
          >
            Test 24H Free Trial on WhatsApp
          </a>
        </div>
      </div>
    </section>

    <FeatureGrid />
    <Pricing />
    <SupportedDevices />
    <UserReviewsSection />
    <FAQSection />
    <ContactForm />
  </main>

  <Footer />
</Layout>
