---
// src/pages/404.astro
import Layout from '../layouts/Layout.astro';
import StickyHeader from '../components/StickyHeader.astro';
import Footer from '../components/Footer.astro';

const title = "404 - Page Not Found | British IPTV";
const description = "The page you are looking for does not exist or has been moved. Explore British IPTV premium streaming plans and 4K live sports.";
---

<Layout title={title} description={description} type="home">
  <StickyHeader />

  <main class="flex-grow pt-28 pb-24 bg-[#050814] flex items-center justify-center relative overflow-hidden">
    <!-- Atmospheric glows -->
    <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[600px] h-[400px] bg-red-600/10 blur-[140px] pointer-events-none rounded-full"></div>

    <div class="max-w-2xl mx-auto px-4 sm:px-6 lg:px-8 text-center relative z-10">
      <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-red-500/10 border border-red-500/20 text-red-400 text-xs font-black uppercase tracking-wider mb-6">
        <span>⚠️</span> 404 Error • Feed Not Found
      </div>

      <h1 class="text-7xl sm:text-9xl font-black text-transparent bg-clip-text bg-gradient-to-r from-red-500 via-rose-400 to-blue-500 tracking-tighter">
        404
      </h1>

      <h2 class="text-2xl sm:text-3xl font-black text-white mt-4 tracking-tight">
        Lost in the Stream? This Channel Doesn't Exist
      </h2>

      <p class="mt-4 text-gray-400 text-sm sm:text-base max-w-lg mx-auto leading-relaxed">
        The link you followed may be expired or typed incorrectly. Don't worry—our 4K sports feeds, instant activation, and 99.9% uptime servers are running smoothly.
      </p>

      <div class="mt-8 flex flex-wrap items-center justify-center gap-4">
        <a 
          href="/" 
          class="px-7 py-3.5 rounded-xl bg-gradient-to-r from-red-600 to-blue-600 text-white font-black text-sm hover:from-red-500 hover:to-blue-500 transition-all shadow-xl shadow-red-500/20"
        >
          &larr; Return to Homepage
        </a>
        <a 
          href="/#pricing" 
          class="px-6 py-3.5 rounded-xl bg-white/10 hover:bg-white/15 text-white font-bold text-sm transition-all border border-white/10"
        >
          View 4K Pricing (£47/Year)
        </a>
        <a 
          href="https://wa.me/213550592200?text=Hello%20British%20IPTV!%20I%20hit%20a%20404%20page%20and%20need%20help." 
          target="_blank" 
          rel="noopener noreferrer" 
          class="px-6 py-3.5 rounded-xl bg-[#25D366] text-black font-black text-sm hover:bg-[#1fb355] transition-all shadow-lg"
        >
          Chat with Support
        </a>
      </div>
    </div>
  </main>

  <Footer />
</Layout>
