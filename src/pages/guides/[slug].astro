---
// src/pages/guides/[slug].astro
// High-authority guide layout rendering markdown content collections or legacy data guides
export const prerender = true;

import { getCollection, render } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import StickyHeader from '../../components/StickyHeader.astro';
import Pricing from '../../components/Pricing.astro';
import FAQSection from '../../components/FAQSection.astro';
import ContactForm from '../../components/ContactForm.astro';
import Footer from '../../components/Footer.astro';
import { guides as staticGuides } from '../../data/guides.js';
import { currentYear } from '../../utils/year';

export async function getStaticPaths() {
  const contentGuides = await getCollection('guides');

  const contentPaths = contentGuides.map(entry => ({
    params: { slug: entry.id.replace(/\.(md|mdx)$/, '') },
    props: { entry, isContent: true, guide: null }
  }));

  const contentSlugs = new Set(contentPaths.map(p => p.params.slug));

  const dataPaths = staticGuides
    .filter(g => !contentSlugs.has(g.slug))
    .map(guide => ({
      params: { slug: guide.slug },
      props: { entry: null, isContent: false, guide }
    }));

  return [...contentPaths, ...dataPaths];
}

const { entry, guide, isContent } = Astro.props;

let title = "";
let description = "";
let pubDate = "";
let author = "British IPTV Editorial Team";
let readingTime = "7 min read";
let quickSummary = "";
let toc: Array<{ title: string; anchor: string }> = [];
let faqs: Array<{ question: string; answer: string }> = [];
let ContentComponent: any = null;

if (isContent && entry) {
  const rendered = await render(entry);
  ContentComponent = rendered.Content;
  const yearRegex = /\b202[0-9]\b/g;
  title = entry.data.title.replace(yearRegex, String(currentYear));
  description = entry.data.description.replace(yearRegex, String(currentYear));
  pubDate = entry.data.pubDate.toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' });
  author = entry.data.author || "British IPTV Editorial Team";
  readingTime = entry.data.readingTime || "7 min read";
  quickSummary = (entry.data.quickSummary || "").replace(yearRegex, String(currentYear));
  toc = (entry.data.toc || []).map(t => ({ title: t.title.replace(yearRegex, String(currentYear)), anchor: t.anchor }));
  faqs = (entry.data.faqs || []).map(f => ({ 
    question: f.question.replace(yearRegex, String(currentYear)), 
    answer: f.answer.replace(yearRegex, String(currentYear)) 
  }));
} else if (guide) {
  const yearRegex = /\b202[0-9]\b/g;
  title = guide.title.replace(yearRegex, String(currentYear));
  description = (guide.excerpt || guide.title).replace(yearRegex, String(currentYear));
  pubDate = new Date().toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' });
}

const slug = (isContent && entry ? entry.id : guide?.slug || '').toLowerCase();
let featuredImage = "/images/hero-4k-streaming.jpg";
if (slug.includes('firestick')) {
  featuredImage = "/images/firestick-iptv-setup.jpg";
} else if (slug.includes('premier') || slug.includes('football') || slug.includes('sports')) {
  featuredImage = "/images/premier-league-4k-stream.jpg";
} else if (slug.includes('device') || slug.includes('tivimate') || slug.includes('player')) {
  featuredImage = "/images/tivimate-premium-player.jpg";
} else if (slug.includes('channel') || slug.includes('service')) {
  featuredImage = "/images/iptv-channels-vod.jpg";
}
---

<Layout 
  title={`${title} | British IPTV Knowledge Base`} 
  description={description}
  image={featuredImage}
  type="article"
  faqs={faqs}
  authorName={author}
>
  <StickyHeader />

  <main class="flex-grow pt-28 pb-20 bg-[#050814] text-gray-200">
    <article class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <!-- Article Header -->
      <header class="mb-10 text-center sm:text-left">
        <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-blue-500/10 border border-blue-500/20 text-blue-400 text-xs font-bold uppercase tracking-wider mb-4">
          <span>📚</span> Official Streaming Guide • {readingTime}
        </div>
        <h1 class="text-3xl sm:text-4xl lg:text-5xl font-black text-white tracking-tight leading-tight">
          {title}
        </h1>
        <div class="mt-4 flex flex-wrap items-center gap-4 text-xs text-gray-400">
          <span class="text-white font-medium">By {author}</span>
          <span>•</span>
          <span>Updated: {pubDate}</span>
          <span>•</span>
          <span class="text-emerald-400 font-semibold">Verified for {currentYear}</span>
        </div>
      </header>

      <!-- Featured Guide Visual Asset with Descriptive Alt Text -->
      <div class="mb-10 rounded-3xl overflow-hidden border border-white/10 shadow-2xl relative group">
        <img 
          src={featuredImage} 
          alt={`${title} - Step-by-Step UK Streaming Tutorial Guide by British IPTV`}
          width="1280"
          height="720"
          loading="eager"
          decoding="async"
          class="w-full h-auto object-cover rounded-3xl transform transition-transform duration-500 group-hover:scale-[1.01]"
        />
      </div>

      <!-- Quick Summary Featured Snippet Box (Position 0 Target) -->
      {quickSummary && (
        <div class="p-6 sm:p-8 rounded-3xl bg-gradient-to-r from-blue-950/40 via-[#0C1222] to-emerald-950/30 border border-blue-500/30 shadow-2xl mb-10">
          <div class="flex items-center gap-2 text-blue-400 text-xs font-black uppercase tracking-wider mb-2">
            <span>⚡</span> Direct Answer Summary
          </div>
          <p class="text-sm sm:text-base text-gray-200 leading-relaxed font-medium">
            {quickSummary}
          </p>
        </div>
      )}

      <!-- Table of Contents (if provided) -->
      {toc.length > 0 && (
        <div class="p-6 rounded-2xl bg-[#090E1D] border border-white/10 mb-10 text-xs sm:text-sm">
          <h2 class="font-black text-white uppercase tracking-wider mb-3 text-xs">Table of Contents</h2>
          <ul class="space-y-2">
            {toc.map((item) => (
              <li>
                <a href={item.anchor} class="text-blue-400 hover:text-blue-300 hover:underline transition-colors">
                  &rarr; {item.title}
                </a>
              </li>
            ))}
          </ul>
        </div>
      )}

      <!-- Guide Body -->
      <div class="p-8 sm:p-12 rounded-3xl bg-[#090E1D] border border-white/10 shadow-2xl space-y-8 text-sm sm:text-base text-gray-300 leading-relaxed prose prose-invert max-w-none">
        {ContentComponent ? (
          <ContentComponent />
        ) : guide ? (
          <div set:html={(guide.content || '').replace(/\b202[0-9]\b/g, String(currentYear))} />
        ) : null}
      </div>

      <!-- Mid-Article High Converting CTA Card -->
      <div class="mt-12 p-8 sm:p-10 rounded-3xl bg-gradient-to-r from-red-950/40 via-[#0C1222] to-blue-950/40 border border-white/10 text-center shadow-2xl">
        <h3 class="text-2xl sm:text-3xl font-black text-white mb-3">
          Tired of Buffering and Complicated Configurations?
        </h3>
        <p class="text-sm text-gray-300 max-w-xl mx-auto mb-6">
          Switch to <strong class="text-white">British IPTV</strong> today. 99.9% uptime, true 4K Ultra HD at 60fps, and instant setup on WhatsApp for just £47/year.
        </p>
        <div class="flex flex-wrap items-center justify-center gap-4">
          <a 
            href="/#pricing" 
            class="px-7 py-3.5 rounded-xl bg-gradient-to-r from-red-600 to-blue-600 text-white font-black text-sm hover:from-red-500 hover:to-blue-500 transition-all shadow-lg shadow-red-500/20"
          >
            View Subscription Plans (£47/Year) &rarr;
          </a>
          <a 
            href="https://wa.me/213550592200?text=Hello%20British%20IPTV!%20I%20read%20your%20guide%20and%20want%20to%20test%20your%20service." 
            target="_blank" 
            rel="noopener noreferrer"
            class="px-6 py-3.5 rounded-xl bg-[#25D366] text-black font-black text-sm hover:bg-[#1fb355] transition-all shadow-lg"
          >
            Get Free 24H Trial on WhatsApp
          </a>
        </div>
      </div>

    </article>

    <!-- Pricing Section -->
    <div class="mt-20">
      <Pricing />
    </div>

    <!-- Contact Form -->
    <ContactForm />
  </main>

  <Footer />
</Layout>
