---
// src/pages/guides/index.astro
// High-authority Knowledge Base & Streaming Guides Hub
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import StickyHeader from '../../components/StickyHeader.astro';
import Pricing from '../../components/Pricing.astro';
import ContactForm from '../../components/ContactForm.astro';
import Footer from '../../components/Footer.astro';
import { guides as staticGuides } from '../../data/guides.js';
import { currentYear } from '../../utils/year';

const title = `IPTV Guides & Tutorials (${currentYear}) | British IPTV Knowledge Base`;
const description = "Master your IPTV streaming setup. Step-by-step tutorials for Firestick, TiviMate, Smart TVs, buffering fixes, and Premier League streaming tips.";

const contentGuides = await getCollection('guides');

const yearRegex = /\b202[0-9]\b/g;

// Merge and deduplicate
const formattedContentGuides = contentGuides.map(g => ({
  slug: g.id.replace(/\.(md|mdx)$/, ''),
  title: g.data.title.replace(yearRegex, String(currentYear)),
  excerpt: g.data.description.replace(yearRegex, String(currentYear)),
  category: g.data.category,
  readingTime: g.data.readingTime,
  pubDate: g.data.pubDate.toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric' })
}));

const existingSlugs = new Set(formattedContentGuides.map(g => g.slug));
const formattedStaticGuides = staticGuides
  .filter(g => !existingSlugs.has(g.slug))
  .map(g => ({
    slug: g.slug,
    title: g.title.replace(yearRegex, String(currentYear)),
    excerpt: g.excerpt.replace(yearRegex, String(currentYear)),
    category: "Streaming Tutorial",
    readingTime: "5 min read",
    pubDate: String(currentYear)
  }));

const allGuides = [...formattedContentGuides, ...formattedStaticGuides];
---

<Layout title={title} description={description} type="article">
  <StickyHeader />

  <main class="flex-grow pt-28 pb-20 bg-[#050814] text-gray-200">
    <!-- Hub Header -->
    <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center mb-16">
      <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-blue-500/10 border border-blue-500/20 text-blue-400 text-xs font-bold uppercase tracking-wider mb-4">
        <span>📖</span> Official Knowledge Hub
      </div>
      <h1 class="text-4xl sm:text-5xl lg:text-6xl font-black text-white tracking-tight">
        British IPTV <span class="text-transparent bg-clip-text bg-gradient-to-r from-red-500 via-rose-300 to-blue-400">Guides &amp; Tutorials</span>
      </h1>
      <p class="mt-4 text-sm sm:text-base text-gray-400 max-w-2xl mx-auto">
        Everything you need to master your 4K IPTV setup, bypass ISP throttling, configure Firestick remotes, and optimize your TV guide.
      </p>
    </section>

    <!-- Guide Grid -->
    <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 mb-24">
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {allGuides.map((g) => (
          <a 
            href={`/guides/${g.slug}/`}
            class="group p-6 rounded-3xl bg-[#090E1D] border border-white/10 hover:border-blue-500/40 transition-all flex flex-col justify-between shadow-xl hover:-translate-y-1 duration-300"
          >
            <div>
              <!-- Guide Thumbnail with Alt Text -->
              <div class="mb-4 rounded-2xl overflow-hidden aspect-video bg-white/5 border border-white/5">
                <img 
                  src={
                    g.slug.includes('firestick') ? '/images/firestick-iptv-setup.jpg' :
                    g.slug.includes('premier') || g.slug.includes('football') ? '/images/premier-league-4k-stream.jpg' :
                    g.slug.includes('device') || g.slug.includes('tivimate') ? '/images/tivimate-premium-player.jpg' :
                    '/images/hero-4k-streaming.jpg'
                  } 
                  alt={`${g.title} - British IPTV Setup Guide`}
                  width="480"
                  height="270"
                  loading="lazy"
                  decoding="async"
                  class="w-full h-full object-cover transform transition-transform duration-300 group-hover:scale-105"
                />
              </div>
              <div class="flex items-center justify-between text-xs text-gray-500 mb-3">
                <span class="text-blue-400 font-bold uppercase tracking-wider">{g.category}</span>
                <span>{g.readingTime}</span>
              </div>
              <h2 class="text-lg font-bold text-white group-hover:text-blue-300 transition-colors leading-snug mb-3">
                {g.title}
              </h2>
              <p class="text-xs text-gray-400 line-clamp-3 leading-relaxed mb-6">
                {g.excerpt}
              </p>
            </div>
            <div class="pt-4 border-t border-white/5 flex items-center justify-between text-xs font-bold text-blue-400 group-hover:text-white transition-colors">
              <span>Read Full Tutorial &rarr;</span>
              <span class="text-gray-500 font-mono font-normal">{g.pubDate}</span>
            </div>
          </a>
        ))}
      </div>
    </section>

    <!-- Pricing Section -->
    <Pricing />

    <!-- Contact Support -->
    <ContactForm />
  </main>

  <Footer />
</Layout>
