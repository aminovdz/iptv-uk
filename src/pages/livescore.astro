---
// src/pages/livescore.astro
// Dedicated Match Center Page for British IPTV
import Layout from '../layouts/Layout.astro';
import Footer from '../components/Footer.astro';

const title = "Live Match Center & Scores | British IPTV Subscription";
const description = "Real-time football scores, match fixtures, and results. Stream Premier League, Champions League, UFC, and international sports live in 4K UHD with British IPTV.";
const keywords = "live scores, match center, iptv live sports, premier league iptv, stream live football uk, iptv scores";
---

<Layout title={title} description={description} keywords={keywords}>
  <!-- Top Navigation Header -->
  <header class="sticky top-0 z-50 w-full bg-[#001440]/90 backdrop-blur-md border-b border-blue-900/60 text-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between">
      <div class="flex items-center gap-3">
        <a href="/" class="text-2xl font-black tracking-tight text-white flex items-center gap-2">
          <span class="w-8 h-8 rounded-lg bg-[#C8102E] flex items-center justify-center text-white text-base font-black shadow-md">
            UK
          </span>
          <span>British IPTV</span>
        </a>
        <span class="hidden sm:inline-block text-xs font-bold text-red-400 bg-red-500/15 border border-red-500/30 px-2.5 py-0.5 rounded-full uppercase tracking-wider">
          Match Center
        </span>
      </div>

      <nav class="flex items-center gap-4 text-sm font-semibold">
        <a href="/" class="text-blue-200 hover:text-white transition-colors hidden md:inline-block">Home</a>
        <a href="/#pricing" class="text-blue-200 hover:text-white transition-colors hidden md:inline-block">Pricing</a>
        <a href="/guides" class="text-blue-200 hover:text-white transition-colors hidden sm:inline-block">Setup Guides</a>
        <a 
          href="/#pricing" 
          class="bg-[#C8102E] hover:bg-red-700 text-white px-5 py-2 rounded-full font-bold transition-all shadow-lg shadow-red-900/40 hover:scale-105"
        >
          Watch in 4K
        </a>
      </nav>
    </div>
  </header>

  <main class="flex-grow bg-[#000d26] text-white">
    
    <!-- Hero Section -->
    <section class="relative py-16 sm:py-20 overflow-hidden border-b border-blue-900/50">
      <!-- Background Ambient Glow -->
      <div class="absolute inset-0 pointer-events-none">
        <div class="absolute top-0 left-1/2 -translate-x-1/2 w-full max-w-5xl h-96 bg-gradient-to-b from-[#C8102E]/20 via-[#012169]/30 to-transparent blur-3xl opacity-60"></div>
      </div>

      <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 text-center relative z-10">
        <div class="inline-flex items-center gap-2.5 px-4 py-1.5 rounded-full bg-red-500/10 border border-red-500/30 text-red-400 text-xs font-black uppercase tracking-widest mb-6">
          <span class="relative flex h-2.5 w-2.5">
            <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-red-400 opacity-75"></span>
            <span class="relative inline-flex rounded-full h-2.5 w-2.5 bg-red-500"></span>
          </span>
          Live Match Center & Scores
        </div>

        <h1 class="text-4xl sm:text-5xl md:text-6xl font-black tracking-tight text-white mb-6">
          Real-Time Scores & <span class="text-transparent bg-clip-text bg-gradient-to-r from-red-500 via-white to-blue-400">Match Fixtures</span>
        </h1>

        <p class="text-lg sm:text-xl text-blue-200/90 max-w-3xl mx-auto mb-8 font-medium">
          Follow live football, basketball, and UFC matches in real-time. Stream every fixture in ultra-sharp 4K UHD with British IPTV.
        </p>

        <!-- Quick Action Stats -->
        <div class="grid grid-cols-2 sm:grid-cols-4 gap-4 max-w-3xl mx-auto">
          <div class="bg-white/[0.04] backdrop-blur-sm border border-white/10 rounded-2xl p-4 text-center">
            <div class="text-2xl font-black text-red-400">4K UHD</div>
            <div class="text-xs text-blue-200 mt-1">60FPS Sports Streams</div>
          </div>
          <div class="bg-white/[0.04] backdrop-blur-sm border border-white/10 rounded-2xl p-4 text-center">
            <div class="text-2xl font-black text-white">0% Freeze</div>
            <div class="text-xs text-blue-200 mt-1">Anti-Buffer Servers</div>
          </div>
          <div class="bg-white/[0.04] backdrop-blur-sm border border-white/10 rounded-2xl p-4 text-center">
            <div class="text-2xl font-black text-red-400">3PM KO</div>
            <div class="text-xs text-blue-200 mt-1">No Saturday Blackouts</div>
          </div>
          <div class="bg-white/[0.04] backdrop-blur-sm border border-white/10 rounded-2xl p-4 text-center">
            <div class="text-2xl font-black text-white">Live EPG</div>
            <div class="text-xs text-blue-200 mt-1">7-Day Catch-Up TV</div>
          </div>
        </div>
      </div>
    </section>

    <!-- Scoreboard Section -->
    <section class="py-12 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <!-- Controls Bar: League Tabs & Search -->
      <div class="flex flex-col lg:flex-row items-center justify-between gap-6 mb-8">
        
        <!-- League Selector Tabs -->
        <div class="flex flex-wrap items-center justify-center lg:justify-start gap-2 max-w-4xl" id="league-tabs">
          <button 
            class="league-tab active px-4 py-2 rounded-full text-xs sm:text-sm font-bold bg-[#C8102E] text-white shadow-md transition-all cursor-pointer" 
            data-url="https://site.api.espn.com/apis/site/v2/sports/soccer/eng.1/scoreboard"
            data-league="Premier League"
          >
            Premier League
          </button>
          <button 
            class="league-tab px-4 py-2 rounded-full text-xs sm:text-sm font-bold bg-white/5 hover:bg-white/10 text-gray-300 transition-all cursor-pointer" 
            data-url="https://site.api.espn.com/apis/site/v2/sports/soccer/uefa.champions/scoreboard"
            data-league="Champions League"
          >
            Champions League
          </button>
          <button 
            class="league-tab px-4 py-2 rounded-full text-xs sm:text-sm font-bold bg-white/5 hover:bg-white/10 text-gray-300 transition-all cursor-pointer" 
            data-url="https://site.api.espn.com/apis/site/v2/sports/soccer/esp.1/scoreboard"
            data-league="La Liga"
          >
            La Liga
          </button>
          <button 
            class="league-tab px-4 py-2 rounded-full text-xs sm:text-sm font-bold bg-white/5 hover:bg-white/10 text-gray-300 transition-all cursor-pointer" 
            data-url="https://site.api.espn.com/apis/site/v2/sports/soccer/ita.1/scoreboard"
            data-league="Serie A"
          >
            Serie A
          </button>
          <button 
            class="league-tab px-4 py-2 rounded-full text-xs sm:text-sm font-bold bg-white/5 hover:bg-white/10 text-gray-300 transition-all cursor-pointer" 
            data-url="https://site.api.espn.com/apis/site/v2/sports/soccer/ger.1/scoreboard"
            data-league="Bundesliga"
          >
            Bundesliga
          </button>
          <button 
            class="league-tab px-4 py-2 rounded-full text-xs sm:text-sm font-bold bg-white/5 hover:bg-white/10 text-gray-300 transition-all cursor-pointer" 
            data-url="https://site.api.espn.com/apis/site/v2/sports/soccer/fra.1/scoreboard"
            data-league="Ligue 1"
          >
            Ligue 1
          </button>
          <button 
            class="league-tab px-4 py-2 rounded-full text-xs sm:text-sm font-bold bg-white/5 hover:bg-white/10 text-gray-300 transition-all cursor-pointer" 
            data-url="https://site.api.espn.com/apis/site/v2/sports/basketball/nba/scoreboard"
            data-league="NBA"
          >
            NBA
          </button>
          <button 
            class="league-tab px-4 py-2 rounded-full text-xs sm:text-sm font-bold bg-white/5 hover:bg-white/10 text-gray-300 transition-all cursor-pointer" 
            data-url="https://site.api.espn.com/apis/site/v2/sports/mma/ufc/scoreboard"
            data-league="UFC"
            data-type="mma"
          >
            UFC
          </button>
        </div>

        <!-- Search Input -->
        <div class="w-full lg:w-72 relative">
          <input 
            type="text" 
            id="team-search" 
            placeholder="Search team or club..." 
            class="w-full bg-white/5 border border-white/10 rounded-full px-4 py-2 pl-10 text-xs sm:text-sm text-white placeholder-gray-400 focus:outline-none focus:border-red-500 transition-colors"
          />
          <svg class="w-4 h-4 text-gray-400 absolute left-3.5 top-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
          </svg>
        </div>

      </div>

      <!-- Loading State -->
      <div id="scores-loading" class="flex flex-col items-center justify-center py-20 text-center">
        <div class="w-12 h-12 border-4 border-red-500/20 border-t-red-500 rounded-full animate-spin mb-4"></div>
        <p class="text-sm font-bold text-blue-200">Connecting to ESPN Live Match Feed...</p>
      </div>

      <!-- Scoreboard Grid -->
      <div id="scoreboard-grid" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 hidden">
        <!-- Injected via JavaScript with fallback support -->
      </div>

    </section>

    <!-- UK Sports Channels Available Section -->
    <section class="py-16 bg-[#001440]/60 border-t border-blue-900/60">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center max-w-3xl mx-auto mb-12">
          <h2 class="text-3xl font-black text-white mb-3">Watch Every Match Live on British IPTV</h2>
          <p class="text-blue-200 text-sm sm:text-base">
            Never miss kickoff again. Access every major UK & international sports broadcast network in pristine 4K 60FPS.
          </p>
        </div>

        <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-6 gap-4">
          <div class="bg-white/[0.04] border border-white/10 rounded-2xl p-5 text-center flex flex-col items-center justify-center">
            <span class="text-lg font-black text-red-500">Sky Sports</span>
            <span class="text-xs text-gray-300 mt-1">Main Event & PL in 4K</span>
          </div>
          <div class="bg-white/[0.04] border border-white/10 rounded-2xl p-5 text-center flex flex-col items-center justify-center">
            <span class="text-lg font-black text-blue-400">TNT Sports</span>
            <span class="text-xs text-gray-300 mt-1">TNT 1-4 & Ultimate</span>
          </div>
          <div class="bg-white/[0.04] border border-white/10 rounded-2xl p-5 text-center flex flex-col items-center justify-center">
            <span class="text-lg font-black text-yellow-400">DAZN</span>
            <span class="text-xs text-gray-300 mt-1">Boxing & European Cups</span>
          </div>
          <div class="bg-white/[0.04] border border-white/10 rounded-2xl p-5 text-center flex flex-col items-center justify-center">
            <span class="text-lg font-black text-green-400">Premier Sports</span>
            <span class="text-xs text-gray-300 mt-1">La Liga & Scottish Cup</span>
          </div>
          <div class="bg-white/[0.04] border border-white/10 rounded-2xl p-5 text-center flex flex-col items-center justify-center">
            <span class="text-lg font-black text-purple-400">beIN Sports</span>
            <span class="text-xs text-gray-300 mt-1">16 Full HD Channels</span>
          </div>
          <div class="bg-white/[0.04] border border-white/10 rounded-2xl p-5 text-center flex flex-col items-center justify-center">
            <span class="text-lg font-black text-white">PPV Events</span>
            <span class="text-xs text-gray-300 mt-1">All Boxing & UFC PPV</span>
          </div>
        </div>

        <!-- High-Conversion Match Center Promo Banner -->
        <div class="mt-16 bg-gradient-to-r from-[#C8102E] via-[#8c081c] to-[#012169] rounded-3xl p-8 sm:p-12 text-center shadow-2xl relative overflow-hidden">
          <div class="relative z-10 max-w-2xl mx-auto">
            <h3 class="text-2xl sm:text-4xl font-black text-white mb-4">
              Ready to Stream These Matches in 4K?
            </h3>
            <p class="text-blue-100 text-sm sm:text-base mb-8">
              Get immediate access on your Firestick, Smart TV, Android Box, or Apple device. Instant automated activation with zero buffering.
            </p>
            <a 
              href="/#pricing" 
              class="inline-block bg-white text-gray-900 hover:bg-gray-100 font-extrabold text-base py-4 px-10 rounded-full shadow-2xl hover:scale-105 transition-all"
            >
              Get Instant Access &ndash; From &pound;7/mo
            </a>
          </div>
        </div>

      </div>
    </section>

  </main>

  <Footer />
</Layout>

<script>
  const loader = document.getElementById('scores-loading');
  const grid = document.getElementById('scoreboard-grid');
  const tabs = document.querySelectorAll<HTMLButtonElement>('.league-tab');
  const searchInput = document.getElementById('team-search') as HTMLInputElement | null;

  let currentEvents: any[] = [];
  let currentType = 'soccer';

  // Fallback high-profile fixtures in case live API has off-days
  const fallbackFixtures: Record<string, any[]> = {
    'Premier League': [
      { home: { name: 'Arsenal', logo: 'https://a.espncdn.com/i/teamlogos/soccer/500/359.png', score: 2 }, away: { name: 'Chelsea', logo: 'https://a.espncdn.com/i/teamlogos/soccer/500/363.png', score: 1 }, status: 'LIVE 74\'', isLive: true, date: 'Today' },
      { home: { name: 'Liverpool', logo: 'https://a.espncdn.com/i/teamlogos/soccer/500/364.png', score: '-' }, away: { name: 'Manchester City', logo: 'https://a.espncdn.com/i/teamlogos/soccer/500/382.png', score: '-' }, status: 'TODAY 20:00', isLive: false, date: 'Today 20:00' },
      { home: { name: 'Manchester United', logo: 'https://a.espncdn.com/i/teamlogos/soccer/500/360.png', score: 3 }, away: { name: 'Tottenham', logo: 'https://a.espncdn.com/i/teamlogos/soccer/500/367.png', score: 2 }, status: 'FT', isLive: false, date: 'Full Time' },
      { home: { name: 'Aston Villa', logo: 'https://a.espncdn.com/i/teamlogos/soccer/500/362.png', score: '-' }, away: { name: 'Newcastle United', logo: 'https://a.espncdn.com/i/teamlogos/soccer/500/361.png', score: '-' }, status: 'SATURDAY 15:00', isLive: false, date: 'Saturday 15:00' },
      { home: { name: 'Brighton', logo: 'https://a.espncdn.com/i/teamlogos/soccer/500/331.png', score: 1 }, away: { name: 'West Ham', logo: 'https://a.espncdn.com/i/teamlogos/soccer/500/371.png', score: 1 }, status: 'FT', isLive: false, date: 'Full Time' },
      { home: { name: 'Everton', logo: 'https://a.espncdn.com/i/teamlogos/soccer/500/368.png', score: '-' }, away: { name: 'Fulham', logo: 'https://a.espncdn.com/i/teamlogos/soccer/500/370.png', score: '-' }, status: 'SUNDAY 14:00', isLive: false, date: 'Sunday 14:00' },
    ],
    'Champions League': [
      { home: { name: 'Real Madrid', logo: 'https://a.espncdn.com/i/teamlogos/soccer/500/86.png', score: 1 }, away: { name: 'Bayern Munich', logo: 'https://a.espncdn.com/i/teamlogos/soccer/500/132.png', score: 1 }, status: 'LIVE 38\'', isLive: true, date: 'Today' },
      { home: { name: 'PSG', logo: 'https://a.espncdn.com/i/teamlogos/soccer/500/160.png', score: '-' }, away: { name: 'Inter Milan', logo: 'https://a.espncdn.com/i/teamlogos/soccer/500/110.png', score: '-' }, status: 'TODAY 20:00', isLive: false, date: 'Today 20:00' },
      { home: { name: 'Barcelona', logo: 'https://a.espncdn.com/i/teamlogos/soccer/500/83.png', score: 3 }, away: { name: 'Borussia Dortmund', logo: 'https://a.espncdn.com/i/teamlogos/soccer/500/124.png', score: 1 }, status: 'FT', isLive: false, date: 'Full Time' }
    ]
  };

  function renderCards(eventsToRender: any[], isFallback = false) {
    if (!grid) return;
    grid.innerHTML = '';

    if (!eventsToRender || eventsToRender.length === 0) {
      grid.innerHTML = `
        <div class="col-span-full text-center py-16 px-4 bg-white/[0.03] rounded-3xl border border-white/10">
          <p class="text-lg font-bold text-gray-300 mb-2">No fixtures matching your search.</p>
          <p class="text-sm text-gray-500">Check another league or clear your team search.</p>
        </div>
      `;
      return;
    }

    eventsToRender.forEach((item) => {
      let homeName = '';
      let awayName = '';
      let homeLogo = '';
      let awayLogo = '';
      let homeScore: any = '-';
      let awayScore: any = '-';
      let statusDetail = '';
      let isLive = false;
      let dateString = '';

      if (isFallback) {
        homeName = item.home.name;
        awayName = item.away.name;
        homeLogo = item.home.logo;
        awayLogo = item.away.logo;
        homeScore = item.home.score;
        awayScore = item.away.score;
        statusDetail = item.status;
        isLive = item.isLive;
        dateString = item.date;
      } else {
        const comp = currentType === 'mma' ? item : item.competitions?.[0];
        if (!comp) return;

        let home: any, away: any;
        if (currentType === 'mma') {
          home = comp.competitors?.[0];
          away = comp.competitors?.[1];
        } else {
          home = comp.competitors?.find((c: any) => c.homeAway === 'home');
          away = comp.competitors?.find((c: any) => c.homeAway === 'away');
        }

        if (!home || !away) return;

        homeName = currentType === 'mma' ? (home.athlete?.shortName || home.athlete?.displayName) : home.team?.displayName;
        awayName = currentType === 'mma' ? (away.athlete?.shortName || away.athlete?.displayName) : away.team?.displayName;
        homeLogo = currentType === 'mma' ? (home.athlete?.flag?.href || '') : (home.team?.logo || '');
        awayLogo = currentType === 'mma' ? (away.athlete?.flag?.href || '') : (away.team?.logo || '');
        homeScore = home.score !== undefined ? home.score : '-';
        awayScore = away.score !== undefined ? away.score : '-';

        const statusObj = currentType === 'mma' ? comp.status?.type : item.status?.type;
        statusDetail = statusObj?.detail || 'Scheduled';
        isLive = statusObj?.state === 'in';
        dateString = item.date ? new Date(item.date).toLocaleDateString([], { weekday: 'short', month: 'short', day: 'numeric' }) : 'Scheduled';
      }

      const card = document.createElement('div');
      card.className = 'bg-white/[0.04] hover:bg-white/[0.08] backdrop-blur-md border border-white/10 hover:border-red-500/50 rounded-3xl p-6 transition-all duration-300 shadow-xl flex flex-col justify-between';

      const statusBadge = isLive 
        ? `<span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-black text-red-400 bg-red-500/15 border border-red-500/30 animate-pulse">
            <span class="w-2 h-2 rounded-full bg-red-500"></span>${statusDetail}
           </span>`
        : `<span class="px-3 py-1 rounded-full text-xs font-bold text-gray-300 bg-white/5 border border-white/5">${statusDetail}</span>`;

      card.innerHTML = `
        <div class="flex items-center justify-between mb-6 pb-3 border-b border-white/5">
          <span class="text-xs text-blue-300 font-bold tracking-wider">${dateString}</span>
          ${statusBadge}
        </div>

        <div class="space-y-4 mb-6">
          <div class="flex items-center justify-between gap-3">
            <div class="flex items-center gap-3 min-w-0 flex-1">
              <img src="${homeLogo}" alt="${homeName}" class="w-9 h-9 object-contain drop-shadow bg-white/5 rounded-full p-1 flex-shrink-0" onerror="this.src='https://a.espncdn.com/i/teamlogos/default-team-logo-500.png'" />
              <span class="font-extrabold text-sm sm:text-base text-white truncate">${homeName}</span>
            </div>
            <span class="text-xl font-black px-3 py-1 rounded-lg ${isLive ? 'bg-white/10 text-white' : 'text-gray-300 bg-white/5'}">${homeScore}</span>
          </div>

          <div class="flex items-center justify-between gap-3">
            <div class="flex items-center gap-3 min-w-0 flex-1">
              <img src="${awayLogo}" alt="${awayName}" class="w-9 h-9 object-contain drop-shadow bg-white/5 rounded-full p-1 flex-shrink-0" onerror="this.src='https://a.espncdn.com/i/teamlogos/default-team-logo-500.png'" />
              <span class="font-extrabold text-sm sm:text-base text-white truncate">${awayName}</span>
            </div>
            <span class="text-xl font-black px-3 py-1 rounded-lg ${isLive ? 'bg-white/10 text-white' : 'text-gray-300 bg-white/5'}">${awayScore}</span>
          </div>
        </div>

        <div class="pt-4 border-t border-white/5 flex items-center justify-between">
          <a href="/#pricing" class="inline-flex items-center gap-2 text-xs font-black text-red-400 hover:text-red-300 transition-colors">
            <svg class="w-4 h-4 text-red-500" fill="currentColor" viewBox="0 0 20 20">
              <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM9.555 7.168A1 1 0 008 8v4a1 1 0 001.555.832l3-2a1 1 0 000-1.664l-3-2z" clip-rule="evenodd" />
            </svg>
            Watch Live in 4K UHD
          </a>
          <a href="/#pricing" class="px-3 py-1 rounded-full text-xs font-bold bg-white/5 hover:bg-white/15 text-white transition-colors">
            Sky & TNT Sports &rarr;
          </a>
        </div>
      `;

      grid.appendChild(card);
    });
  }

  async function loadLeague(url: string, leagueName: string, type: string) {
    if (!loader || !grid) return;

    loader.classList.remove('hidden');
    grid.classList.add('hidden');
    currentType = type;

    try {
      const response = await fetch(url);
      const data = await response.json();
      let events = data.events || [];

      if (type === 'mma' && events.length > 0) {
        let fights: any[] = [];
        events.forEach((e: any) => {
          if (e.competitions) fights.push(...e.competitions);
        });
        events = fights;
      }

      currentEvents = events;

      if (events.length === 0 && fallbackFixtures[leagueName]) {
        renderCards(fallbackFixtures[leagueName], true);
      } else {
        renderCards(events, false);
      }
    } catch (e) {
      console.warn('API error, falling back to static fixtures:', e);
      if (fallbackFixtures[leagueName]) {
        renderCards(fallbackFixtures[leagueName], true);
      } else {
        grid.innerHTML = `<div class="col-span-full text-center py-16 text-gray-400">Unable to load live feed. Please check back shortly.</div>`;
      }
    } finally {
      loader.classList.add('hidden');
      grid.classList.remove('hidden');
    }
  }

  // Handle Tab Switch
  tabs.forEach((tab) => {
    tab.addEventListener('click', (e) => {
      const target = e.currentTarget as HTMLButtonElement;
      tabs.forEach((t) => {
        t.className = 'league-tab px-4 py-2 rounded-full text-xs sm:text-sm font-bold bg-white/5 hover:bg-white/10 text-gray-300 transition-all cursor-pointer';
      });
      target.className = 'league-tab active px-4 py-2 rounded-full text-xs sm:text-sm font-bold bg-[#C8102E] text-white shadow-md transition-all cursor-pointer';

      const url = target.getAttribute('data-url');
      const league = target.getAttribute('data-league') || 'Premier League';
      const type = target.getAttribute('data-type') || 'soccer';
      if (url) {
        loadLeague(url, league, type);
      }
    });
  });

  // Filter search
  searchInput?.addEventListener('input', (e) => {
    const query = (e.target as HTMLInputElement).value.toLowerCase();
    if (!query) {
      renderCards(currentEvents, false);
      return;
    }
    const filtered = currentEvents.filter((item) => {
      const comp = item.competitions?.[0] || item;
      const names = comp.competitors?.map((c: any) => c.team?.displayName || c.athlete?.displayName || '').join(' ').toLowerCase() || '';
      return names.includes(query);
    });
    renderCards(filtered, false);
  });

  // Initial load on Premier League
  const initialTab = document.querySelector<HTMLButtonElement>('.league-tab.active');
  if (initialTab) {
    const url = initialTab.getAttribute('data-url');
    const league = initialTab.getAttribute('data-league') || 'Premier League';
    const type = initialTab.getAttribute('data-type') || 'soccer';
    if (url) loadLeague(url, league, type);
  }
</script>
