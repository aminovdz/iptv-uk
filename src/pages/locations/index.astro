---
// src/pages/locations/index.astro
// UK Local SEO Locations Hub Page
import Layout from '../../layouts/Layout.astro';
import StickyHeader from '../../components/StickyHeader.astro';
import LiveScores from '../../components/LiveScores.astro';
import Pricing from '../../components/Pricing.astro';
import UserReviewsSection from '../../components/UserReviewsSection.astro';
import FAQSection from '../../components/FAQSection.astro';
import ContactForm from '../../components/ContactForm.astro';
import Footer from '../../components/Footer.astro';
import { currentYear } from '../../utils/year';

const title = `UK Locations & Regional Coverage (${currentYear}) | British IPTV Edge Network`;
const description = `Discover British IPTV's dedicated edge server coverage across the United Kingdom in ${currentYear}. Ultra-low latency 4K streaming in London, Manchester, Scotland, Glasgow, Birmingham, Leeds, Liverpool.`;
const keywords = "iptv uk locations, best iptv london, iptv manchester, iptv scotland, iptv glasgow, iptv birmingham, iptv edinburgh, iptv liverpool, iptv leeds, uk iptv edge servers";

const cities = [
  { 
    slug: 'london', 
    name: 'London', 
    county: 'Greater London',
    clubs: 'Arsenal, Chelsea, Tottenham & West Ham',
    broadband: 'Hyperoptic, BT Full Fibre & Community Fibre',
    latency: '<12ms',
    subscribers: '12,400+'
  },
  { 
    slug: 'manchester', 
    name: 'Manchester', 
    county: 'Greater Manchester',
    clubs: 'Manchester City & Manchester United',
    broadband: 'CityFibre, Virgin Media & BT FTTP',
    latency: '<15ms',
    subscribers: '9,800+'
  },
  { 
    slug: 'birmingham', 
    name: 'Birmingham', 
    county: 'West Midlands',
    clubs: 'Aston Villa & Birmingham City',
    broadband: 'Virgin Media Gig1 & Openreach Fibre',
    latency: '<14ms',
    subscribers: '8,200+'
  },
  { 
    slug: 'scotland', 
    name: 'Scotland', 
    county: 'Scotland (Nationwide)',
    clubs: 'Celtic, Rangers, Aberdeen & Hearts',
    broadband: 'Virgin Media, Openreach FTTP & CityFibre Scotland',
    latency: '<16ms',
    subscribers: '8,900+'
  },
  { 
    slug: 'glasgow', 
    name: 'Glasgow', 
    county: 'Greater Glasgow & Clyde',
    clubs: 'Rangers & Celtic (The Old Firm)',
    broadband: 'Virgin Media Gig1, Hyperoptic & CityFibre',
    latency: '<17ms',
    subscribers: '6,400+'
  },
  { 
    slug: 'edinburgh', 
    name: 'Edinburgh', 
    county: 'Midlothian (Scotland)',
    clubs: 'Hearts & Hibernian',
    broadband: 'CityFibre & Virgin Media M500',
    latency: '<18ms',
    subscribers: '5,100+'
  },
  { 
    slug: 'liverpool', 
    name: 'Liverpool', 
    county: 'Merseyside',
    clubs: 'Liverpool FC & Everton',
    broadband: 'Virgin Media & BT Ultrafast Fibre',
    latency: '<15ms',
    subscribers: '7,300+'
  },
  { 
    slug: 'leeds', 
    name: 'Leeds', 
    county: 'West Yorkshire',
    clubs: 'Leeds United',
    broadband: 'CityFibre, Openreach FTTP & Virgin Media',
    latency: '<15ms',
    subscribers: '4,800+'
  },
  { 
    slug: 'newcastle', 
    name: 'Newcastle', 
    county: 'Tyne and Wear',
    clubs: 'Newcastle United & Sunderland',
    broadband: 'Virgin Media Gig1 & Openreach Full Fibre',
    latency: '<16ms',
    subscribers: '4,200+'
  },
  { 
    slug: 'cardiff', 
    name: 'Cardiff', 
    county: 'Wales',
    clubs: 'Cardiff City & Swansea City',
    broadband: 'Openreach FTTP & Virgin Media Gig1',
    latency: '<16ms',
    subscribers: '3,900+'
  },
  { 
    slug: 'belfast', 
    name: 'Belfast', 
    county: 'Northern Ireland',
    clubs: 'Linfield & Glentoran',
    broadband: 'Fibrus Full Fibre, Openreach & Virgin Media',
    latency: '<19ms',
    subscribers: '3,400+'
  }
];

const locationsFaqs = [
  {
    question: "How does British IPTV ensure buffer-free streaming across different UK regions?",
    answer: "We deploy edge server nodes directly connected to LINX (London Internet Exchange) and regional UK Internet Exchange points. Traffic routes dynamically to the nearest caching node, keeping latency under 15ms and bypassing ISP throttling during peak football matches."
  },
  {
    question: "Do you support rural and suburban broadband connections?",
    answer: "Yes. Our Anti-Freeze™ 9.0 adaptive bitrate protocol dynamically adjusts video compression to maintain smooth 60fps playback on connections from 15 Mbps upwards."
  },
  {
    question: "Can I watch local regional TV news and football teams?",
    answer: "Every regional variant and live match feed is available with full 7-day electronic TV guide (EPG) data across all UK regions."
  }
];
---

<Layout 
  title={title} 
  description={description} 
  keywords={keywords}
  type="product"
  faqs={locationsFaqs}
>
  <StickyHeader />

  <main class="flex-grow pt-28 pb-20 bg-[#050814] text-gray-200">
    <!-- Hub Header -->
    <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center mb-16">
      <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-red-500/10 border border-red-500/20 text-red-400 text-xs font-bold uppercase tracking-wider mb-4">
        <span class="w-2 h-2 rounded-full bg-red-500 animate-pulse"></span>
        UK Regional Coverage • Dedicated Edge Nodes
      </div>
      <h1 class="text-4xl sm:text-5xl lg:text-6xl font-black text-white tracking-tight leading-tight">
        Local IPTV Servers Across the <br class="hidden sm:inline" />
        <span class="text-transparent bg-clip-text bg-gradient-to-r from-red-500 via-rose-300 to-blue-400">United Kingdom</span>
      </h1>
      <p class="mt-4 text-base sm:text-lg text-gray-300 max-w-2xl mx-auto leading-relaxed">
        Ultra-low latency, zero ISP throttling, and pristine 4K live sports delivered to your city through our UK CDN infrastructure.
      </p>

      <!-- UK Regional Network Visual Preview -->
      <div class="mt-8 max-w-4xl mx-auto rounded-3xl overflow-hidden border border-white/10 shadow-2xl shadow-blue-950/60 relative group">
        <img 
          src="/images/uk-cities-network.jpg" 
          alt="British IPTV UK regional edge servers and ultra-fast broadband streaming network across London, Manchester and Edinburgh"
          width="1280"
          height="720"
          loading="eager"
          decoding="async"
          class="w-full h-auto object-cover rounded-3xl transform transition-transform duration-500 group-hover:scale-[1.01]"
        />
      </div>
    </section>

    <!-- Real-Time Sports Live Ticker -->
    <LiveScores />

    <!-- City Cards Grid -->
    <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 mb-20">
      <div class="text-center sm:text-left mb-8">
        <h2 class="text-2xl sm:text-3xl font-black text-white">Select Your Region</h2>
        <p class="text-sm text-gray-400">Optimized for regional broadband networks and local football derbies.</p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {cities.map((city) => (
          <div class="p-6 sm:p-8 rounded-3xl bg-[#090E1D] border border-white/10 hover:border-red-500/40 transition-all flex flex-col justify-between shadow-xl group hover:-translate-y-1 duration-300">
            <div>
              <div class="flex items-center justify-between text-xs text-gray-400 mb-4">
                <span class="px-2.5 py-1 rounded-full bg-white/5 border border-white/10 font-mono text-emerald-400 font-bold">
                  ⚡ Latency: {city.latency}
                </span>
                <span class="text-gray-500">{city.subscribers} Users</span>
              </div>

              <h3 class="text-2xl font-black text-white group-hover:text-red-400 transition-colors mb-1">
                {city.name}
              </h3>
              <p class="text-xs text-gray-400 font-medium mb-4">{city.county}</p>

              <div class="space-y-2 text-xs text-gray-300 mb-6">
                <div class="flex items-start gap-2">
                  <span class="text-blue-400 font-bold">⚽ Clubs:</span>
                  <span class="text-gray-400">{city.clubs}</span>
                </div>
                <div class="flex items-start gap-2">
                  <span class="text-emerald-400 font-bold">🛡️ ISP Tested:</span>
                  <span class="text-gray-400">{city.broadband}</span>
                </div>
              </div>
            </div>

            <div class="pt-4 border-t border-white/5 flex items-center justify-between">
              <a 
                href={`/locations/${city.slug}`}
                class="inline-flex items-center gap-1.5 text-xs font-bold text-red-400 group-hover:text-white transition-colors"
              >
                <span>View {city.name} Network &rarr;</span>
              </a>
              <a 
                href={`https://wa.me/213550592200?text=${encodeURIComponent(`Hello! I live in ${city.name} and want to claim a 24H free trial.`)}`}
                target="_blank" 
                rel="noopener noreferrer"
                class="px-3 py-1.5 rounded-lg bg-[#25D366] text-black font-bold text-xs hover:bg-[#1fb355] transition-all"
              >
                Free Trial
              </a>
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- Pricing Section (12-Mo Plan £47 First) -->
    <Pricing />

    <!-- Reviews -->
    <UserReviewsSection />

    <!-- FAQs -->
    <FAQSection />

    <!-- Contact Form -->
    <ContactForm />
  </main>

  <Footer />
</Layout>
