---
// src/pages/index.astro
// Master High-Converting Production Homepage for British IPTV
import Layout from '../layouts/Layout.astro';
import StickyHeader from '../components/StickyHeader.astro';
import Hero from '../components/Hero.astro';
import LiveScores from '../components/LiveScores.astro';
import FeatureGrid from '../components/FeatureGrid.astro';
import Pricing from '../components/Pricing.astro';
import ProcessSteps from '../components/ProcessSteps.astro';
import SupportedDevices from '../components/SupportedDevices.astro';
import UserReviewsSection from '../components/UserReviewsSection.astro';
import ReferralBanner from '../components/ReferralBanner.astro';
import CitiesList from '../components/CitiesList.astro';
import FAQSection from '../components/FAQSection.astro';
import ContactForm from '../components/ContactForm.astro';
import Footer from '../components/Footer.astro';

const title = "British IPTV - #1 Best IPTV UK Provider 2026 | 4K UHD Streams";
const description = "Experience the best IPTV UK subscription with 99.9% uptime, Anti-Freeze™ 9.0 technology, live Premier League sports, and instant WhatsApp activation. From £7/month.";
const keywords = "best iptv uk, iptv subscription uk, buy iptv uk, iptv provider uk, iptv firestick uk, 4k iptv stream uk, premier league iptv, british iptv";

const homepageFaqs = [
  {
    question: "Is British IPTV compatible with my Amazon Firestick or Smart TV?",
    answer: "Yes, 100%. Our service works smoothly on all generations of the Amazon Fire TV Stick, Smart TVs running Samsung Tizen, LG webOS, or Android TV, as well as Apple TV, iPhone, iPad, Android mobile, and Windows/Mac PCs. You can use standard players like TiviMate, IPTV Smarters Pro, or IBO Player."
  },
  {
    question: "Can I watch Saturday 3PM Premier League matches without blackouts?",
    answer: "Yes. In the UK, the 3PM blackout rule (Article 48) prevents domestic channels from broadcasting Saturday afternoon games. Our international high-definition stadium feeds broadcast every single Saturday 3PM kickoff live in crystal-clear Full HD and 4K with English commentary."
  },
  {
    question: "What internet speed do I need for buffer-free 4K streaming?",
    answer: "We recommend a stable broadband connection of at least 15 Mbps for HD streams and 30 Mbps+ for raw 4K UHD 60FPS sports. Connecting your streaming device via an Ethernet cable or 5GHz Wi-Fi ensures optimal performance."
  },
  {
    question: "Do I need a VPN to use British IPTV in the UK?",
    answer: "In most cases, no. Our custom Anti-Freeze™ 9.0 server infrastructure uses dynamic IP rotation to bypass standard UK ISP throttling (BT, Virgin Media, Sky, EE). However, if you already own a VPN like Surfshark or NordVPN, you are welcome to use it."
  },
  {
    question: "How quickly will I receive my login credentials after ordering?",
    answer: "Instant delivery. Once your order is submitted, our automated provisioning system generates your unique M3U playlist URL and Xtream Codes API credentials, sending them to your WhatsApp and email address within 90 seconds."
  },
  {
    question: "Can I test the service before committing to a paid pass?",
    answer: "Yes! We offer a completely free 24-hour test stream with full access to live sports, UK entertainment channels, and our on-demand library so you can verify our speed and 4K picture quality before purchasing."
  },
  {
    question: "What is your refund policy if I experience technical issues?",
    answer: "We provide a strict 24-Hour Money-Back Guarantee. If our technical support team is unable to resolve your connection issues within 24 hours of your initial activation, you will receive a full refund."
  }
];
---

<Layout 
  title={title} 
  description={description} 
  keywords={keywords}
  type="home"
  faqs={homepageFaqs}
>
  <!-- 1. Sticky Navigation Header -->
  <StickyHeader />

  <main class="flex-grow">
    <!-- 2. High-Converting Hero Section -->
    <Hero />

    <!-- 3. Real Live Scores Infinite Loop Carousel (Click cards -> /livescore Match Center) -->
    <LiveScores />

    <!-- 4. Core Features & Anti-Freeze Architecture -->
    <FeatureGrid />

    <!-- 5. Transparent Pricing Table (12-Month Plan £47 FIRST as Best Value) -->
    <Pricing />

    <!-- 6. 3-Step Instant Activation Workflow -->
    <ProcessSteps />

    <!-- 7. Comprehensive Supported Devices & Compatible Media Players -->
    <SupportedDevices />

    <!-- 8. Verified UK Customer Reviews & 4.9 Star Rating Social Proof -->
    <UserReviewsSection />

    <!-- 9. Refer-a-Friend Rewards Banner (+1 Month Free) -->
    <ReferralBanner />

    <!-- 10. Local UK Programmatic Geo-Coverage Grid (London, Manchester, etc.) -->
    <CitiesList />

    <!-- 11. FAQ Accordion (100% Synced to Server-Side FAQPage JSON-LD Schema) -->
    <FAQSection />

    <!-- 12. 24/7 Technical Support & WhatsApp Instant Routing Form -->
    <ContactForm />
  </main>

  <!-- 13. High-Converting Footer (Flame Map Embed, Westminster HQ & Compliance Links) -->
  <Footer />
</Layout>
