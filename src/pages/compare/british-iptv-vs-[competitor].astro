---
// src/pages/compare/british-iptv-vs-[competitor].astro
// Programmatic Competitor Comparison Pages matching [brand]-vs-[competitor] pattern
export const prerender = true;

import Layout from '../../layouts/Layout.astro';
import StickyHeader from '../../components/StickyHeader.astro';
import Pricing from '../../components/Pricing.astro';
import UserReviewsSection from '../../components/UserReviewsSection.astro';
import FAQSection from '../../components/FAQSection.astro';
import ContactForm from '../../components/ContactForm.astro';
import Footer from '../../components/Footer.astro';
import { currentYear } from '../../utils/year';

export function getStaticPaths() {
  const competitors = [
    { 
      slug: 'greatiptv', 
      name: 'Great IPTV',
      type: 'IPTV Provider',
      price: '£59 - £75 / year',
      uptime: '96.2%',
      support: 'Ticket system (slow)',
      antiFreeze: 'Standard software buffer',
      sports3pm: 'Inconsistent links'
    },
    { 
      slug: 'wiztv', 
      name: 'WizTV UK',
      type: 'IPTV Provider',
      price: '£65 / year',
      uptime: '97.5%',
      support: 'Email only (24-48h wait)',
      antiFreeze: 'Basic CDN cache',
      sports3pm: 'Occasional stream drops'
    },
    { 
      slug: 'iptvuk-cloud', 
      name: 'IPTV UK Cloud',
      type: 'IPTV Provider',
      price: '£60 / year',
      uptime: '98.1%',
      support: 'Telegram bot only',
      antiFreeze: 'Limited edge nodes',
      sports3pm: 'Buffering during big games'
    },
    { 
      slug: 'premium-tv', 
      name: 'Sky Glass & Satellite',
      type: 'Legacy Cable / Satellite',
      price: '£85 - £110 / month',
      uptime: '99.0% (weather dependent)',
      support: 'Phone queues (30+ mins)',
      antiFreeze: 'Proprietary dish hardware',
      sports3pm: 'Blocked (Article 48 blackout)'
    },
    { 
      slug: 'bt-tv', 
      name: 'BT TV (EE TV)',
      type: 'Legacy Cable',
      price: '£76 / month',
      uptime: '98.5%',
      support: 'Call centre only',
      antiFreeze: 'Broadband dependent',
      sports3pm: 'Blocked (Article 48 blackout)'
    },
    { 
      slug: 'virgin-media', 
      name: 'Virgin Media TV',
      type: 'Legacy Cable',
      price: '£82 / month',
      uptime: '98.0%',
      support: 'Call centre & community forum',
      antiFreeze: 'Coaxial network cables',
      sports3pm: 'Blocked (Article 48 blackout)'
    }
  ];

  return competitors.map(c => ({
    params: { competitor: c.slug },
    props: { comp: c }
  }));
}

const { comp } = Astro.props;
const { name: competitorName, type: compType, price: compPrice, uptime: compUptime, support: compSupport, antiFreeze: compAntiFreeze, sports3pm: compSports3pm } = comp;

const title = `British IPTV vs ${competitorName} (${currentYear} Comparison) | Which is Best?`;
const description = `Unbiased comparison: British IPTV vs ${competitorName}. Compare pricing (£47/year vs ${compPrice}), 4K streaming stability, Anti-Freeze tech, and 3PM football coverage.`;
const keywords = `british iptv vs ${competitorName.toLowerCase()}, ${competitorName.toLowerCase()} review, best alternative to ${competitorName.toLowerCase()}, iptv uk comparison`;

const compareFaqs = [
  {
    question: `Why do UK streamers switch from ${competitorName} to British IPTV?`,
    answer: `Streamers switch because British IPTV delivers superior 4K UHD picture quality with Anti-Freeze™ 9.0 stability, full Saturday 3PM match access, and transparent pricing (£47 for an entire year) with zero lock-in contracts.`
  },
  {
    question: `How easy is it to migrate from ${competitorName}?`,
    answer: `Migration takes less than 2 minutes. You don't need any new hardware—our M3U and Xtream Codes credentials work on your existing Amazon Firestick, Smart TV, or Android box.`
  },
  {
    question: `Do you provide a test stream before I make the switch?`,
    answer: `Yes, we offer a 100% free 24-hour trial with full 4K sports access so you can directly compare stream stability on your own television before subscribing.`
  }
];
---

<Layout 
  title={title} 
  description={description} 
  keywords={keywords}
  type="article"
  faqs={compareFaqs}
>
  <StickyHeader />

  <main class="flex-grow">
    <!-- Comparison Hero -->
    <section class="relative pt-32 pb-20 bg-gradient-to-b from-[#0B0F19] via-[#050814] to-[#050814] text-white overflow-hidden border-b border-blue-900/40">
      <div class="absolute top-1/4 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[700px] h-[400px] bg-blue-600/10 blur-[160px] pointer-events-none rounded-full"></div>

      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10 text-center">
        <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-blue-500/10 border border-blue-500/30 text-blue-400 text-xs font-black uppercase tracking-widest mb-6">
          <span>⚖️</span> Side-by-Side Comparison {currentYear}
        </div>

        <h1 class="text-4xl sm:text-6xl lg:text-7xl font-black tracking-tight max-w-5xl mx-auto leading-tight">
          British IPTV vs <span class="text-transparent bg-clip-text bg-gradient-to-r from-red-500 via-rose-300 to-blue-400">{competitorName}</span>
        </h1>

        <p class="mt-6 text-lg sm:text-xl text-gray-300 max-w-3xl mx-auto leading-relaxed">
          Looking for an honest evaluation? Compare picture resolution, uptime stability, live sports coverage, and annual cost to make the smartest streaming choice.
        </p>

        <div class="mt-8 flex flex-col sm:flex-row items-center justify-center gap-4">
          <a 
            href="#pricing" 
            class="w-full sm:w-auto px-8 py-4 rounded-xl bg-gradient-to-r from-red-600 to-blue-600 text-white font-black text-base hover:from-red-500 hover:to-blue-500 transition-all shadow-xl shadow-red-500/25 flex items-center justify-center gap-2"
          >
            <span>Switch to British IPTV (£47/Year)</span>
            <span>&rarr;</span>
          </a>
          <a 
            href={`https://wa.me/213550592200?text=${encodeURIComponent(`Hello British IPTV! I currently use ${competitorName} and want to test your 4K stream quality.`)}`}
            target="_blank" 
            rel="noopener noreferrer"
            class="w-full sm:w-auto px-7 py-4 rounded-xl bg-[#25D366] text-black font-black text-base hover:bg-[#1fb355] transition-all shadow-lg flex items-center justify-center gap-2"
          >
            <span>Test 24H Free Stream on WhatsApp</span>
          </a>
        </div>
      </div>
    </section>

    <!-- Side-by-Side Comparison Matrix -->
    <section class="py-20 bg-[#070B17] border-b border-white/5">
      <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center mb-12">
          <h2 class="text-2xl sm:text-4xl font-black text-white tracking-tight">
            Feature &amp; Stability Breakdown
          </h2>
          <p class="mt-2 text-sm text-gray-400">
            How British IPTV compares directly to {competitorName} ({compType}).
          </p>
        </div>

        <div class="rounded-3xl bg-[#0C1222] border border-white/10 overflow-hidden shadow-2xl">
          <div class="grid grid-cols-12 bg-white/[0.04] p-4 sm:p-6 border-b border-white/10 text-xs sm:text-sm font-black uppercase tracking-wider text-gray-400">
            <div class="col-span-5 sm:col-span-4">Feature / Metric</div>
            <div class="col-span-4 sm:col-span-4 text-emerald-400">British IPTV</div>
            <div class="col-span-3 sm:col-span-4 text-gray-400">{competitorName}</div>
          </div>

          <!-- Row 1: Pricing -->
          <div class="grid grid-cols-12 p-4 sm:p-6 border-b border-white/5 text-xs sm:text-sm items-center hover:bg-white/[0.02] transition-colors">
            <div class="col-span-5 sm:col-span-4 font-bold text-white">Annual Cost</div>
            <div class="col-span-4 sm:col-span-4 font-black text-emerald-400">£47 / year (Fixed)</div>
            <div class="col-span-3 sm:col-span-4 text-red-400 font-medium">{compPrice}</div>
          </div>

          <!-- Row 2: Resolution & Bitrate -->
          <div class="grid grid-cols-12 p-4 sm:p-6 border-b border-white/5 text-xs sm:text-sm items-center hover:bg-white/[0.02] transition-colors">
            <div class="col-span-5 sm:col-span-4 font-bold text-white">Resolution &amp; FPS</div>
            <div class="col-span-4 sm:col-span-4 font-black text-emerald-400">True 4K UHD &amp; 60FPS</div>
            <div class="col-span-3 sm:col-span-4 text-gray-300">Compressed 1080p / 25-50FPS</div>
          </div>

          <!-- Row 3: Buffer Technology -->
          <div class="grid grid-cols-12 p-4 sm:p-6 border-b border-white/5 text-xs sm:text-sm items-center hover:bg-white/[0.02] transition-colors">
            <div class="col-span-5 sm:col-span-4 font-bold text-white">Buffer Technology</div>
            <div class="col-span-4 sm:col-span-4 font-black text-emerald-400">Anti-Freeze™ 9.0 Edge</div>
            <div class="col-span-3 sm:col-span-4 text-gray-300">{compAntiFreeze}</div>
          </div>

          <!-- Row 4: Saturday 3PM Football -->
          <div class="grid grid-cols-12 p-4 sm:p-6 border-b border-white/5 text-xs sm:text-sm items-center hover:bg-white/[0.02] transition-colors">
            <div class="col-span-5 sm:col-span-4 font-bold text-white">Saturday 3PM Football</div>
            <div class="col-span-4 sm:col-span-4 font-black text-emerald-400">100% Unrestricted Feeds</div>
            <div class="col-span-3 sm:col-span-4 text-red-400 font-medium">{compSports3pm}</div>
          </div>

          <!-- Row 5: Verified Uptime -->
          <div class="grid grid-cols-12 p-4 sm:p-6 border-b border-white/5 text-xs sm:text-sm items-center hover:bg-white/[0.02] transition-colors">
            <div class="col-span-5 sm:col-span-4 font-bold text-white">Server Uptime SLA</div>
            <div class="col-span-4 sm:col-span-4 font-black text-emerald-400">99.9% Monitored</div>
            <div class="col-span-3 sm:col-span-4 text-gray-300">{compUptime}</div>
          </div>

          <!-- Row 6: Contract Commitment -->
          <div class="grid grid-cols-12 p-4 sm:p-6 border-b border-white/5 text-xs sm:text-sm items-center hover:bg-white/[0.02] transition-colors">
            <div class="col-span-5 sm:col-span-4 font-bold text-white">Contract Lock-in</div>
            <div class="col-span-4 sm:col-span-4 font-black text-emerald-400">0 Months (Cancel Anytime)</div>
            <div class="col-span-3 sm:col-span-4 text-gray-300">18 - 24 Months Lock-in</div>
          </div>

          <!-- Row 7: Support Response -->
          <div class="grid grid-cols-12 p-4 sm:p-6 border-b border-white/5 text-xs sm:text-sm items-center hover:bg-white/[0.02] transition-colors">
            <div class="col-span-5 sm:col-span-4 font-bold text-white">Support Response Time</div>
            <div class="col-span-4 sm:col-span-4 font-black text-emerald-400">WhatsApp Instant (&lt;60s)</div>
            <div class="col-span-3 sm:col-span-4 text-gray-300">{compSupport}</div>
          </div>

          <!-- Row 8: Refund Policy -->
          <div class="grid grid-cols-12 p-4 sm:p-6 text-xs sm:text-sm items-center hover:bg-white/[0.02] transition-colors">
            <div class="col-span-5 sm:col-span-4 font-bold text-white">Refund Protection</div>
            <div class="col-span-4 sm:col-span-4 font-black text-emerald-400">Strict 24-Hour Guarantee</div>
            <div class="col-span-3 sm:col-span-4 text-gray-400">No refunds or early termination penalty</div>
          </div>
        </div>

        <div class="mt-12 p-8 rounded-3xl bg-gradient-to-r from-blue-950/40 to-emerald-950/30 border border-white/10 text-center sm:text-left">
          <h3 class="text-xl sm:text-2xl font-black text-white mb-3">
            The Verdict: Why British IPTV Comes Out Ahead
          </h3>
          <p class="text-sm sm:text-base text-gray-300 leading-relaxed">
            While {competitorName} has brand awareness, British IPTV delivers higher stream stability, lower latency for live sports, true 60FPS 4K picture quality, and saves you hundreds of pounds each year without restrictive contracts.
          </p>
        </div>
      </div>
    </section>

    <Pricing />
    <UserReviewsSection />
    <FAQSection />
    <ContactForm />
  </main>

  <Footer />
</Layout>
