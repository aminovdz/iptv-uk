---
// src/pages/compare/index.astro
// Competitor Comparison Hub Page (/compare)
import Layout from '../../layouts/Layout.astro';
import StickyHeader from '../../components/StickyHeader.astro';
import Pricing from '../../components/Pricing.astro';
import UserReviewsSection from '../../components/UserReviewsSection.astro';
import FAQSection from '../../components/FAQSection.astro';
import ContactForm from '../../components/ContactForm.astro';
import Footer from '../../components/Footer.astro';
import { currentYear } from '../../utils/year';

const title = `IPTV Comparisons & Provider Reviews (${currentYear}) | British IPTV vs Competitors`;
const description = "Side-by-side comparison of British IPTV against top UK providers and legacy cable. Compare stream stability, 4K picture quality, pricing, and 3PM football access.";
const keywords = `iptv uk comparison, best iptv providers uk, compare iptv services, british iptv vs sky, iptv alternatives uk ${currentYear}`;

const comparisons = [
  {
    slug: 'greatiptv',
    name: 'Great IPTV',
    category: 'Alternative Provider',
    competitorPrice: '£59 - £75 / year',
    highlight: 'Save £12 to £28/year with superior 4K 60fps stability and <60s WhatsApp support.',
    badge: 'Popular Alternative'
  },
  {
    slug: 'wiztv',
    name: 'WizTV UK',
    category: 'Alternative Provider',
    competitorPrice: '£65 / year',
    highlight: 'Replace slow email ticket queues with instant WhatsApp setup and 99.9% monitored uptime.',
    badge: 'Uptime Comparison'
  },
  {
    slug: 'iptvuk-cloud',
    name: 'IPTV UK Cloud',
    category: 'Alternative Provider',
    competitorPrice: '£60 / year',
    highlight: 'Eliminate peak game buffering with British IPTV’s proprietary Anti-Freeze™ 9.0 edge cache.',
    badge: 'Anti-Freeze Tech'
  },
  {
    slug: 'premium-tv',
    name: 'Sky Glass & Satellite',
    category: 'Legacy Cable / Satellite',
    competitorPrice: '£85 - £110 / month',
    highlight: 'Cut the cord and save £973/year while gaining unrestricted Saturday 3PM match access.',
    badge: 'Save £973/Year'
  },
  {
    slug: 'bt-tv',
    name: 'BT TV (EE TV)',
    category: 'Legacy Cable',
    competitorPrice: '£76 / month',
    highlight: 'Ditch rigid 24-month contracts. Stream in 4K on Firestick, TV, and mobile for just £47/year.',
    badge: 'Zero Contracts'
  },
  {
    slug: 'virgin-media',
    name: 'Virgin Media TV',
    category: 'Legacy Cable',
    competitorPrice: '£82 / month',
    highlight: 'No bulky set-top boxes, coaxial cabling, or monthly equipment rental fees.',
    badge: 'Hardware-Free'
  }
];

const compareHubFaqs = [
  {
    question: "Why should I compare IPTV providers before subscribing?",
    answer: "Many budget IPTV services claim high channel counts but suffer from server collapse, heavy buffering during 3PM Saturday football matches, and non-existent customer support. British IPTV focuses on enterprise UK edge stability, true 60fps 4K feeds, and instant WhatsApp support."
  },
  {
    question: "How does British IPTV save UK households over £900 per year?",
    answer: "Traditional UK cable and satellite packages typically exceed £80 to £110 per month once HD, sports, and multi-room fees are added. British IPTV costs just £47 for a full 12-month pass with zero hardware rental costs."
  },
  {
    question: "Can I test British IPTV before switching from my current provider?",
    answer: "Yes, we provide a 100% free 24-hour test stream on WhatsApp with full 4K sports access so you can compare picture quality side-by-side with your existing setup."
  }
];
---

<Layout 
  title={title} 
  description={description} 
  keywords={keywords}
  type="article"
  faqs={compareHubFaqs}
>
  <StickyHeader />

  <main class="flex-grow pt-28 pb-20 bg-[#050814] text-gray-200">
    <!-- Hub Header -->
    <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center mb-16">
      <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-blue-500/10 border border-blue-500/20 text-blue-400 text-xs font-bold uppercase tracking-wider mb-4">
        <span>⚖️</span> Unbiased UK Streaming Comparisons
      </div>
      <h1 class="text-4xl sm:text-5xl lg:text-6xl font-black text-white tracking-tight leading-tight">
        British IPTV vs <br class="hidden sm:inline" />
        <span class="text-transparent bg-clip-text bg-gradient-to-r from-red-500 via-rose-300 to-blue-400">Competitors &amp; Cable TV</span>
      </h1>
      <p class="mt-4 text-base sm:text-lg text-gray-300 max-w-2xl mx-auto leading-relaxed">
        See how our 4K picture quality, Anti-Freeze™ 9.0 edge caching, 24-hour refund protection, and £47/year pricing compare directly to alternative providers and legacy TV packages.
      </p>

      <!-- Player & Stream Quality Benchmark Preview -->
      <div class="mt-8 max-w-4xl mx-auto rounded-3xl overflow-hidden border border-white/10 shadow-2xl shadow-blue-950/60 relative group">
        <img 
          src="/images/tivimate-premium-player.jpg" 
          alt="British IPTV premium player interface and electronic programme guide running on 4K Smart TV display"
          width="1280"
          height="720"
          loading="eager"
          decoding="async"
          class="w-full h-auto object-cover rounded-3xl transform transition-transform duration-500 group-hover:scale-[1.01]"
        />
      </div>
    </section>

    <!-- Comparison Cards Grid -->
    <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 mb-20">
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {comparisons.map((c) => (
          <div class="p-6 sm:p-8 rounded-3xl bg-[#090E1D] border border-white/10 hover:border-blue-500/40 transition-all flex flex-col justify-between shadow-xl group hover:-translate-y-1 duration-300">
            <div>
              <div class="flex items-center justify-between text-xs text-gray-400 mb-4">
                <span class="px-2.5 py-1 rounded-full bg-blue-500/10 border border-blue-500/20 text-blue-400 font-bold">
                  {c.badge}
                </span>
                <span class="text-red-400 font-medium">{c.competitorPrice}</span>
              </div>

              <h2 class="text-xl sm:text-2xl font-black text-white group-hover:text-blue-300 transition-colors mb-2">
                British IPTV vs {c.name}
              </h2>
              <p class="text-xs text-gray-500 uppercase tracking-wider font-bold mb-4">{c.category}</p>

              <p class="text-xs sm:text-sm text-gray-300 leading-relaxed mb-6">
                {c.highlight}
              </p>
            </div>

            <div class="pt-4 border-t border-white/5 flex items-center justify-between">
              <a 
                href={`/compare/iptv-uk-vs-${c.slug}/`}
                class="inline-flex items-center gap-1.5 text-xs font-bold text-blue-400 group-hover:text-white transition-colors"
              >
                <span>Read Side-by-Side Review &rarr;</span>
              </a>
              <span class="text-xs font-black text-emerald-400">Our Price: £47/Yr</span>
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- Master Feature Summary Matrix -->
    <section class="py-16 bg-[#070B17] border-y border-white/5 mb-20">
      <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center mb-10">
          <h2 class="text-2xl sm:text-3xl font-black text-white">Why Streamers Switch to British IPTV</h2>
          <p class="text-xs sm:text-sm text-gray-400 mt-2">Technical advantages verified across 1,485+ UK subscriber reviews.</p>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-3 gap-6 text-center">
          <div class="p-6 rounded-2xl bg-white/[0.03] border border-white/10">
            <span class="text-3xl font-black text-emerald-400 block mb-2">£47 / Year</span>
            <h3 class="text-sm font-bold text-white mb-1">Fixed Transparent Price</h3>
            <p class="text-xs text-gray-400">No mid-contract price hikes, setup fees, or cancellation penalties.</p>
          </div>
          <div class="p-6 rounded-2xl bg-white/[0.03] border border-white/10">
            <span class="text-3xl font-black text-blue-400 block mb-2">60 FPS 4K</span>
            <h3 class="text-sm font-bold text-white mb-1">True High Bitrate</h3>
            <p class="text-xs text-gray-400">Uncompressed sports motion clarity with zero pixelation or motion blur.</p>
          </div>
          <div class="p-6 rounded-2xl bg-white/[0.03] border border-white/10">
            <span class="text-3xl font-black text-purple-400 block mb-2">&lt; 60s</span>
            <h3 class="text-sm font-bold text-white mb-1">WhatsApp Live Support</h3>
            <p class="text-xs text-gray-400">Speak directly to technical engineers 24/7 with zero automated ticket queues.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- Pricing Section -->
    <Pricing />

    <!-- Reviews -->
    <UserReviewsSection />

    <!-- FAQs -->
    <FAQSection />

    <!-- Contact Form -->
    <ContactForm />
  </main>

  <Footer />
</Layout>
