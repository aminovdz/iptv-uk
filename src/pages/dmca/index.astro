---
// src/pages/dmca/index.astro
import Layout from '../../layouts/Layout.astro';
import StickyHeader from '../../components/StickyHeader.astro';
import Footer from '../../components/Footer.astro';

const title = "DMCA & Copyright Policy | British IPTV - Legal Notice & Takedown Procedure";
const description = "Review the official DMCA Copyright Notice and intellectual property compliance statement for British IPTV. Fast takedown procedure.";
---

<Layout title={title} description={description} type="article">
  <StickyHeader />

  <main class="flex-grow pt-28 pb-20 bg-[#050814] text-gray-200">
    <!-- Header -->
    <section class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center mb-12">
      <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-blue-500/10 border border-blue-500/20 text-blue-400 text-xs font-bold uppercase tracking-wider mb-4">
        ⚖️ Copyright Compliance
      </div>
      <h1 class="text-3xl sm:text-4xl lg:text-5xl font-black text-white tracking-tight">
        DMCA Notice &amp; Copyright Policy
      </h1>
      <p class="mt-4 text-sm sm:text-base text-gray-400 max-w-2xl mx-auto">
        British IPTV respects intellectual property rights and complies with the Digital Millennium Copyright Act (DMCA) and UK copyright directives.
      </p>
    </section>

    <!-- Content Box -->
    <section class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="p-8 sm:p-12 rounded-3xl bg-[#090E1D] border border-white/10 shadow-2xl space-y-8 text-sm sm:text-base text-gray-300 leading-relaxed">
        
        <div>
          <h2 class="text-xl sm:text-2xl font-bold text-white mb-3 flex items-center gap-2">
            <span class="text-blue-400">1.</span> Non-Hosting Declaration
          </h2>
          <p>
            <strong>British IPTV does not host, upload, store, or transmit any video, audio, or media files on its servers.</strong> We operate solely as an indexing directory and digital middleware service providing technical connection protocols (M3U / Xtream API) to third-party streaming servers located worldwide.
          </p>
        </div>

        <div class="pt-6 border-t border-white/5">
          <h2 class="text-xl sm:text-2xl font-bold text-white mb-3 flex items-center gap-2">
            <span class="text-blue-400">2.</span> Intellectual Property &amp; Trademark Respect
          </h2>
          <p>
            All product names, brand trademarks, broadcast channels, and sports logos referenced on this website remain the sole property of their respective trademark holders. Reference to third-party terms on this site is strictly for nominative identification, hardware compatibility, and fair educational review.
          </p>
        </div>

        <div class="pt-6 border-t border-white/5">
          <h2 class="text-xl sm:text-2xl font-bold text-white mb-3 flex items-center gap-2">
            <span class="text-blue-400">3.</span> Notice and Takedown Procedure
          </h2>
          <p class="mb-3">
            If you are a copyright owner or an authorized agent thereof and believe that any stream URL or media index listed infringes upon your copyright, you may submit a formal notification to our designated compliance agent containing:
          </p>
          <ul class="list-disc pl-5 space-y-2 text-gray-300">
            <li>A physical or electronic signature of a person authorized to act on behalf of the owner of the copyright interest.</li>
            <li>Identification of the copyrighted work claimed to have been infringed.</li>
            <li>Identification of the specific stream link, URL, or index reference to be disabled or removed.</li>
            <li>Information reasonably sufficient to permit us to contact you, such as an address, telephone number, and valid corporate email address.</li>
            <li>A statement that you have a good faith belief that the disputed use is not authorized by the copyright owner, its agent, or the law.</li>
            <li>A statement, made under penalty of perjury, that the information in your notice is accurate and that you are authorized to act on behalf of the owner.</li>
          </ul>
        </div>

        <div class="pt-6 border-t border-white/5">
          <h2 class="text-xl sm:text-2xl font-bold text-white mb-3 flex items-center gap-2">
            <span class="text-blue-400">4.</span> Rapid Remediation Timeframe
          </h2>
          <p>
            Upon receipt of a valid and complete DMCA or copyright notice, our engineering team will investigate and delist the offending link from our directory within <strong>24 to 48 business hours</strong>.
          </p>
        </div>

        <div class="pt-6 border-t border-white/5 bg-white/[0.02] p-6 rounded-2xl border border-white/5">
          <h3 class="text-lg font-bold text-white mb-2">Designated Copyright Agent</h3>
          <p class="text-xs text-gray-400 leading-relaxed">
            Please submit all formal notices electronically to ensure swift routing:<br />
            <strong>Compliance Department — British IPTV</strong><br />
            123 Westminster Bridge Rd, London, SE1 7HR, United Kingdom<br />
            Email: <a href="mailto:support@castvera.com" class="text-blue-400 font-mono">support@castvera.com</a> (CC: <a href="mailto:contact@britishiptv.pro" class="text-blue-400 font-mono">contact@britishiptv.pro</a>)
          </p>
        </div>

      </div>
    </section>
  </main>

  <Footer />
</Layout>
