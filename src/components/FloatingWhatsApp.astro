---
// src/components/FloatingWhatsApp.astro
// High-converting floating WhatsApp support widget with live online status badge and speech bubble
---

<div class="fixed bottom-6 right-6 z-[95] flex items-end flex-col pointer-events-none select-none">
  <!-- Interactive Chat Bubble Tooltip (shows on load with smooth fade) -->
  <div 
    id="whatsapp-bubble" 
    class="pointer-events-auto mb-3 max-w-xs rounded-2xl bg-[#0F172A]/95 border border-white/10 p-3.5 shadow-2xl backdrop-blur-md transition-all duration-300 transform translate-y-2 opacity-0 flex items-start gap-3 relative"
  >
    <button 
      id="whatsapp-bubble-close"
      type="button" 
      class="absolute top-2 right-2 text-gray-400 hover:text-white text-xs p-1"
      aria-label="Dismiss chat tooltip"
    >
      &times;
    </button>
    <div class="w-8 h-8 rounded-full bg-[#25D366]/20 text-[#25D366] flex items-center justify-center flex-shrink-0 mt-0.5">
      <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
        <path d="M12 2C6.48 2 2 6.48 2 12c0 1.85.5 3.58 1.38 5.07L2 22l5.07-1.34C8.53 21.52 10.22 22 12 22c5.52 0 10-4.48 10-10S17.52 2 12 2z"/>
      </svg>
    </div>
    <div class="pr-3">
      <div class="flex items-center gap-1.5 text-[11px] font-bold text-emerald-400 mb-0.5">
        <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 animate-ping"></span>
        <span>Support Online • Replying in &lt;1m</span>
      </div>
      <p class="text-xs text-gray-200 font-medium leading-snug">
        Need help choosing a plan or setting up your Firestick? Message us!
      </p>
    </div>
  </div>

  <!-- Main Floating Action Button -->
  <a 
    href="https://wa.me/213550592200?text=Hello%20British%20IPTV!%20I%20have%20a%20question%20about%20your%20subscription%20and%20instant%20setup." 
    target="_blank" 
    rel="noopener noreferrer" 
    class="pointer-events-auto relative flex items-center justify-center w-14 h-14 sm:w-16 sm:h-16 rounded-full bg-[#25D366] text-white shadow-2xl shadow-emerald-500/30 hover:scale-105 active:scale-95 transition-all duration-300 group"
    aria-label="Chat with British IPTV live support on WhatsApp"
  >
    <!-- Ping Radar Badge -->
    <span class="absolute -top-1 -right-1 flex h-4 w-4">
      <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-red-400 opacity-75"></span>
      <span class="relative inline-flex rounded-full h-4 w-4 bg-red-500 text-[9px] font-black text-white items-center justify-center border-2 border-[#050814]">1</span>
    </span>

    <!-- WhatsApp SVG Icon -->
    <svg class="w-8 h-8 sm:w-9 sm:h-9" fill="currentColor" viewBox="0 0 24 24">
      <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L0 24l6.335-1.662c1.72.94 3.659 1.437 5.63 1.438h.004c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
    </svg>
  </a>
</div>

<script>
  function initWhatsAppWidget() {
    const bubble = document.getElementById('whatsapp-bubble');
    const closeBtn = document.getElementById('whatsapp-bubble-close');
    if (!bubble) return;

    // Show speech bubble after 3 seconds
    const timer = setTimeout(() => {
      const dismissed = sessionStorage.getItem('whatsapp_bubble_dismissed');
      if (!dismissed) {
        bubble.classList.remove('opacity-0', 'translate-y-2');
        bubble.classList.add('opacity-100', 'translate-y-0');
      }
    }, 3000);

    closeBtn?.addEventListener('click', (e) => {
      e.stopPropagation();
      clearTimeout(timer);
      bubble.classList.remove('opacity-100', 'translate-y-0');
      bubble.classList.add('opacity-0', 'translate-y-2');
      sessionStorage.setItem('whatsapp_bubble_dismissed', 'true');
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initWhatsAppWidget);
  } else {
    initWhatsAppWidget();
  }
</script>
