---
// src/components/StickyHeader.astro
import { Activity, MessageCircle, Menu, X, ArrowRight, ShieldCheck } from 'lucide-astro';
---

<header class="sticky top-0 z-50 w-full bg-[#00102e]/90 backdrop-blur-md border-b border-blue-900/50 text-white transition-all duration-300">
  <!-- Top Micro Announcement Bar -->
  <div class="bg-gradient-to-r from-[#012169] via-[#00102e] to-[#C8102E] py-1.5 px-4 text-xs font-semibold text-center border-b border-white/5">
    <div class="max-w-7xl mx-auto flex items-center justify-between">
      <div class="hidden sm:flex items-center gap-2 text-blue-200">
        <span class="inline-flex items-center gap-1.5 text-emerald-400 font-bold">
          <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
          UK Server Cluster: 99.9% Uptime
        </span>
        <span class="text-white/20">|</span>
        <span>Anti-Freeze™ 9.0 Active</span>
      </div>
      <div class="mx-auto sm:mx-0 flex items-center gap-3">
        <span class="text-white/90">🇬🇧 Premier League & Saturday 3PM Matches Live in 4K</span>
        <a href="https://wa.me/213550592200?text=Hello+I+want+to+claim+a+free+trial" class="text-amber-300 hover:text-white underline font-bold transition-colors">
          Claim 24h Free Trial &rarr;
        </a>
      </div>
      <div class="hidden md:flex items-center gap-3 text-blue-300">
        <a href="https://t.me/castvera_com" target="_blank" rel="noopener noreferrer" class="hover:text-white transition-colors">Telegram VIP</a>
        <span class="text-white/20">|</span>
        <a href="https://whatsapp.com/channel/0029VayVaLpD8SE3bf8wMY3v" target="_blank" rel="noopener noreferrer" class="hover:text-white transition-colors">WhatsApp Channel</a>
      </div>
    </div>
  </div>

  <!-- Main Navigation Bar -->
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-18 flex items-center justify-between">
    <!-- Brand Logo -->
    <a href="/" class="flex items-center gap-3 group focus:outline-none" aria-label="British IPTV Homepage">
      <div class="w-10 h-10 rounded-xl bg-gradient-to-br from-[#C8102E] to-[#8c081c] flex items-center justify-center text-white font-black text-lg shadow-lg shadow-red-900/40 group-hover:scale-105 transition-transform border border-red-500/30">
        UK
      </div>
      <div class="flex flex-col">
        <span class="text-xl sm:text-2xl font-black tracking-tight text-white group-hover:text-red-400 transition-colors leading-none">
          British<span class="text-red-500">IPTV</span>
        </span>
        <span class="text-[10px] font-bold uppercase tracking-widest text-blue-300 mt-1">
          #1 Premium 4K UK Service
        </span>
      </div>
    </a>

    <!-- Desktop Navigation Links -->
    <nav class="hidden lg:flex items-center gap-7 text-sm font-bold text-gray-200">
      <a href="/" class="hover:text-white transition-colors py-1">Home</a>
      <a href="/#pricing" class="hover:text-white transition-colors py-1">Pricing Tiers</a>
      <a href="/livescore" class="hover:text-red-400 transition-colors py-1 flex items-center gap-1.5 text-red-400">
        <span class="w-2 h-2 rounded-full bg-red-500 animate-pulse"></span>
        Match Center
      </a>
      <a href="/#features" class="hover:text-white transition-colors py-1">Features</a>
      <a href="/#devices" class="hover:text-white transition-colors py-1">Devices</a>
      <a href="/guides" class="hover:text-white transition-colors py-1">Setup Guides</a>
      <a href="/#faq" class="hover:text-white transition-colors py-1">FAQ</a>
    </nav>

    <!-- Header Action Buttons -->
    <div class="hidden sm:flex items-center gap-3">
      <a 
        href="https://wa.me/213550592200?text=Hello+I+would+like+a+free+24h+trial" 
        target="_blank" 
        rel="noopener noreferrer"
        class="inline-flex items-center gap-1.5 px-4 py-2 rounded-full text-xs font-extrabold bg-white/5 hover:bg-white/10 text-blue-200 border border-white/10 hover:border-white/20 transition-all"
      >
        <MessageCircle class="w-3.5 h-3.5 text-[#25D366]" />
        <span>Free Trial</span>
      </a>

      <a 
        href="/#pricing" 
        class="inline-flex items-center gap-2 px-5 py-2.5 rounded-full text-xs sm:text-sm font-extrabold bg-[#C8102E] hover:bg-red-700 text-white shadow-lg shadow-red-900/40 hover:shadow-red-900/60 transition-all transform hover:-translate-y-0.5"
      >
        <span>Get UK Pass</span>
        <ArrowRight class="w-4 h-4" />
      </a>
    </div>

    <!-- Mobile Hamburger Button -->
    <button 
      id="mobile-menu-btn" 
      class="lg:hidden p-2 rounded-xl bg-white/5 hover:bg-white/10 text-white transition-colors"
      aria-label="Toggle Navigation Menu"
    >
      <Menu class="w-6 h-6" id="menu-icon-open" />
      <X class="w-6 h-6 hidden" id="menu-icon-close" />
    </button>
  </div>

  <!-- Mobile Dropdown Menu -->
  <div id="mobile-menu" class="hidden lg:hidden bg-[#00102e] border-b border-blue-900/60 px-4 pt-3 pb-6">
    <nav class="flex flex-col gap-3 text-base font-bold text-gray-200">
      <a href="/" class="hover:text-white transition-colors py-2 border-b border-white/5">Home</a>
      <a href="/#pricing" class="hover:text-white transition-colors py-2 border-b border-white/5">Subscription Pricing</a>
      <a href="/livescore" class="text-red-400 font-extrabold py-2 border-b border-white/5 flex items-center gap-2">
        <span class="w-2 h-2 rounded-full bg-red-500 animate-pulse"></span>
        Live Match Center
      </a>
      <a href="/#features" class="hover:text-white transition-colors py-2 border-b border-white/5">Anti-Freeze™ Features</a>
      <a href="/#devices" class="hover:text-white transition-colors py-2 border-b border-white/5">Supported Devices (Firestick & Smart TV)</a>
      <a href="/guides" class="hover:text-white transition-colors py-2 border-b border-white/5">Installation Guides</a>
      <a href="/#faq" class="hover:text-white transition-colors py-2 border-b border-white/5">Frequently Asked Questions</a>
      <a href="/contact" class="hover:text-white transition-colors py-2 border-b border-white/5">Contact Support</a>
      
      <div class="pt-4 flex flex-col gap-3">
        <a 
          href="https://wa.me/213550592200?text=Hello+I+would+like+a+free+24h+trial" 
          class="w-full text-center py-3 rounded-full font-extrabold text-sm bg-white/10 text-white border border-white/15"
        >
          Request 24H WhatsApp Trial
        </a>
        <a 
          href="/#pricing" 
          class="w-full text-center py-3 rounded-full font-extrabold text-sm bg-[#C8102E] text-white shadow-xl"
        >
          View Plans from £7
        </a>
      </div>
    </nav>
  </div>
</header>

<script>
  const btn = document.getElementById('mobile-menu-btn');
  const menu = document.getElementById('mobile-menu');
  const iconOpen = document.getElementById('menu-icon-open');
  const iconClose = document.getElementById('menu-icon-close');

  btn?.addEventListener('click', () => {
    const isHidden = menu?.classList.toggle('hidden');
    iconOpen?.classList.toggle('hidden');
    iconClose?.classList.toggle('hidden');
  });

  // Close mobile menu when clicking any link
  menu?.querySelectorAll('a').forEach(link => {
    link.addEventListener('click', () => {
      menu.classList.add('hidden');
      iconOpen?.classList.remove('hidden');
      iconClose?.classList.add('hidden');
    });
  });
</script>
