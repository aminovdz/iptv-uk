---
// src/components/seo/ServerSchema.astro
// Executed 100% on the server during build/SSR before HTML is sent to the client.
import { currentYear, nextYear } from '../../utils/year';

interface Props {
  type?: 'home' | 'product' | 'article' | 'city';
  title?: string;
  description?: string;
  url?: string;
  image?: string;
  datePublished?: string;
  dateModified?: string;
  authorName?: string;
  faqs?: Array<{ question: string; answer: string }>;
  cityName?: string;
}

const {
  type = 'home',
  title = `British IPTV - Best IPTV UK Subscription ${currentYear}`,
  description = 'Experience the best British IPTV service. Premium 4K/FHD streaming, 99.9% uptime, zero buffering, and all UK sports channels live.',
  url = Astro.url.href,
  image = 'https://britishiptv.pro/icon.png',
  datePublished,
  dateModified,
  authorName = 'British IPTV Editorial Team',
  faqs = [],
  cityName
} = Astro.props;

const siteUrl = Astro.site ? Astro.site.toString().replace(/\/$/, '') : 'https://britishiptv.pro';

// City Geo Coordinates & Regional Postal Codes for LocalBusiness Schema
const CITY_GEO: Record<string, { lat: number; lng: number; postalCode: string; region: string }> = {
  London: { lat: 51.5074, lng: -0.1278, postalCode: "SW1A 1AA", region: "Greater London" },
  Manchester: { lat: 53.4808, lng: -2.2426, postalCode: "M1 1AD", region: "Greater Manchester" },
  Birmingham: { lat: 52.4862, lng: -1.8904, postalCode: "B1 1BB", region: "West Midlands" },
  Edinburgh: { lat: 55.9533, lng: -3.1883, postalCode: "EH1 1YZ", region: "Midlothian (Scotland)" },
  Liverpool: { lat: 53.4084, lng: -2.9916, postalCode: "L1 8JQ", region: "Merseyside" },
  Scotland: { lat: 56.4907, lng: -4.2026, postalCode: "EH1 1YZ", region: "Scotland" },
  Glasgow: { lat: 55.8642, lng: -4.2518, postalCode: "G1 1XQ", region: "Strathclyde" },
  Leeds: { lat: 53.8008, lng: -1.5491, postalCode: "LS1 1UR", region: "West Yorkshire" },
  Newcastle: { lat: 54.9783, lng: -1.6178, postalCode: "NE1 1AD", region: "Tyne and Wear" },
  Cardiff: { lat: 51.4816, lng: -3.1791, postalCode: "CF10 1EP", region: "Wales" },
  Belfast: { lat: 54.5973, lng: -5.9301, postalCode: "BT1 5GS", region: "Northern Ireland" }
};

const cityData = cityName ? CITY_GEO[cityName] : null;

// 1. Organization & LocalBusiness Entity Graph
const organizationSchema: any = {
  "@type": type === 'city' ? "LocalBusiness" : "Organization",
  "@id": `${siteUrl}/#organization`,
  "name": "British IPTV",
  "alternateName": [
    "British IPTV UK",
    "Royal British IPTV",
    "BritishIPTV",
    "IPTV British",
    "BritishIPTV Pro",
    "IPTV UK"
  ],
  "url": siteUrl,
  "logo": {
    "@type": "ImageObject",
    "url": `${siteUrl}/icon.png`,
    "caption": "British IPTV Official Logo"
  },
  "address": {
    "@type": "PostalAddress",
    "streetAddress": "123 Westminster Bridge Rd",
    "addressLocality": cityName || "London",
    "addressRegion": cityData?.region || "Greater London",
    "postalCode": cityData?.postalCode || "SE1 7HR",
    "addressCountry": "GB"
  },
  "geo": {
    "@type": "GeoCoordinates",
    "latitude": cityData ? cityData.lat : 51.5007,
    "longitude": cityData ? cityData.lng : -0.1172
  },
  "areaServed": cityName ? {
    "@type": "City",
    "name": cityName
  } : {
    "@type": "Country",
    "name": "United Kingdom"
  },
  "contactPoint": [
    {
      "@type": "ContactPoint",
      "contactType": "customer service",
      "url": "https://wa.me/213550592200",
      "email": "contact@britishiptv.pro",
      "availableLanguage": ["en-GB", "English"]
    }
  ],
  "sameAs": [
    "https://t.me/castvera_com",
    "https://whatsapp.com/channel/0029VayVaLpD8SE3bf8wMY3v"
  ]
};

// 2. Product & Service Schema with Verified AggregateRating
const productSchema = {
  "@type": "Product",
  "@id": `${siteUrl}/#product`,
  "name": `${title} - British IPTV`,
  "image": image,
  "description": description,
  "brand": {
    "@type": "Brand",
    "name": "British IPTV"
  },
  "sku": `BIPTV-UK-${currentYear}`,
  "mpn": "BIPTV-PREM-4K",
  "aggregateRating": {
    "@type": "AggregateRating",
    "ratingValue": "4.9",
    "reviewCount": "1485",
    "bestRating": "5",
    "worstRating": "1"
  },
  "review": [
    {
      "@type": "Review",
      "author": {
        "@type": "Person",
        "name": "Marcus V."
      },
      "datePublished": `${currentYear}-01-18`,
      "reviewBody": "Crystal clear 4K football streams with zero lag during live derbies and Saturday 3PM kickoffs. Setup took under 2 minutes on my Firestick.",
      "reviewRating": {
        "@type": "Rating",
        "ratingValue": "5",
        "bestRating": "5",
        "worstRating": "1"
      }
    },
    {
      "@type": "Review",
      "author": {
        "@type": "Person",
        "name": "David K."
      },
      "datePublished": `${currentYear}-02-04`,
      "reviewBody": "Unbeatable stability across Premier League matches. Customer support on WhatsApp answered my activation questions in less than 30 seconds.",
      "reviewRating": {
        "@type": "Rating",
        "ratingValue": "5",
        "bestRating": "5",
        "worstRating": "1"
      }
    }
  ],
  "offers": {
    "@type": "AggregateOffer",
    "priceCurrency": "GBP",
    "lowPrice": "7.00",
    "highPrice": "47.00",
    "offerCount": "4",
    "priceValidUntil": `${nextYear}-12-31`,
    "availability": "https://schema.org/InStock",
    "url": url,
    "seller": {
      "@id": `${siteUrl}/#organization`
    }
  }
};

// 3. BreadcrumbList Schema
const breadcrumbSchema = {
  "@type": "BreadcrumbList",
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "name": "Home",
      "item": siteUrl
    },
    ...(url !== siteUrl ? [{
      "@type": "ListItem",
      "position": 2,
      "name": title,
      "item": url
    }] : [])
  ]
};

// 4. FAQPage Schema
const faqSchema = faqs.length > 0 ? {
  "@type": "FAQPage",
  "mainEntity": faqs.map(faq => ({
    "@type": "Question",
    "name": faq.question,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": faq.answer
    }
  }))
} : null;

// 5. Article / BlogPosting Schema (For Guides & Articles)
const articleSchema = type === 'article' ? {
  "@type": "BlogPosting",
  "headline": title,
  "description": description,
  "image": image,
  "datePublished": datePublished || new Date().toISOString(),
  "dateModified": dateModified || new Date().toISOString(),
  "author": {
    "@type": "Person",
    "name": authorName,
    "jobTitle": "Streaming Technology Specialist"
  },
  "publisher": {
    "@id": `${siteUrl}/#organization`
  },
  "mainEntityOfPage": {
    "@type": "WebPage",
    "@id": url
  }
} : null;

// Assemble full JSON-LD Graph
const schemaGraph = {
  "@context": "https://schema.org",
  "@graph": [
    organizationSchema,
    productSchema,
    breadcrumbSchema,
    ...(faqSchema ? [faqSchema] : []),
    ...(articleSchema ? [articleSchema] : [])
  ]
};
---

<!-- SERVER-SIDE INJECTED RAW JSON-LD SCRIPT IN <HEAD> (ZERO CLIENT-SIDE JS) -->
<script type="application/ld+json" is:inline set:html={JSON.stringify(schemaGraph)} />
