---
// src/components/Footer.astro
import { MapPin, Mail, MessageCircle, Send, ShieldCheck, Heart } from 'lucide-astro';
---

<footer class="bg-[#000d26] text-blue-200 border-t border-blue-900/60 pt-16 pb-12">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Top 4-Column Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-5 gap-10 mb-14">
      
      <!-- Column 1: Brand Info & Social Communities -->
      <div class="lg:col-span-2">
        <div class="flex items-center gap-3 mb-4">
          <div class="w-9 h-9 rounded-xl bg-gradient-to-br from-[#C8102E] to-[#8c081c] flex items-center justify-center text-white font-black text-base shadow-md border border-red-500/30">
            UK
          </div>
          <span class="text-2xl font-black tracking-tight text-white">
            British<span class="text-red-500">IPTV</span>
          </span>
        </div>
        
        <p class="text-sm text-gray-300 leading-relaxed mb-6 max-w-sm">
          The United Kingdom's leading premium 4K streaming service. Engineered with Anti-Freeze&trade; infrastructure for sports, cinema, and live UK television without satellite or cable contracts.
        </p>

        <!-- Official Communities -->
        <div class="flex flex-wrap items-center gap-3 mb-6">
          <a 
            href="https://wa.me/213550592200" 
            target="_blank" 
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full text-xs font-bold bg-[#25D366]/15 text-[#25D366] border border-[#25D366]/30 hover:bg-[#25D366] hover:text-white transition-all"
          >
            <MessageCircle class="w-3.5 h-3.5" />
            WhatsApp Support
          </a>

          <a 
            href="https://whatsapp.com/channel/0029VayVaLpD8SE3bf8wMY3v" 
            target="_blank" 
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full text-xs font-bold bg-white/5 text-blue-200 border border-white/10 hover:bg-white/10 transition-all"
          >
            WhatsApp Channel
          </a>

          <a 
            href="https://t.me/castvera_com" 
            target="_blank" 
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full text-xs font-bold bg-[#0088cc]/15 text-[#38bdf8] border border-[#0088cc]/30 hover:bg-[#0088cc] hover:text-white transition-all"
          >
            <Send class="w-3.5 h-3.5" />
            Telegram VIP
          </a>
        </div>

        <!-- Contact Emails -->
        <div class="space-y-1.5 text-xs text-gray-400">
          <div class="flex items-center gap-2">
            <Mail class="w-3.5 h-3.5 text-red-400 flex-shrink-0" />
            <span>Support: <a href="mailto:support@castvera.com" class="text-gray-200 hover:text-white underline">support@castvera.com</a></span>
          </div>
          <div class="flex items-center gap-2">
            <Mail class="w-3.5 h-3.5 text-red-400 flex-shrink-0" />
            <span>General: <a href="mailto:contact@britishiptv.pro" class="text-gray-200 hover:text-white underline">contact@britishiptv.pro</a></span>
          </div>
        </div>
      </div>

      <!-- Column 2: Navigation & Quick Links -->
      <div>
        <h4 class="text-sm font-black text-white uppercase tracking-wider mb-4">Quick Links</h4>
        <ul class="space-y-2.5 text-xs font-medium">
          <li><a href="/" class="hover:text-white transition-colors">Home</a></li>
          <li><a href="/#pricing" class="hover:text-white transition-colors">Pricing Tiers (from &pound;7)</a></li>
          <li>
            <a href="/livescore" class="text-red-400 font-bold hover:text-red-300 transition-colors flex items-center gap-1.5">
              <span class="w-1.5 h-1.5 rounded-full bg-red-500 animate-pulse"></span>
              Live Match Center
            </a>
          </li>
          <li><a href="/#features" class="hover:text-white transition-colors">Anti-Freeze™ Features</a></li>
          <li><a href="/#devices" class="hover:text-white transition-colors">Compatible Devices</a></li>
          <li><a href="/guides" class="hover:text-white transition-colors">Tutorials &amp; Guides</a></li>
          <li><a href="/#faq" class="hover:text-white transition-colors">Frequently Asked Questions</a></li>
        </ul>
      </div>

      <!-- Column 3: High-Intent Keyword Hubs -->
      <div>
        <h4 class="text-sm font-black text-white uppercase tracking-wider mb-4">Streaming Hubs</h4>
        <ul class="space-y-2.5 text-xs font-medium">
          <li><a href="/iptv-subscription-uk" class="hover:text-white transition-colors">UK IPTV Subscription</a></li>
          <li><a href="/best-iptv-providers-uk" class="hover:text-white transition-colors">Best IPTV Providers UK</a></li>
          <li><a href="/iptv-firestick-uk" class="hover:text-white transition-colors">Firestick Setup Hub</a></li>
          <li><a href="/free-iptv-trial-uk" class="hover:text-white transition-colors">24-Hour Free Trial</a></li>
          <li><a href="/watch-premier-league-iptv-uk" class="hover:text-white transition-colors">Watch Premier League (3PM)</a></li>
          <li><a href="/compare/iptv-uk-vs-premium-tv" class="hover:text-white transition-colors">Compare vs Cable</a></li>
          <li><a href="/referral" class="text-amber-300 hover:text-white font-bold transition-colors">Refer a Friend (Free Month)</a></li>
        </ul>
      </div>

      <!-- Column 4: UK Locations & Legal Pages -->
      <div>
        <h4 class="text-sm font-black text-white uppercase tracking-wider mb-4">Locations &amp; Trust</h4>
        <div class="mb-4">
          <span class="text-[11px] font-bold uppercase tracking-wider text-gray-400 block mb-2">UK Cities</span>
          <ul class="space-y-1.5 text-xs font-medium">
            <li><a href="/locations/london" class="hover:text-white transition-colors">London</a></li>
            <li><a href="/locations/birmingham" class="hover:text-white transition-colors">Birmingham</a></li>
            <li><a href="/locations/manchester" class="hover:text-white transition-colors">Manchester</a></li>
            <li><a href="/locations/edinburgh" class="hover:text-white transition-colors">Edinburgh</a></li>
            <li><a href="/locations/liverpool" class="hover:text-white transition-colors">Liverpool</a></li>
          </ul>
        </div>
        <div>
          <span class="text-[11px] font-bold uppercase tracking-wider text-gray-400 block mb-2">Legal Compliance</span>
          <ul class="space-y-1.5 text-xs font-medium">
            <li><a href="/privacy" class="hover:text-white transition-colors">Privacy Policy</a></li>
            <li><a href="/terms" class="hover:text-white transition-colors">Terms of Service</a></li>
            <li><a href="/refund" class="hover:text-white transition-colors">24-Hour Refund Policy</a></li>
            <li><a href="/dmca" class="hover:text-white transition-colors">DMCA Notice</a></li>
            <li><a href="/disclaimer" class="hover:text-white transition-colors">Disclaimer</a></li>
            <li><a href="/contact" class="hover:text-white transition-colors">Contact Us</a></li>
          </ul>
        </div>
      </div>

    </div>

    <!-- Flame Map Embed (Required for Local SEO & E-E-A-T Signals) -->
    <div class="mb-12">
      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 mb-4">
        <div class="flex items-center gap-2 text-xs font-bold text-gray-300">
          <MapPin class="w-4 h-4 text-red-500" />
          <span>UK Headquarters: 123 Westminster Bridge Rd, London, SE1 7HR, United Kingdom</span>
        </div>
        <span class="text-[11px] font-semibold text-blue-300/70">
          Local London & UK Edge CDN Nodes
        </span>
      </div>

      <div class="w-full rounded-2xl overflow-hidden border border-blue-900/60 shadow-2xl relative" style="height: 260px;">
        <!-- Inverted dark filter map overlay to seamlessly match website theme -->
        <iframe 
          title="British IPTV London Headquarters Location"
          src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d2483.670221345672!2d-0.1194389!3d51.5007413!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x487604b900d26973%3A0x89dc8c6eb5c1a70!2sWestminster%20Bridge%20Rd%2C%20London%2C%20UK!5e0!3m2!1sen!2suk!4v1718131331776!5m2!1sen!2suk" 
          width="100%" 
          height="100%" 
          style="border:0; filter: invert(90%) hue-rotate(180deg) contrast(90%);" 
          allowfullscreen="" 
          loading="lazy" 
          referrerpolicy="no-referrer-when-downgrade"
        ></iframe>
      </div>
    </div>

    <!-- Bottom Legal Disclaimers & Copyright -->
    <div class="pt-8 border-t border-blue-900/60 text-center text-xs text-blue-300/60 space-y-3">
      <p class="max-w-4xl mx-auto leading-relaxed">
        Disclaimer: British IPTV is an independent streaming and technology review platform. We do not broadcast, host, control, or transmit any media streams. All product names, logos, and brands are property of their respective owners. Content on this site is provided for educational and informational purposes only.
      </p>
      <div class="flex flex-wrap items-center justify-center gap-4 text-gray-400 text-[11px]">
        <span>&copy; {new Date().getFullYear()} British IPTV. All rights reserved.</span>
        <span>•</span>
        <span>Engineered with Astro &amp; Tailwind CSS</span>
        <span>•</span>
        <span>Cloudflare Global Edge Network</span>
      </div>
    </div>

  </div>
</footer>
