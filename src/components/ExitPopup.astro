---
// src/components/ExitPopup.astro
// Exit-intent conversion popup with 24-hour frequency capping via localStorage
---

<div 
  id="exit-popup" 
  class="fixed inset-0 z-[100] hidden items-center justify-center p-4 bg-black/80 backdrop-blur-md transition-opacity duration-300 opacity-0"
  aria-modal="true" 
  role="dialog"
  aria-labelledby="exit-popup-title"
>
  <div 
    id="exit-popup-card" 
    class="relative w-full max-w-lg rounded-3xl bg-[#0B0F19] border border-red-500/30 p-6 sm:p-8 shadow-2xl text-center transform scale-95 transition-all duration-300 overflow-hidden"
  >
    <!-- Background atmospheric glows -->
    <div class="absolute -top-24 -left-24 w-60 h-60 bg-red-600/20 blur-3xl rounded-full pointer-events-none"></div>
    <div class="absolute -bottom-24 -right-24 w-60 h-60 bg-blue-600/20 blur-3xl rounded-full pointer-events-none"></div>

    <!-- Close button -->
    <button 
      id="exit-popup-close" 
      type="button" 
      class="absolute top-4 right-4 text-gray-400 hover:text-white p-2 rounded-full hover:bg-white/10 transition-colors z-20"
      aria-label="Close offer"
    >
      <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
      </svg>
    </button>

    <!-- Urgency pill -->
    <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-red-500/10 border border-red-500/30 text-red-400 text-xs font-black uppercase tracking-wider mb-4">
      <span class="w-2 h-2 rounded-full bg-red-500 animate-ping"></span>
      Exclusive Exit Offer • Today Only
    </div>

    <!-- Title & Value proposition -->
    <h3 id="exit-popup-title" class="text-2xl sm:text-3xl font-black text-white leading-tight">
      WAIT! Claim <span class="text-red-500">+1 Month Free</span> On Any 12-Month Plan
    </h3>

    <p class="mt-3 text-sm text-gray-300 leading-relaxed">
      Order now and get <strong class="text-white">13 Months for the price of 12 (£47)</strong>, plus free Firestick / Smart TV remote setup on WhatsApp.
    </p>

    <!-- Feature checkmarks -->
    <div class="mt-5 space-y-2 text-left bg-white/[0.02] border border-white/5 rounded-2xl p-3.5 text-xs text-gray-300">
      <div class="flex items-center gap-2">
        <svg class="w-4 h-4 text-emerald-400 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
          <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/>
        </svg>
        <span>Instant WhatsApp Activation within 60 seconds</span>
      </div>
      <div class="flex items-center gap-2">
        <svg class="w-4 h-4 text-emerald-400 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
          <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/>
        </svg>
        <span>True 4K UHD & 60fps Anti-Freeze™ Streams</span>
      </div>
      <div class="flex items-center gap-2">
        <svg class="w-4 h-4 text-emerald-400 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
          <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/>
        </svg>
        <span>100% Risk-Free 24-Hour Money-Back Guarantee</span>
      </div>
    </div>

    <!-- CTA Button -->
    <div class="mt-6 space-y-3">
      <a 
        id="exit-popup-cta"
        href="https://wa.me/213550592200?text=Hello%20British%20IPTV!%20I%20am%20claiming%20the%201%20Month%20Free%20bonus%20offer%20from%20the%20website%20(13%20Months%20for%20£47)." 
        target="_blank" 
        rel="noopener noreferrer"
        class="flex items-center justify-center gap-2 w-full py-3.5 px-6 rounded-xl bg-[#25D366] text-black font-black text-sm sm:text-base hover:bg-[#1fb355] transition-all shadow-xl hover:shadow-emerald-500/20"
      >
        <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
          <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L0 24l6.335-1.662c1.72.94 3.659 1.437 5.63 1.438h.004c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
        </svg>
        Claim 1 Month Free on WhatsApp &rarr;
      </a>

      <button 
        id="exit-popup-dismiss-text"
        type="button" 
        class="text-xs text-gray-500 hover:text-gray-300 transition-colors block mx-auto py-1"
      >
        No thanks, I will pay full price later
      </button>
    </div>
  </div>
</div>

<script>
  function initExitPopup() {
    const STORAGE_KEY = 'british_iptv_exit_popup_last_shown';
    const ONE_DAY_MS = 24 * 60 * 60 * 1000;

    const popup = document.getElementById('exit-popup');
    const card = document.getElementById('exit-popup-card');
    const closeBtn = document.getElementById('exit-popup-close');
    const dismissBtn = document.getElementById('exit-popup-dismiss-text');
    const ctaBtn = document.getElementById('exit-popup-cta');

    if (!popup || !card) return;

    // Check frequency cap
    const lastShown = localStorage.getItem(STORAGE_KEY);
    if (lastShown && Date.now() - parseInt(lastShown, 10) < ONE_DAY_MS) {
      return; // Already shown in last 24h
    }

    let hasTriggered = false;

    function showPopup() {
      if (hasTriggered) return;
      hasTriggered = true;
      localStorage.setItem(STORAGE_KEY, Date.now().toString());

      popup.classList.remove('hidden');
      popup.classList.add('flex');
      
      requestAnimationFrame(() => {
        popup.classList.remove('opacity-0');
        popup.classList.add('opacity-100');
        card.classList.remove('scale-95');
        card.classList.add('scale-100');
      });
    }

    function closePopup() {
      popup.classList.remove('opacity-100');
      popup.classList.add('opacity-0');
      card.classList.remove('scale-100');
      card.classList.add('scale-95');

      setTimeout(() => {
        popup.classList.remove('flex');
        popup.classList.add('hidden');
      }, 300);
    }

    // Desktop exit-intent trigger
    const handleMouseLeave = (e: MouseEvent) => {
      if (e.clientY <= 15 && e.relatedTarget === null) {
        showPopup();
        document.removeEventListener('mouseleave', handleMouseLeave);
      }
    };
    document.addEventListener('mouseleave', handleMouseLeave);

    // Mobile fallback after 45s of active browsing
    const timer = setTimeout(() => {
      showPopup();
    }, 45000);

    // Event listeners for close
    closeBtn?.addEventListener('click', () => {
      clearTimeout(timer);
      closePopup();
    });

    dismissBtn?.addEventListener('click', () => {
      clearTimeout(timer);
      closePopup();
    });

    ctaBtn?.addEventListener('click', () => {
      clearTimeout(timer);
      closePopup();
    });

    // Close on backdrop click
    popup.addEventListener('click', (e) => {
      if (e.target === popup) {
        clearTimeout(timer);
        closePopup();
      }
    });

    // Close on Escape
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && !popup.classList.contains('hidden')) {
        clearTimeout(timer);
        closePopup();
      }
    });
  }

  // Initialize after DOM load
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initExitPopup);
  } else {
    initExitPopup();
  }
</script>
