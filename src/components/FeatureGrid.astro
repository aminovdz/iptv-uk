---
// src/components/FeatureGrid.astro
import { ShieldCheck, Tv, Trophy, Clock, Film, Smartphone, Zap, Sparkles } from 'lucide-astro';

const features = [
  {
    icon: ShieldCheck,
    color: "text-emerald-400 bg-emerald-500/10 border-emerald-500/20",
    badge: "99.9% Uptime",
    title: "Anti-Freeze™ Technology 9.0",
    description: "Our dedicated UK server nodes dynamically re-route streams across redundant high-bandwidth pipelines to eliminate buffering, stutter, and ISP peak-hour slowdowns."
  },
  {
    icon: Tv,
    color: "text-red-400 bg-red-500/10 border-red-500/20",
    badge: "Native 60FPS",
    title: "Ultra 4K & High-Framerate Feeds",
    description: "Experience live sports and cinema in crystal-clear 4K and 1080p 60FPS. Fast-motion stadium action renders crisp with zero tearing or compression noise."
  },
  {
    icon: Trophy,
    color: "text-amber-400 bg-amber-500/10 border-amber-500/20",
    badge: "Unrestricted",
    title: "Saturday 3PM Football & All Live Sports",
    description: "Enjoy full access to every Premier League matchday fixture—including Saturday 3PM kickoffs, European cup derbies, Formula 1 weekends, and combat PPV cards."
  },
  {
    icon: Clock,
    color: "text-blue-400 bg-blue-500/10 border-blue-500/20",
    badge: "Rewind Live TV",
    title: "7-Day Catch-Up & Interactive EPG",
    description: "Missed the evening broadcast or a big fight? Use our integrated 7-day rolling catch-up TV and TV guide to watch your favourite British shows on demand."
  },
  {
    icon: Film,
    color: "text-purple-400 bg-purple-500/10 border-purple-500/20",
    badge: "Updated Weekly",
    title: "Vast On-Demand Cinema & Box Sets",
    description: "Instant access to a constantly refreshed library of theatrical cinema releases, trending series, and international documentaries in original audio with subtitles."
  },
  {
    icon: Smartphone,
    color: "text-sky-400 bg-sky-500/10 border-sky-500/20",
    badge: "Instant Sync",
    title: "Universal Cross-Device Freedom",
    description: "One subscription works seamlessly on Amazon Firestick, Samsung & LG Smart TVs, Apple TV, Android Boxes, Formuler, TiviMate, IPTV Smarters, and PCs."
  }
];
---

<section id="features" class="py-24 bg-[#050814] relative overflow-hidden border-b border-blue-900/40">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    
    <!-- Section Header -->
    <div class="text-center max-w-3xl mx-auto mb-16">
      <div class="inline-flex items-center gap-2 px-4 py-1 rounded-full bg-red-500/10 border border-red-500/25 text-red-400 text-xs font-black uppercase tracking-widest mb-4">
        <Sparkles class="w-3.5 h-3.5" />
        Pinnacle British Streaming Performance
      </div>
      <h2 class="text-3xl sm:text-5xl font-black text-white tracking-tight mb-6">
        Engineered for Viewers Who <span class="text-transparent bg-clip-text bg-gradient-to-r from-red-500 to-blue-400">Demand Zero Lag</span>
      </h2>
      <p class="text-base sm:text-lg text-blue-200/80 leading-relaxed font-medium">
        Built from the ground up for UK broadband connections. Experience unmatched reliability whether watching on Fibre, 5G, or standard home Wi-Fi.
      </p>
    </div>

    <!-- Features 3x2 Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 sm:gap-8">
      {features.map((feat) => {
        const IconComponent = feat.icon;
        return (
          <div class="group relative rounded-3xl p-8 bg-white/[0.03] hover:bg-white/[0.07] backdrop-blur-md border border-white/10 hover:border-red-500/50 shadow-xl hover:shadow-red-900/20 transition-all duration-300 flex flex-col justify-between">
            <div>
              <div class="flex items-center justify-between mb-6">
                <div class={`w-14 h-14 rounded-2xl flex items-center justify-center border ${feat.color} shadow-lg transition-transform group-hover:scale-110`}>
                  <IconComponent class="w-7 h-7" />
                </div>
                <span class="text-[11px] font-black uppercase tracking-wider px-3 py-1 rounded-full bg-white/5 border border-white/10 text-gray-300">
                  {feat.badge}
                </span>
              </div>
              <h3 class="text-xl font-black text-white mb-3 group-hover:text-red-400 transition-colors">
                {feat.title}
              </h3>
              <p class="text-sm text-gray-300 leading-relaxed font-normal">
                {feat.description}
              </p>
            </div>
            
            <div class="mt-6 pt-4 border-t border-white/5 flex items-center text-xs font-bold text-blue-300 group-hover:text-white transition-colors">
              <span>Optimised for UK Broadband</span>
              <span class="ml-auto text-red-500 group-hover:translate-x-1 transition-transform">&rarr;</span>
            </div>
          </div>
        );
      })}
    </div>

  </div>
</section>
