---
// src/components/CitiesList.astro
import { MapPin, ArrowRight, Wifi } from 'lucide-astro';

const primaryCities = [
  { name: "London", slug: "london", region: "Greater London", ping: "< 4ms", hubs: "Westminster & Docklands" },
  { name: "Manchester", slug: "manchester", region: "North West", ping: "< 5ms", hubs: "MediaCityUK & Manchester Exchange" },
  { name: "Scotland", slug: "scotland", region: "Nationwide Hub", ping: "< 7ms", hubs: "Lothian & Clyde High-Speed Node" },
  { name: "Birmingham", slug: "birmingham", region: "West Midlands", ping: "< 6ms", hubs: "Central England Hub" },
  { name: "Glasgow", slug: "glasgow", region: "Strathclyde", ping: "< 7ms", hubs: "Clyde Fibre Relay" },
  { name: "Liverpool", slug: "liverpool", region: "Merseyside", ping: "< 6ms", hubs: "Mersey Fibre Exchange" },
  { name: "Leeds", slug: "leeds", region: "West Yorkshire", ping: "< 6ms", hubs: "Yorkshire Data Hub" },
  { name: "Edinburgh", slug: "edinburgh", region: "Midlothian", ping: "< 8ms", hubs: "Edinburgh Edge Exchange" }
];

const secondaryRegions = [
  { name: "Newcastle", slug: "newcastle" },
  { name: "Cardiff", slug: "cardiff" },
  { name: "Belfast", slug: "belfast" },
  { name: "Bristol", slug: null },
  { name: "Sheffield", slug: null },
  { name: "Southampton", slug: null },
  { name: "Leicester", slug: null },
  { name: "Nottingham", slug: null }
];
---

<section id="locations" class="py-20 bg-[#050814] relative overflow-hidden border-b border-blue-900/40">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    
    <!-- Section Header -->
    <div class="text-center max-w-3xl mx-auto mb-14">
      <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-blue-500/10 border border-blue-500/25 text-blue-300 text-xs font-black uppercase tracking-widest mb-4">
        <MapPin class="w-3.5 h-3.5 text-red-500" />
        Nationwide Edge Coverage
      </div>
      <h2 class="text-3xl sm:text-5xl font-black text-white tracking-tight mb-4">
        Low-Latency Streaming Across <span class="text-transparent bg-clip-text bg-gradient-to-r from-red-500 to-blue-400">All UK Regions</span>
      </h2>
      <p class="text-base sm:text-lg text-blue-200/80 font-medium">
        Our local Cloudflare edge nodes connect viewers across England, Scotland, Wales, and Northern Ireland directly to the closest high-speed streaming relay.
      </p>
    </div>

    <!-- 8 Primary Regional Hub Cards (2 rows of 4) -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 mb-10">
      {primaryCities.map((city) => (
        <a 
          href={`/locations/${city.slug}`}
          class="rounded-2xl p-5 bg-white/[0.03] hover:bg-white/[0.07] backdrop-blur-md border border-white/10 hover:border-red-500/50 transition-all duration-300 group shadow-lg flex flex-col justify-between"
        >
          <div>
            <div class="flex items-center justify-between mb-3 text-xs text-gray-400">
              <span class="flex items-center gap-1 font-semibold text-emerald-400">
                <Wifi class="w-3 h-3" />
                {city.ping}
              </span>
              <span class="text-[10px] uppercase font-bold text-gray-400">{city.region}</span>
            </div>
            
            <h3 class="text-lg font-black text-white group-hover:text-red-400 transition-colors mb-1">
              {city.name}
            </h3>
            
            <p class="text-[11px] text-gray-400">
              {city.hubs}
            </p>
          </div>

          <div class="mt-4 pt-3 border-t border-white/5 flex items-center justify-between text-xs font-bold text-blue-300 group-hover:text-white transition-colors">
            <span>Explore {city.name} Hub</span>
            <ArrowRight class="w-3.5 h-3.5 text-red-500 group-hover:translate-x-1 transition-transform" />
          </div>
        </a>
      ))}
    </div>

    <!-- Secondary Regions Pill Cloud -->
    <div class="rounded-2xl bg-white/[0.02] border border-white/5 p-6 text-center">
      <span class="text-xs font-bold uppercase tracking-wider text-gray-400 block mb-3">
        Additional UK Metropolitan Areas Served:
      </span>
      <div class="flex flex-wrap items-center justify-center gap-2">
        {secondaryRegions.map((region) => (
          region.slug ? (
            <a 
              href={`/locations/${region.slug}`} 
              class="px-3.5 py-1.5 rounded-full text-xs font-semibold bg-white/5 hover:bg-white/10 text-gray-300 hover:text-white border border-white/5 hover:border-red-500/30 transition-all flex items-center gap-1.5"
            >
              <span>{region.name}</span>
              <span class="text-[10px] text-emerald-400 font-bold">&bull; Active Hub</span>
            </a>
          ) : (
            <span class="px-3.5 py-1.5 rounded-full text-xs font-medium bg-white/[0.03] text-gray-400 border border-white/5">
              {region.name}
            </span>
          )
        ))}
      </div>
    </div>

  </div>
</section>
