---
// src/components/PricingCard.astro
import { Check, Star, Zap, ShieldCheck } from 'lucide-astro';

interface Props {
  name: string;
  duration: string;
  price: string;
  originalPrice?: string;
  perMonthEquivalent?: string;
  isBestValue?: boolean;
  isPopular?: boolean;
  freePlayerBonus?: boolean;
  features: string[];
  ctaText?: string;
  whatsappMessage: string;
}

const {
  name,
  duration,
  price,
  originalPrice,
  perMonthEquivalent,
  isBestValue = false,
  isPopular = false,
  freePlayerBonus = false,
  features,
  ctaText = "Select Pass",
  whatsappMessage
} = Astro.props;

const whatsappUrl = `https://wa.me/213550592200?text=${encodeURIComponent(whatsappMessage)}`;
---

<div class={`relative rounded-3xl p-6 sm:p-8 flex flex-col justify-between transition-all duration-300 ${
  isBestValue 
    ? 'bg-gradient-to-b from-[#C8102E]/25 via-white/[0.05] to-white/[0.03] border-2 border-red-500 shadow-2xl shadow-red-900/40 md:-translate-y-4 hover:-translate-y-6' 
    : isPopular
    ? 'bg-white/[0.06] border border-blue-400/40 shadow-xl hover:-translate-y-2'
    : 'bg-white/[0.03] border border-white/10 hover:border-white/20 hover:-translate-y-2'
}`}>
  
  {isBestValue && (
    <div class="absolute -top-3.5 left-1/2 -translate-x-1/2 bg-gradient-to-r from-red-600 to-amber-500 text-white text-[11px] font-black px-4 py-1 rounded-full uppercase tracking-widest shadow-lg flex items-center gap-1.5 whitespace-nowrap">
      <Star class="w-3 h-3 fill-white" />
      <span>Most Popular &bull; Best Value Deal</span>
    </div>
  )}

  {isPopular && !isBestValue && (
    <div class="absolute -top-3.5 left-1/2 -translate-x-1/2 bg-blue-600 text-white text-[11px] font-black px-3.5 py-1 rounded-full uppercase tracking-wider shadow-md">
      Popular Choice
    </div>
  )}

  <div>
    <!-- Card Header -->
    <div class="flex items-center justify-between mb-4 mt-2">
      <h3 class="text-xl sm:text-2xl font-black text-white">{name}</h3>
      <span class="text-xs font-bold text-gray-400 px-2.5 py-0.5 rounded-full bg-white/5 border border-white/10">
        {duration}
      </span>
    </div>

    <!-- Price Area -->
    <div class="mb-6 pb-6 border-b border-white/10">
      <div class="flex items-baseline gap-2">
        <span class="text-4xl sm:text-5xl font-black text-white">&pound;{price}</span>
        {originalPrice && (
          <span class="text-lg text-gray-500 line-through font-bold">&pound;{originalPrice}</span>
        )}
      </div>
      {perMonthEquivalent && (
        <p class="text-xs font-semibold text-emerald-400 mt-1">
          Only &pound;{perMonthEquivalent}/month equivalent
        </p>
      )}
      <span class="text-[11px] text-gray-400 block mt-0.5">One-time payment &bull; Zero contracts</span>
    </div>

    <!-- Free Premium Player Bonus Banner (12-Month Plan Feature) -->
    {(isBestValue || freePlayerBonus) && (
      <div class="mb-6 p-3 rounded-2xl bg-gradient-to-r from-amber-500/20 via-red-500/15 to-amber-500/20 border border-amber-400/50 flex items-center gap-3 shadow-lg">
        <span class="text-2xl animate-pulse flex-shrink-0">🎁</span>
        <div class="text-left min-w-0">
          <div class="flex items-center gap-1.5 flex-wrap">
            <span class="text-[11px] font-black text-amber-300 uppercase tracking-wider">Free Premium Player</span>
            <span class="bg-amber-400 text-black text-[9px] font-black px-1.5 py-0.2 rounded font-mono">£25 VALUE</span>
          </div>
          <p class="text-[11px] text-gray-200 mt-0.5 leading-snug">Includes free TiviMate / IBO Player license activation</p>
        </div>
      </div>
    )}

    <!-- Features List -->
    <ul class="space-y-3 mb-8 text-xs sm:text-sm text-gray-300">
      {features.map((feat) => (
        <li class="flex items-start gap-2.5">
          <div class="w-4 h-4 rounded-full bg-emerald-500/20 text-emerald-400 flex items-center justify-center flex-shrink-0 mt-0.5">
            <Check class="w-3 h-3" />
          </div>
          <span>{feat}</span>
        </li>
      ))}
    </ul>
  </div>

  <!-- Action CTA -->
  <div>
    <a 
      href={whatsappUrl} 
      target="_blank" 
      rel="noopener noreferrer"
      class={`w-full py-3.5 px-6 rounded-full font-black text-sm text-center block transition-all shadow-lg ${
        isBestValue 
          ? 'bg-[#C8102E] hover:bg-red-700 text-white shadow-red-900/50 hover:shadow-red-900/80 hover:scale-105' 
          : 'bg-white/10 hover:bg-white/20 text-white border border-white/20 hover:border-white/40'
      }`}
    >
      {ctaText} &rarr;
    </a>
    
    <div class="mt-3 flex items-center justify-center gap-1.5 text-[11px] text-gray-400">
      <Zap class="w-3 h-3 text-amber-400" />
      <span>Automated setup in 90 seconds</span>
    </div>
  </div>

</div>
