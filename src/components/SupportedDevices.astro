---
// src/components/SupportedDevices.astro
import { Tv, Smartphone, Laptop, HardDrive, Monitor, ArrowRight, Check } from 'lucide-astro';

const devices = [
  {
    name: "Amazon Fire TV Stick",
    models: "Firestick Lite, 4K, 4K Max & Cube",
    icon: Tv,
    popular: true,
    apps: ["TiviMate", "IPTV Smarters Pro", "Downloader"],
    setupTime: "90 seconds"
  },
  {
    name: "Smart TVs (Samsung & LG)",
    models: "Samsung Tizen, LG webOS & Sony Bravia",
    icon: Monitor,
    popular: true,
    apps: ["IBO Player", "IPTV Smarters", "Smart IPTV"],
    setupTime: "2 minutes"
  },
  {
    name: "Apple TV & iOS",
    models: "Apple TV 4K, iPhone, iPad & Mac",
    icon: Smartphone,
    popular: false,
    apps: ["Smarters Player Lite", "GSE Smart IPTV"],
    setupTime: "2 minutes"
  },
  {
    name: "Android TV & Media Boxes",
    models: "NVIDIA Shield, Google TV, Xiaomi Box",
    icon: HardDrive,
    popular: false,
    apps: ["TiviMate Premium", "XCIPTV", "Televizo"],
    setupTime: "90 seconds"
  },
  {
    name: "Dedicated MAG & Formuler",
    models: "Formuler Z11, MAG 254 / 322 / 524",
    icon: HardDrive,
    popular: false,
    apps: ["MyTVOnline 3", "Stalker Portal", "MAC Bind"],
    setupTime: "2 minutes"
  },
  {
    name: "Windows PC & Mac",
    models: "Laptops, Desktops & Web Browsers",
    icon: Laptop,
    popular: false,
    apps: ["IPTV Smarters Desktop", "VLC Player"],
    setupTime: "1 minute"
  }
];
---

<section id="devices" class="py-24 bg-[#00102e] relative overflow-hidden border-b border-blue-900/40">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    
    <!-- Section Header -->
    <div class="text-center max-w-3xl mx-auto mb-16">
      <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-red-500/10 border border-red-500/25 text-red-400 text-xs font-black uppercase tracking-widest mb-4">
        <span>Universal Freedom</span>
      </div>
      <h2 class="text-3xl sm:text-5xl font-black text-white tracking-tight mb-4">
        Watch on <span class="text-transparent bg-clip-text bg-gradient-to-r from-red-500 to-blue-400">Any Device</span> You Own
      </h2>
      <p class="text-base sm:text-lg text-blue-200/80 font-medium">
        No expensive hardware lock-in. Our UK stream passes integrate with all standard streaming apps and Smart TV operating systems.
      </p>
    </div>

    <!-- 6-Grid Supported Devices -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 sm:gap-8 mb-12">
      {devices.map((dev) => {
        const IconComponent = dev.icon;
        return (
          <div class="rounded-3xl p-6 sm:p-8 bg-white/[0.03] hover:bg-white/[0.06] backdrop-blur-md border border-white/10 hover:border-blue-400/50 transition-all duration-300 shadow-xl flex flex-col justify-between group">
            <div>
              <div class="flex items-center justify-between mb-4">
                <div class="w-12 h-12 rounded-2xl bg-white/5 border border-white/10 flex items-center justify-center text-blue-300 group-hover:text-red-400 transition-colors">
                  <IconComponent class="w-6 h-6" />
                </div>
                {dev.popular && (
                  <span class="text-[10px] font-black uppercase tracking-wider px-2.5 py-0.5 rounded-full bg-red-500/20 text-red-400 border border-red-500/30">
                    Most Popular
                  </span>
                )}
              </div>

              <h3 class="text-xl font-black text-white mb-1 group-hover:text-red-400 transition-colors">
                {dev.name}
              </h3>
              <p class="text-xs text-blue-200/70 mb-5 font-medium">{dev.models}</p>

              <!-- Recommended Apps -->
              <div class="mb-4">
                <span class="text-[11px] font-bold uppercase tracking-wider text-gray-400 block mb-2">
                  Recommended Players:
                </span>
                <div class="flex flex-wrap gap-1.5">
                  {dev.apps.map((app) => (
                    <span class="text-xs font-semibold px-2.5 py-1 rounded-lg bg-white/5 border border-white/10 text-gray-200">
                      {app}
                    </span>
                  ))}
                </div>
              </div>
            </div>

            <div class="pt-4 border-t border-white/5 flex items-center justify-between text-xs text-gray-400">
              <span>Setup time: <strong class="text-white">{dev.setupTime}</strong></span>
              <a href="/guides/" class="text-blue-300 group-hover:text-white font-bold inline-flex items-center gap-1 transition-colors">
                Guide &rarr;
              </a>
            </div>
          </div>
        );
      })}
    </div>

    <!-- Quick Link to Firestick Dedicated Hub -->
    <div class="text-center">
      <a 
        href="/iptv-firestick-uk/" 
        class="inline-flex items-center gap-2 px-6 py-3 rounded-full text-xs sm:text-sm font-extrabold bg-white/5 hover:bg-white/10 text-white border border-white/10 hover:border-white/20 transition-all"
      >
        <span>Looking for our dedicated Firestick Downloader guide? Click here</span>
        <ArrowRight class="w-4 h-4 text-red-500" />
      </a>
    </div>

  </div>
</section>
