---
// src/components/GroupsPopup.astro
// VIP Community Invite (Telegram & WhatsApp Channel) with 24-hour frequency capping
---

<div 
  id="groups-popup" 
  class="fixed inset-0 z-[100] hidden items-center justify-center p-4 bg-black/80 backdrop-blur-md transition-opacity duration-300 opacity-0"
  aria-modal="true" 
  role="dialog"
  aria-labelledby="groups-popup-title"
>
  <div 
    id="groups-popup-card" 
    class="relative w-full max-w-lg rounded-3xl bg-[#090D1A] border border-blue-500/30 p-6 sm:p-8 shadow-2xl text-center transform scale-95 transition-all duration-300 overflow-hidden"
  >
    <!-- Background atmospheric glows -->
    <div class="absolute -top-24 -right-24 w-60 h-60 bg-blue-600/20 blur-3xl rounded-full pointer-events-none"></div>
    <div class="absolute -bottom-24 -left-24 w-60 h-60 bg-emerald-600/20 blur-3xl rounded-full pointer-events-none"></div>

    <!-- Close button -->
    <button 
      id="groups-popup-close" 
      type="button" 
      class="absolute top-4 right-4 text-gray-400 hover:text-white p-2 rounded-full hover:bg-white/10 transition-colors z-20"
      aria-label="Close community popup"
    >
      <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
      </svg>
    </button>

    <!-- Top Badge -->
    <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-blue-500/10 border border-blue-500/30 text-blue-400 text-xs font-black uppercase tracking-wider mb-4">
      <span class="w-2 h-2 rounded-full bg-blue-500 animate-pulse"></span>
      VIP UK Community • 12,400+ Members
    </div>

    <!-- Title -->
    <h3 id="groups-popup-title" class="text-2xl sm:text-3xl font-black text-white leading-tight">
      Join the Official <span class="bg-gradient-to-r from-blue-400 via-sky-300 to-emerald-400 bg-clip-text text-transparent">VIP Streaming Hub</span>
    </h3>

    <p class="mt-3 text-sm text-gray-300 leading-relaxed">
      Get daily 4K match schedules, 3 PM kick-off announcements, server uptime alerts, and exclusive subscriber flash discounts directly to your phone.
    </p>

    <!-- Two Channel Cards -->
    <div class="mt-6 grid grid-cols-1 sm:grid-cols-2 gap-3.5 text-left">
      <!-- WhatsApp Channel -->
      <a 
        href="https://whatsapp.com/channel/0029VayVaLpD8SE3bf8wMY3v" 
        target="_blank" 
        rel="noopener noreferrer"
        class="group p-4 rounded-2xl bg-[#0F172A] border border-emerald-500/30 hover:border-emerald-500 hover:bg-emerald-950/20 transition-all flex flex-col justify-between"
      >
        <div class="flex items-center gap-3 mb-2">
          <div class="w-10 h-10 rounded-xl bg-[#25D366]/20 text-[#25D366] flex items-center justify-center font-bold">
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
              <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L0 24l6.335-1.662c1.72.94 3.659 1.437 5.63 1.438h.004c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
            </svg>
          </div>
          <div>
            <h4 class="text-sm font-bold text-white group-hover:text-emerald-400 transition-colors">WhatsApp Channel</h4>
            <p class="text-[11px] text-emerald-400 font-medium">Daily Match Feeds</p>
          </div>
        </div>
        <span class="text-xs text-gray-400 mt-2 flex items-center justify-between font-semibold">
          Join Channel &rarr;
        </span>
      </a>

      <!-- Telegram Channel -->
      <a 
        href="https://t.me/castvera_com" 
        target="_blank" 
        rel="noopener noreferrer"
        class="group p-4 rounded-2xl bg-[#0F172A] border border-sky-500/30 hover:border-sky-500 hover:bg-sky-950/20 transition-all flex flex-col justify-between"
      >
        <div class="flex items-center gap-3 mb-2">
          <div class="w-10 h-10 rounded-xl bg-[#229ED9]/20 text-[#229ED9] flex items-center justify-center font-bold">
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
              <path d="M12 0C5.373 0 0 5.373 0 12s5.373 12 12 12 12-5.373 12-12S18.627 0 12 0zm5.894 8.221l-1.97 9.28c-.145.658-.537.818-1.084.508l-3-2.21-1.446 1.394c-.14.18-.357.3-.6.3l.2-3.05 5.56-5.022c.24-.213-.054-.334-.373-.121l-6.87 4.326-2.96-.924c-.643-.204-.657-.643.136-.953l11.57-4.458c.535-.194 1.006.128.837.918z"/>
            </svg>
          </div>
          <div>
            <h4 class="text-sm font-bold text-white group-hover:text-sky-400 transition-colors">Telegram VIP</h4>
            <p class="text-[11px] text-sky-400 font-medium">Uptime & Alerts</p>
          </div>
        </div>
        <span class="text-xs text-gray-400 mt-2 flex items-center justify-between font-semibold">
          Join VIP Group &rarr;
        </span>
      </a>
    </div>

    <!-- Dismiss button -->
    <button 
      id="groups-popup-dismiss"
      type="button" 
      class="mt-6 text-xs text-gray-500 hover:text-gray-300 transition-colors block mx-auto"
    >
      Remind me later
    </button>
  </div>
</div>

<script>
  function initGroupsPopup() {
    const STORAGE_KEY = 'british_iptv_groups_popup_last_shown';
    const ONE_DAY_MS = 24 * 60 * 60 * 1000;

    const popup = document.getElementById('groups-popup');
    const card = document.getElementById('groups-popup-card');
    const closeBtn = document.getElementById('groups-popup-close');
    const dismissBtn = document.getElementById('groups-popup-dismiss');

    if (!popup || !card) return;

    // Check frequency cap
    const lastShown = localStorage.getItem(STORAGE_KEY);
    if (lastShown && Date.now() - parseInt(lastShown, 10) < ONE_DAY_MS) {
      return;
    }

    function showPopup() {
      localStorage.setItem(STORAGE_KEY, Date.now().toString());
      popup.classList.remove('hidden');
      popup.classList.add('flex');
      
      requestAnimationFrame(() => {
        popup.classList.remove('opacity-0');
        popup.classList.add('opacity-100');
        card.classList.remove('scale-95');
        card.classList.add('scale-100');
      });
    }

    function closePopup() {
      popup.classList.remove('opacity-100');
      popup.classList.add('opacity-0');
      card.classList.remove('scale-100');
      card.classList.add('scale-95');

      setTimeout(() => {
        popup.classList.remove('flex');
        popup.classList.add('hidden');
      }, 300);
    }

    // Delay auto-trigger after 25s
    const timer = setTimeout(() => {
      // Don't pop if exit popup is active
      const exitPopup = document.getElementById('exit-popup');
      if (exitPopup && !exitPopup.classList.contains('hidden')) return;
      showPopup();
    }, 25000);

    closeBtn?.addEventListener('click', () => {
      clearTimeout(timer);
      closePopup();
    });

    dismissBtn?.addEventListener('click', () => {
      clearTimeout(timer);
      closePopup();
    });

    popup.addEventListener('click', (e) => {
      if (e.target === popup) {
        clearTimeout(timer);
        closePopup();
      }
    });

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && !popup.classList.contains('hidden')) {
        clearTimeout(timer);
        closePopup();
      }
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initGroupsPopup);
  } else {
    initGroupsPopup();
  }
</script>
