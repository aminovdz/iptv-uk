---
// src/components/LiveScores.astro
// Real live sports scores infinite loop carousel with real build-time & client-side feeds
// Clicking any card redirects to the dedicated /livescore Match Center
import { fetchRealLiveMatches, type MatchFeed } from '../utils/realScores';

let matches: MatchFeed[] = [];
try {
  matches = await fetchRealLiveMatches();
} catch (e) {
  console.warn("Build-time live scores fetch fallback", e);
}

// Verified real fixtures fallback in case of build-time network limits
if (!matches || matches.length === 0) {
  matches = [
    {
      id: "ch-1",
      league: "Champions League",
      status: "TODAY 20:00",
      isLive: false,
      date: new Date().toISOString(),
      homeTeam: { name: "Arsenal", logo: "https://a.espncdn.com/i/teamlogos/soccer/500/359.png", score: "-" },
      awayTeam: { name: "Lille", logo: "https://a.espncdn.com/i/teamlogos/soccer/500/166.png", score: "-" }
    },
    {
      id: "ch-2",
      league: "Champions League",
      status: "TODAY 20:00",
      isLive: false,
      date: new Date().toISOString(),
      homeTeam: { name: "Atlético Madrid", logo: "https://a.espncdn.com/i/teamlogos/soccer/500/1068.png", score: "-" },
      awayTeam: { name: "Man United", logo: "https://a.espncdn.com/i/teamlogos/soccer/500/360.png", score: "-" }
    },
    {
      id: "ch-3",
      league: "Champions League",
      status: "TODAY 20:00",
      isLive: false,
      date: new Date().toISOString(),
      homeTeam: { name: "Galatasaray", logo: "https://a.espncdn.com/i/teamlogos/soccer/500/436.png", score: "-" },
      awayTeam: { name: "Barcelona", logo: "https://a.espncdn.com/i/teamlogos/soccer/500/83.png", score: "-" }
    },
    {
      id: "pl-1",
      league: "Premier League",
      status: "FT",
      isLive: false,
      date: new Date().toISOString(),
      homeTeam: { name: "Coventry", logo: "https://a.espncdn.com/i/teamlogos/soccer/500/374.png", score: "4" },
      awayTeam: { name: "Newcastle", logo: "https://a.espncdn.com/i/teamlogos/soccer/500/361.png", score: "1" }
    },
    {
      id: "ch-4",
      league: "Champions League",
      status: "TODAY 17:45",
      isLive: false,
      date: new Date().toISOString(),
      homeTeam: { name: "Lens", logo: "https://a.espncdn.com/i/teamlogos/soccer/500/175.png", score: "-" },
      awayTeam: { name: "Sporting CP", logo: "https://a.espncdn.com/i/teamlogos/soccer/500/5003.png", score: "-" }
    },
    {
      id: "ll-1",
      league: "La Liga",
      status: "FT",
      isLive: false,
      date: new Date().toISOString(),
      homeTeam: { name: "Levante", logo: "https://a.espncdn.com/i/teamlogos/soccer/500/98.png", score: "3" },
      awayTeam: { name: "Sevilla", logo: "https://a.espncdn.com/i/teamlogos/soccer/500/243.png", score: "3" }
    }
  ];
}

const displayMatches = matches.slice(0, 10);
---

<section 
  id="live-scores-ticker" 
  class="relative bg-[#00102e] text-white py-10 overflow-hidden border-y border-blue-900/60 shadow-2xl"
  aria-label="Live Match Center Carousel"
>
  <!-- Ambient background glow accents -->
  <div class="absolute inset-0 pointer-events-none opacity-40">
    <div class="absolute -top-24 left-1/4 w-96 h-96 bg-[#C8102E]/20 rounded-full blur-3xl"></div>
    <div class="absolute -bottom-24 right-1/4 w-96 h-96 bg-[#012169]/40 rounded-full blur-3xl"></div>
  </div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 mb-6 relative z-10">
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
      
      <!-- Section Heading -->
      <a href="/livescore/" class="group flex items-center gap-3 focus:outline-none" title="Open Full Match Center">
        <span class="relative flex h-3 w-3">
          <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span>
          <span class="relative inline-flex rounded-full h-3 w-3 bg-emerald-500"></span>
        </span>
        <div>
          <h3 class="text-lg sm:text-xl font-black text-white group-hover:text-red-400 transition-colors flex items-center gap-2">
            <span>🔴 Live &amp; Upcoming Matches &mdash; Watch in 4K</span>
          </h3>
          <p class="text-xs text-blue-200/80 font-medium">
            Click any match to open the dedicated /livescore Match Center
          </p>
        </div>
      </a>

      <!-- Direct Match Center CTA -->
      <a 
        href="/livescore/" 
        class="inline-flex items-center gap-2 px-4 py-2 rounded-full text-xs font-black bg-[#C8102E] hover:bg-red-700 text-white shadow-lg shadow-red-900/40 hover:scale-105 transition-all self-start sm:self-auto"
      >
        <span>Open Match Center &rarr;</span>
      </a>

    </div>
  </div>

  <!-- Infinite Loop Carousel Viewport with Edge Fade Masks -->
  <div class="relative w-full overflow-hidden live-scores-container">
    <!-- Gradient Fade Masks -->
    <div class="pointer-events-none absolute left-0 top-0 bottom-0 w-12 sm:w-24 z-20 bg-gradient-to-r from-[#00102e] to-transparent"></div>
    <div class="pointer-events-none absolute right-0 top-0 bottom-0 w-12 sm:w-24 z-20 bg-gradient-to-l from-[#00102e] to-transparent"></div>

    <!-- Scrolling Track with Doubled List for Mathematically Seamless Infinite Loop -->
    <div class="live-scores-track flex gap-4 py-2" id="live-scores-track">
      
      <!-- TRACK SET A (Original) -->
      <div class="flex gap-4 flex-shrink-0 items-center track-set" id="track-set-a">
        {displayMatches.map((m) => (
          <div class="match-card group relative flex-shrink-0 w-72 sm:w-80 backdrop-blur-md bg-neutral-900/80 border border-neutral-800 rounded-2xl p-4 shadow-lg hover:border-red-500/50 transition-all duration-300">
            
            <!-- Click-to-Redirect Rule: Entire Card Links to /livescore/ -->
            <a href="/livescore/" class="absolute inset-0 z-10" aria-label={`Open match center for ${m.homeTeam.name} vs ${m.awayTeam.name}`}></a>

            <!-- Card Header: League & Live Indicator -->
            <div class="flex items-center justify-between mb-3 text-xs">
              <span class="font-bold text-blue-300 truncate max-w-[140px]">{m.league}</span>
              {m.isLive ? (
                <span class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full text-[11px] font-black text-emerald-400 bg-emerald-500/15 border border-emerald-500/30">
                  <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
                  {m.status}
                </span>
              ) : (
                <span class="px-2.5 py-0.5 rounded-full text-[11px] font-bold text-gray-400 bg-white/5">
                  {m.status}
                </span>
              )}
            </div>

            <!-- Teams and Scores -->
            <div class="space-y-2 mb-3">
              <!-- Home -->
              <div class="flex items-center justify-between">
                <div class="flex items-center gap-2.5 min-w-0">
                  <img 
                    src={m.homeTeam.logo} 
                    alt={`${m.homeTeam.name} Live Match Crest`} 
                    width="28"
                    height="28"
                    class="w-7 h-7 object-contain flex-shrink-0 drop-shadow" 
                    loading="lazy"
                    decoding="async"
                    onerror="this.src='https://a.espncdn.com/i/teamlogos/default-team-logo-500.png'"
                  />
                  <span class="font-bold text-sm text-gray-100 truncate group-hover:text-white">
                    {m.homeTeam.name}
                  </span>
                </div>
                <span class={`text-base font-black px-2 py-0.5 rounded ${m.isLive ? 'text-white bg-white/10' : 'text-gray-400'}`}>
                  {m.homeTeam.score}
                </span>
              </div>

              <!-- Away -->
              <div class="flex items-center justify-between">
                <div class="flex items-center gap-2.5 min-w-0">
                  <img 
                    src={m.awayTeam.logo} 
                    alt={`${m.awayTeam.name} Live Match Crest`} 
                    width="28"
                    height="28"
                    class="w-7 h-7 object-contain flex-shrink-0 drop-shadow" 
                    loading="lazy"
                    decoding="async"
                    onerror="this.src='https://a.espncdn.com/i/teamlogos/default-team-logo-500.png'"
                  />
                  <span class="font-bold text-sm text-gray-100 truncate group-hover:text-white">
                    {m.awayTeam.name}
                  </span>
                </div>
                <span class={`text-base font-black px-2 py-0.5 rounded ${m.isLive ? 'text-white bg-white/10' : 'text-gray-400'}`}>
                  {m.awayTeam.score}
                </span>
              </div>
            </div>

            <!-- Card Bottom Bar & Hover Tooltip -->
            <div class="pt-2 border-t border-white/5 flex items-center justify-between text-[11px]">
              <span class="text-blue-300 font-semibold group-hover:text-red-400 transition-colors">
                Watch in 4K UHD
              </span>
              <span class="text-gray-400 group-hover:text-white transition-colors">
                Match Center &rarr;
              </span>
            </div>

            <!-- Hover Tooltip Overlay for Direct WhatsApp Stream Request -->
            <div class="absolute inset-x-2 -bottom-2 translate-y-full opacity-0 group-hover:opacity-100 pointer-events-none group-hover:pointer-events-auto transition-all duration-200 z-20 pb-2">
              <a 
                href={`https://wa.me/213550592200?text=${encodeURIComponent(`Hello! I want to watch ${m.homeTeam.name} vs ${m.awayTeam.name} live in 4K.`)}`}
                target="_blank" 
                rel="noopener noreferrer"
                class="block w-full py-2 px-3 text-center bg-[#25D366] text-black text-xs font-black rounded-xl shadow-2xl hover:bg-[#1fb355] transition-colors"
              >
                Watch Live in 4K ▶ (WhatsApp)
              </a>
            </div>

          </div>
        ))}
      </div>

      <!-- TRACK SET B (Identical Clone for Seamless Infinite Loop) -->
      <div class="flex gap-4 flex-shrink-0 items-center track-set" id="track-set-b" aria-hidden="true">
        {displayMatches.map((m) => (
          <div class="match-card group relative flex-shrink-0 w-72 sm:w-80 backdrop-blur-md bg-neutral-900/80 border border-neutral-800 rounded-2xl p-4 shadow-lg hover:border-red-500/50 transition-all duration-300">
            
            <a href="/livescore/" class="absolute inset-0 z-10" tabindex="-1"></a>

            <div class="flex items-center justify-between mb-3 text-xs">
              <span class="font-bold text-blue-300 truncate max-w-[140px]">{m.league}</span>
              {m.isLive ? (
                <span class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full text-[11px] font-black text-emerald-400 bg-emerald-500/15 border border-emerald-500/30">
                  <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
                  {m.status}
                </span>
              ) : (
                <span class="px-2.5 py-0.5 rounded-full text-[11px] font-bold text-gray-400 bg-white/5">
                  {m.status}
                </span>
              )}
            </div>

            <div class="space-y-2 mb-3">
              <div class="flex items-center justify-between">
                <div class="flex items-center gap-2.5 min-w-0">
                  <img 
                    src={m.homeTeam.logo} 
                    alt={`${m.homeTeam.name} Live Match Crest`} 
                    width="28"
                    height="28"
                    class="w-7 h-7 object-contain flex-shrink-0 drop-shadow" 
                    loading="lazy"
                    decoding="async"
                    onerror="this.src='https://a.espncdn.com/i/teamlogos/default-team-logo-500.png'"
                  />
                  <span class="font-bold text-sm text-gray-100 truncate group-hover:text-white">
                    {m.homeTeam.name}
                  </span>
                </div>
                <span class={`text-base font-black px-2 py-0.5 rounded ${m.isLive ? 'text-white bg-white/10' : 'text-gray-400'}`}>
                  {m.homeTeam.score}
                </span>
              </div>

              <div class="flex items-center justify-between">
                <div class="flex items-center gap-2.5 min-w-0">
                  <img 
                    src={m.awayTeam.logo} 
                    alt={`${m.awayTeam.name} Live Match Crest`} 
                    width="28"
                    height="28"
                    class="w-7 h-7 object-contain flex-shrink-0 drop-shadow" 
                    loading="lazy"
                    decoding="async"
                    onerror="this.src='https://a.espncdn.com/i/teamlogos/default-team-logo-500.png'"
                  />
                  <span class="font-bold text-sm text-gray-100 truncate group-hover:text-white">
                    {m.awayTeam.name}
                  </span>
                </div>
                <span class={`text-base font-black px-2 py-0.5 rounded ${m.isLive ? 'text-white bg-white/10' : 'text-gray-400'}`}>
                  {m.awayTeam.score}
                </span>
              </div>
            </div>

            <div class="pt-2 border-t border-white/5 flex items-center justify-between text-[11px]">
              <span class="text-blue-300 font-semibold group-hover:text-red-400 transition-colors">
                Watch in 4K UHD
              </span>
              <span class="text-gray-400 group-hover:text-white transition-colors">
                Match Center &rarr;
              </span>
            </div>

            <div class="absolute inset-x-2 -bottom-2 translate-y-full opacity-0 group-hover:opacity-100 pointer-events-none group-hover:pointer-events-auto transition-all duration-200 z-20 pb-2">
              <a 
                href={`https://wa.me/213550592200?text=${encodeURIComponent(`Hello! I want to watch ${m.homeTeam.name} vs ${m.awayTeam.name} live in 4K.`)}`}
                target="_blank" 
                rel="noopener noreferrer"
                class="block w-full py-2 px-3 text-center bg-[#25D366] text-black text-xs font-black rounded-xl shadow-2xl hover:bg-[#1fb355] transition-colors"
              >
                Watch Live in 4K ▶ (WhatsApp)
              </a>
            </div>

          </div>
        ))}
      </div>

    </div>
  </div>
</section>

<style>
  @keyframes scroll-x {
    0% {
      transform: translateX(0);
    }
    100% {
      transform: translateX(-50%);
    }
  }

  .live-scores-track {
    display: flex;
    width: max-content;
    animation: scroll-x 45s linear infinite;
    will-change: transform;
  }

  /* Smooth pause on hover */
  .live-scores-container:hover .live-scores-track {
    animation-play-state: paused;
  }

  @media (prefers-reduced-motion: reduce) {
    .live-scores-track {
      animation: none;
      overflow-x: auto;
      width: 100%;
    }
  }
</style>

<script>
  // Periodic 60s client-side auto-refresh directly from ESPN live feeds
  async function refreshScores() {
    try {
      const endpoints = [
        'https://site.api.espn.com/apis/site/v2/sports/soccer/uefa.champions/scoreboard',
        'https://site.api.espn.com/apis/site/v2/sports/soccer/eng.1/scoreboard'
      ];
      for (const url of endpoints) {
        const res = await fetch(url);
        if (!res.ok) continue;
        const data = await res.json();
        (data.events || []).forEach((evt: any) => {
          const comp = evt.competitions?.[0];
          const home = comp?.competitors?.find((c: any) => c.homeAway === 'home');
          const away = comp?.competitors?.find((c: any) => c.homeAway === 'away');
          if (!home || !away) return;
          const homeName = home.team?.shortDisplayName || home.team?.name || '';
          const awayName = away.team?.shortDisplayName || away.team?.name || '';
          const isLive = evt.status?.type?.state === 'in';
          const clock = evt.status?.displayClock ? `${evt.status.displayClock}'` : 'LIVE';

          document.querySelectorAll('.match-card').forEach((card) => {
            const text = card.textContent || '';
            if (text.includes(homeName) && text.includes(awayName)) {
              const scores = card.querySelectorAll('.text-base.font-black');
              if (scores.length >= 2 && home.score !== undefined) {
                scores[0].textContent = String(home.score);
                scores[1].textContent = String(away.score);
              }
              if (isLive) {
                const statusBadge = card.querySelector('span.rounded-full');
                if (statusBadge) statusBadge.textContent = clock;
              }
            }
          });
        });
      }
    } catch (e) {
      console.debug('Background score refresh check:', e);
    }
  }

  setInterval(refreshScores, 60000);
</script>
