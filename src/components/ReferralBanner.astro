---
// src/components/ReferralBanner.astro
// High-converting referral hook section offering +1 free bonus month for both referrer and friend
---

<section id="referral" class="py-20 bg-gradient-to-b from-[#090E1D] to-[#060A14] border-t border-b border-white/5 relative overflow-hidden">
  <!-- Glowing background accents -->
  <div class="absolute top-0 right-1/4 w-96 h-96 bg-red-600/10 rounded-full blur-[120px] pointer-events-none"></div>
  <div class="absolute bottom-0 left-1/4 w-96 h-96 bg-blue-600/10 rounded-full blur-[120px] pointer-events-none"></div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    <div class="rounded-3xl bg-gradient-to-r from-blue-950/40 via-[#0E1528] to-red-950/30 border border-white/10 p-8 sm:p-12 lg:p-16 relative overflow-hidden shadow-2xl">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-center">
        <!-- Text & Hook -->
        <div class="lg:col-span-7 space-y-5">
          <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-red-500/10 border border-red-500/20 text-red-400 text-xs font-black uppercase tracking-wider">
            <span>🎁</span> Referral Rewards Program
          </div>

          <h2 class="text-3xl sm:text-4xl lg:text-5xl font-black text-white tracking-tight leading-tight">
            Share British IPTV & <br class="hidden sm:inline" />
            <span class="bg-gradient-to-r from-red-400 via-rose-300 to-amber-300 bg-clip-text text-transparent">Both Get 1 Month FREE</span>
          </h2>

          <p class="text-gray-300 text-base sm:text-lg leading-relaxed max-w-2xl">
            Love your buffer-free football and 4K cinema streams? Refer a friend, colleague, or family member across the UK. When they subscribe to any plan, we add <strong class="text-white">+30 extra days</strong> to their account AND yours completely free.
          </p>

          <!-- 3 Steps -->
          <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 pt-4">
            <div class="p-4 rounded-2xl bg-white/[0.03] border border-white/5">
              <span class="text-blue-400 font-mono font-black text-lg">01</span>
              <h4 class="font-bold text-white text-sm mt-1">Get Your Code</h4>
              <p class="text-xs text-gray-400 mt-1">Request your unique referral tag in 1 click on WhatsApp.</p>
            </div>
            <div class="p-4 rounded-2xl bg-white/[0.03] border border-white/5">
              <span class="text-blue-400 font-mono font-black text-lg">02</span>
              <h4 class="font-bold text-white text-sm mt-1">Share with Friends</h4>
              <p class="text-xs text-gray-400 mt-1">Friend sends your code when activating their subscription.</p>
            </div>
            <div class="p-4 rounded-2xl bg-white/[0.03] border border-white/5">
              <span class="text-emerald-400 font-mono font-black text-lg">03</span>
              <h4 class="font-bold text-white text-sm mt-1">Both Get +1 Month</h4>
              <p class="text-xs text-gray-400 mt-1">30 bonus days are instantly credited to both accounts.</p>
            </div>
          </div>

          <!-- CTAs -->
          <div class="pt-4 flex flex-wrap items-center gap-4">
            <a 
              href="https://wa.me/213550592200?text=Hello%20British%20IPTV!%20I%20want%20to%20get%20my%20referral%20code%20to%20earn%20free%20months." 
              target="_blank" 
              rel="noopener noreferrer"
              class="inline-flex items-center gap-2.5 px-6 py-3.5 rounded-xl bg-[#25D366] text-black font-black text-sm sm:text-base hover:bg-[#1fb355] transition-all shadow-xl hover:shadow-emerald-500/20"
            >
              <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
                <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L0 24l6.335-1.662c1.72.94 3.659 1.437 5.63 1.438h.004c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
              </svg>
              Get Your Referral Code on WhatsApp
            </a>

            <a 
              href="/referral/" 
              class="inline-flex items-center gap-1.5 text-sm font-bold text-gray-300 hover:text-white px-4 py-3 rounded-xl hover:bg-white/5 transition-colors"
            >
              Learn program details &rarr;
            </a>
          </div>
        </div>

        <!-- Big Highlight Badge Card -->
        <div class="lg:col-span-5 flex justify-center">
          <div class="w-full max-w-sm rounded-3xl bg-gradient-to-br from-red-600/20 via-blue-600/20 to-purple-600/20 p-8 border border-white/10 text-center relative backdrop-blur-xl">
            <div class="w-16 h-16 mx-auto rounded-2xl bg-red-500/20 border border-red-500/30 text-red-400 flex items-center justify-center text-3xl mb-4">
              🎁
            </div>
            <span class="block text-5xl sm:text-6xl font-black text-white tracking-tight">
              +1 MONTH
            </span>
            <span class="block mt-2 text-xs font-black uppercase tracking-widest text-red-300">
              Free For You &amp; Your Friend
            </span>
            <div class="mt-6 pt-6 border-t border-white/10 text-xs text-gray-300 space-y-1">
              <p>✔ Unlimited referrals allowed</p>
              <p>✔ Refer 12 friends = 1 Year Free IPTV</p>
              <p>✔ Valid on all subscription tiers</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
