---
import Layout from './Layout.astro';

const { frontmatter } = Astro.props;
---

<Layout title={`${frontmatter.title} | iptvuk Blog`} description={frontmatter.description}>
  <header class="sticky top-0 z-50 w-full bg-white/80 backdrop-blur-md border-b border-gray-200">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between">
      <div class="flex-shrink-0">
        <a href="/" class="text-2xl font-bold text-secondary tracking-tight">iptvuk</a>
      </div>
      <div class="flex items-center gap-4">
        <a href="/blog" class="text-gray-600 hover:text-primary font-medium">Back to Blog</a>
        <a href="/#pricing" class="bg-primary text-white px-5 py-2 rounded-full font-semibold hover:bg-red-700 transition-all">Get Started</a>
      </div>
    </div>
  </header>

  <main class="flex-grow bg-gray-50 py-16">
    <article class="max-w-4xl mx-auto px-4">
      <div class="bg-white rounded-3xl shadow-sm border border-gray-100 overflow-hidden">
        {frontmatter.image && (
          <img src={frontmatter.image} alt={frontmatter.title} class="w-full h-[400px] object-cover" />
        )}
        <div class="p-8 md:p-12">
          <div class="flex items-center gap-4 text-sm text-gray-500 mb-6">
            <span>{new Date(frontmatter.pubDate).toLocaleDateString('en-GB', { year: 'numeric', month: 'long', day: 'numeric' })}</span>
            <span>•</span>
            <span class="bg-blue-50 text-secondary px-3 py-1 rounded-full font-medium">{frontmatter.category}</span>
          </div>
          
          <h1 class="text-3xl md:text-5xl font-extrabold text-secondary mb-8 leading-tight">{frontmatter.title}</h1>
          
          <div class="prose prose-lg prose-blue max-w-none prose-headings:text-secondary prose-a:text-primary">
            <slot />
          </div>
        </div>
      </div>

      <!-- CTA Banner -->
      <div class="mt-12 bg-gradient-to-r from-secondary to-[#001440] rounded-3xl p-8 text-center text-white shadow-xl shadow-blue-900/20">
        <h3 class="text-2xl font-bold mb-4">Ready to upgrade your streaming experience?</h3>
        <p class="text-blue-100 mb-6 max-w-xl mx-auto">
          Get the best British IPTV service today. 4K quality, all premium channels, and zero buffering.
        </p>
        <a href="/#pricing" class="inline-block bg-primary hover:bg-red-700 text-white font-bold py-3 px-8 rounded-full transition-transform transform hover:scale-105">
          View Plans from £7
        </a>
      </div>
    </article>
  </main>
</Layout>
