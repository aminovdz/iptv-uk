---
import BaseHead from '../components/BaseHead.astro';
import ServerSchema from '../components/seo/ServerSchema.astro';
import FloatingWhatsApp from '../components/FloatingWhatsApp.astro';
import ExitPopup from '../components/ExitPopup.astro';
import GroupsPopup from '../components/GroupsPopup.astro';
import SocialPopup from '../components/SocialPopup.astro';

interface Props {
  title: string;
  description: string;
  keywords?: string;
  type?: 'home' | 'product' | 'article' | 'city';
  image?: string;
  datePublished?: string;
  dateModified?: string;
  authorName?: string;
  faqs?: Array<{ question: string; answer: string }>;
  cityName?: string;
}

const { 
  title, 
  description, 
  keywords, 
  type = 'home',
  image,
  datePublished,
  dateModified,
  authorName,
  faqs = [],
  cityName
} = Astro.props;
---

<!doctype html>
<html lang="en-GB" class="dark scroll-smooth">
  <head>
    <BaseHead title={title} description={description} keywords={keywords} image={image} />
    
    <!-- 100% Server-Side Injected JSON-LD Schema (Zero Client-Side JS) -->
    <ServerSchema 
      type={type}
      title={title}
      description={description}
      image={image}
      datePublished={datePublished}
      dateModified={dateModified}
      authorName={authorName}
      faqs={faqs}
      cityName={cityName}
    />
  </head>
  <body class="bg-[#050814] text-gray-100 font-sans antialiased selection:bg-[#C8102E] selection:text-white flex flex-col min-h-screen">
    <slot />

    <!-- Phase 4 Marketing & Conversion Widgets -->
    <FloatingWhatsApp />
    <SocialPopup />
    <ExitPopup />
    <GroupsPopup />
  </body>
</html>

<style is:global>
  @import "tailwindcss";

  :root {
    --color-primary: #C8102E; /* British Flag Red */
    --color-secondary: #012169; /* British Flag Navy Blue */
    --color-accent: #0ea5e9; /* Sky Blue */
  }

  @theme {
    --color-primary: var(--color-primary);
    --color-secondary: var(--color-secondary);
    --color-accent: var(--color-accent);
  }

  html {
    scroll-behavior: smooth;
    font-family: 'Inter', system-ui, -apple-system, sans-serif;
  }

  body {
    margin: 0;
    padding: 0;
    overflow-x: hidden;
  }
</style>
