---
import BaseHead from '../components/BaseHead.astro';
import ServerSchema from '../components/seo/ServerSchema.astro';

interface Props {
  title: string;
  description: string;
  keywords?: string;
  type?: 'home' | 'product' | 'article' | 'city';
  image?: string;
  datePublished?: string;
  dateModified?: string;
  authorName?: string;
  faqs?: Array<{ question: string; answer: string }>;
  cityName?: string;
}

const { 
  title, 
  description, 
  keywords, 
  type = 'home',
  image,
  datePublished,
  dateModified,
  authorName,
  faqs = [],
  cityName
} = Astro.props;
---

<!doctype html>
<html lang="en-GB" class="dark scroll-smooth">
  <head>
    <BaseHead title={title} description={description} keywords={keywords} image={image} />
    
    <!-- 100% Server-Side Injected JSON-LD Schema (Zero Client-Side JS) -->
    <ServerSchema 
      type={type}
      title={title}
      description={description}
      image={image}
      datePublished={datePublished}
      dateModified={dateModified}
      authorName={authorName}
      faqs={faqs}
      cityName={cityName}
    />
  </head>
  <body class="bg-[#050814] text-gray-100 font-sans antialiased selection:bg-[#C8102E] selection:text-white flex flex-col min-h-screen">
    <slot />

    <!-- Floating WhatsApp 1-Click Support Widget with Pulse Ping -->
    <a 
      href="https://wa.me/213550592200" 
      target="_blank" 
      rel="noopener noreferrer" 
      class="fixed bottom-6 right-6 z-[90] bg-[#25D366] text-white p-3.5 sm:p-4 rounded-full shadow-2xl hover:scale-110 transition-transform flex items-center justify-center group" 
      aria-label="Chat with British IPTV Support on WhatsApp"
    >
      <span class="absolute -top-1 -right-1 flex h-3.5 w-3.5">
        <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-white opacity-75"></span>
        <span class="relative inline-flex rounded-full h-3.5 w-3.5 bg-red-500"></span>
      </span>
      <svg class="w-7 h-7 sm:w-8 sm:h-8" fill="currentColor" viewBox="0 0 24 24">
        <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L0 24l6.335-1.662c1.72.94 3.659 1.437 5.63 1.438h.004c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"></path>
      </svg>
    </a>
  </body>
</html>

<style is:global>
  @import "tailwindcss";

  :root {
    --color-primary: #C8102E; /* British Flag Red */
    --color-secondary: #012169; /* British Flag Navy Blue */
    --color-accent: #0ea5e9; /* Sky Blue */
  }

  @theme {
    --color-primary: var(--color-primary);
    --color-secondary: var(--color-secondary);
    --color-accent: var(--color-accent);
  }

  html {
    scroll-behavior: smooth;
    font-family: 'Inter', system-ui, -apple-system, sans-serif;
  }

  body {
    margin: 0;
    padding: 0;
    overflow-x: hidden;
  }
</style>
